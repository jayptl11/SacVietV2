@* Partial View: Edit Page Header *@
@{
    var canEdit = ViewContext.ViewData["canEdit"] as bool? ?? false;
}

<div class="page-header-bar mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="page-title">
                <i class="fas fa-edit text-primary me-2"></i>
                Chỉnh sửa bài viết
            </h2>
            <p class="page-subtitle mb-0">
                <i class="fas fa-info-circle me-2"></i>
                @if (canEdit)
                {
                    <span>Cập nhật nội dung bài viết của bạn</span>
                }
                else
                {
                    <span>Xem chi tiết bài viết (chỉ đọc)</span>
                }
            </p>
        </div>
        <div>
            <a href="@Url.Action("MyArticles", "Writer")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>
</div>
