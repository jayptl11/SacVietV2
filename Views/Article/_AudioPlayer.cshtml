@model SacViet.Models.Article

@* Podcast Audio Player *@
@if (!string.IsNullOrEmpty(Model.AudioUrl) && Model.Category.CategoryName.ToLower().Contains("podcast"))
{
    var fileId = "";
    var match = System.Text.RegularExpressions.Regex.Match(Model.AudioUrl, @"[?&]id=([^&]+)");
    if (match.Success)
    {
        fileId = match.Groups[1].Value;
    }
    
    <div class="podcast-player-container mb-4 p-3 bg-light rounded border border-purple">
        <div class="d-flex align-items-center mb-2">
            <i class="fas fa-podcast text-purple me-2"></i>
            <div>
                <h5 class="mb-0 text-purple">🎙️ Podcast Audio</h5>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(fileId))
        {
            <!-- Google Drive Embed Player (Compact) -->
            <iframe 
                src="https://drive.google.com/file/d/@fileId/preview" 
                width="100%" 
                height="30" 
                allow="autoplay"
                style="border: none; border-radius: 10px;"
                class="podcast-audio-player"
                id="podcast-audio-player-details">
            </iframe>
        }
        else
        {
            <!-- Fallback: HTML5 Audio Player (Compact) -->
            <audio controls class="w-100 podcast-audio-player" style="height: 40px;" id="podcast-audio-player-details">
                <source src="@Model.AudioUrl" type="audio/mpeg">
                <source src="@Model.AudioUrl" type="audio/ogg">
                <source src="@Model.AudioUrl" type="audio/wav">
                Trình duyệt không hỗ trợ.
            </audio>
        }
    </div>
}
