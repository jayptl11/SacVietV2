@model SacViet.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Tìm kiếm";
    ViewBag.SearchKeyword = Model.Keyword;
}

<div class="container">
    <!-- Search Header -->
    <div class="search-header mb-4">
        <div class="row">
            <div class="col-lg-8">
                <h2 class="mb-3">
                    <i class="fas fa-search text-danger me-2"></i>
                    Kết quả tìm kiếm
                    @if (!string.IsNullOrEmpty(Model.Keyword))
                    {
                        <span class="text-muted">cho "@Model.Keyword"</span>
                    }
                </h2>
                
                <!-- Advanced Search Form -->
                <div class="advanced-search bg-light p-4 rounded mb-4">
                    <form asp-controller="Home" asp-action="Search" method="get">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Từ khóa</label>
                                <input type="text" name="keyword" class="form-control" value="@Model.Keyword" placeholder="Nhập từ khóa...">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chuyên mục</label>
                                <select name="categoryId" class="form-select">
                                    <option value="">Tất cả chuyên mục</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">
                                            @category.CategoryName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Từ ngày</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Đến ngày</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-search me-1"></i>Tìm kiếm
                                </button>
                                <a href="@Url.Action("Search", "Home")" class="btn btn-outline-secondary ms-2">
                                    <i class="fas fa-times me-1"></i>Xóa bộ lọc
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Search Results Count -->
                <div class="search-results-info mb-4">
                    <p class="text-muted">
                        Tìm thấy <strong>@Model.TotalCount</strong> kết quả
                        @if (Model.TotalPages > 1)
                        {
                            <span>- Trang @Model.Page/@Model.TotalPages</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Results -->
    <div class="row">
        <div class="col-lg-8">
            @if (Model.Articles.Any())
            {
                <div class="search-results">
                    @foreach (var article in Model.Articles)
                    {
                        <div class="search-result-item mb-4 p-4 border rounded">
                            <div class="row">
                                <div class="col-md-4">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                         class="img-fluid w-100 rounded" alt="@article.Title" style="height: 150px; object-fit: cover;">
                                </div>
                                <div class="col-md-8">
                                    <div class="category-badge bg-danger text-white px-2 py-1 d-inline-block mb-2">
                                        @article.Category.CategoryName
                                    </div>
                                    <h4 class="mb-2">
                                        <a href="#" class="text-dark text-decoration-none">@article.Title</a>
                                    </h4>
                                    <p class="text-muted mb-3">@article.Summary</p>
                                    <div class="article-meta d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fas fa-user me-1"></i>@article.Author.FirstName @article.Author.LastName
                                            <i class="fas fa-clock ms-3 me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                        <div>
                                            @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-eye me-1"></i>@article.ViewCount lượt xem
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Search results pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = Model.Page - 1 
                                    })">
                                        <i class="fas fa-chevron-left"></i> Trước
                                    </a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = i 
                                    })">@i</a>
                                </li>
                            }
                            
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = Model.Page + 1 
                                    })">
                                        Sau <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="no-results text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Không tìm thấy kết quả nào</h4>
                    <p class="text-muted">Hãy thử tìm kiếm với từ khóa khác hoặc điều chỉnh bộ lọc</p>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Popular Search Terms -->
            <div class="sidebar-widget mb-4">
                <h5 class="widget-title bg-danger text-white p-3 mb-0">
                    <i class="fas fa-tags me-2"></i>TỪ KHÓA PHỔ BIẾN
                </h5>
                <div class="widget-content bg-light p-3">
                    <div class="popular-tags">
                        <a href="@Url.Action("Search", "Home", new { keyword = "văn hóa" })" class="badge bg-outline-danger me-1 mb-2">văn hóa</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "du lịch" })" class="badge bg-outline-danger me-1 mb-2">du lịch</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "ẩm thực" })" class="badge bg-outline-danger me-1 mb-2">ẩm thực</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "lễ hội" })" class="badge bg-outline-danger me-1 mb-2">lễ hội</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "truyền thống" })" class="badge bg-outline-danger me-1 mb-2">truyền thống</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "kiến trúc" })" class="badge bg-outline-danger me-1 mb-2">kiến trúc</a>
                    </div>
                </div>
            </div>

            <!-- Search Tips -->
            <div class="sidebar-widget">
                <h5 class="widget-title bg-secondary text-white p-3 mb-0">
                    <i class="fas fa-lightbulb me-2"></i>MẸO TÌM KIẾM
                </h5>
                <div class="widget-content bg-light p-3">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Sử dụng từ khóa cụ thể</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Kết hợp nhiều từ khóa</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Chọn chuyên mục phù hợp</li>
                        <li><i class="fas fa-check text-success me-2"></i>Sử dụng bộ lọc thời gian</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>