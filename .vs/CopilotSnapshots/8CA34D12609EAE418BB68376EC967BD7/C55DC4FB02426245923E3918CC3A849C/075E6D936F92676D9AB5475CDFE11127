<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SacViet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SacViet.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <!-- Top Header -->
    <div class="top-header bg-dark text-white py-1">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <small>
                        <i class="fas fa-calendar-alt me-2"></i>
                        @DateTime.Now.ToString("dddd, dd/MM/yyyy")
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <div class="social-links">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header bg-white border-bottom">
        <div class="container">
            <div class="row align-items-center py-3">
                <div class="col-md-3">
                    <a class="navbar-brand fw-bold text-danger" asp-controller="Home" asp-action="Index">
                        <h2 class="mb-0">SacViet</h2>
                        <small class="text-muted">Báo điện tử</small>
                    </a>
                </div>
                <div class="col-md-6">
                    <!-- Search Form -->
                    <form asp-controller="Home" asp-action="Search" method="get" class="search-form">
                        <div class="input-group">
                            <input type="text" name="keyword" class="form-control" placeholder="Tìm kiếm tin tức..." value="@ViewBag.SearchKeyword">
                            <button class="btn btn-danger" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-md-3 text-end">
                    <div class="header-actions">
                        <a href="#" class="btn btn-outline-danger btn-sm me-2">Đăng nhập</a>
                        <a href="#" class="btn btn-danger btn-sm">Đăng ký</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="main-navigation bg-danger">
        <div class="container">
            <div class="navbar navbar-expand-lg navbar-dark bg-danger">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                Nhịp văn hóa
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Trong nước</a></li>
                                <li><a class="dropdown-item" href="#">Thế giới</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">Du lịch</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">Con người</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">Ẩm thực</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">Trang phục và Kiến trúc</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">Thanh - Sắc</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                Multimedia
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Podcast</a></li>
                                <li><a class="dropdown-item" href="#">Video</a></li>
                                <li><a class="dropdown-item" href="#">Infographic</a></li>
                                <li><a class="dropdown-item" href="#">Longform</a></li>
                                <li><a class="dropdown-item" href="#">eMagazine</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container-fluid">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="text-danger">SacViet</h5>
                    <p>Báo điện tử SacViet - Nơi hội tụ những giá trị văn hóa Việt Nam</p>
                    <div class="social-links">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                <div class="col-md-2">
                    <h6>Chuyên mục</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">Nhịp văn hóa</a></li>
                        <li><a href="#" class="text-white-50">Du lịch</a></li>
                        <li><a href="#" class="text-white-50">Con người</a></li>
                        <li><a href="#" class="text-white-50">Ẩm thực</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6>Multimedia</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">Podcast</a></li>
                        <li><a href="#" class="text-white-50">Video</a></li>
                        <li><a href="#" class="text-white-50">Infographic</a></li>
                        <li><a href="#" class="text-white-50">Longform</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Liên hệ</h6>
                    <p><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ: Hà Nội, Việt Nam</p>
                    <p><i class="fas fa-phone me-2"></i>Điện thoại: (024) 123 4567</p>
                    <p><i class="fas fa-envelope me-2"></i>Email: info@sacviet.vn</p>
                </div>
            </div>
            <hr class="my-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <small>&copy; 2025 SacViet. Bản quyền thuộc về SacViet.</small>
                </div>
                <div class="col-md-6 text-end">
                    <small>
                        <a href="#" class="text-white-50 me-3">Chính sách bảo mật</a>
                        <a href="#" class="text-white-50">Điều khoản sử dụng</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
