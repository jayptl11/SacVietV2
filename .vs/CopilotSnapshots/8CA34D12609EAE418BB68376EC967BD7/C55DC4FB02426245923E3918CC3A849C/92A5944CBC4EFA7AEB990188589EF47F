@model SacViet.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container">
    <!-- Breaking News Ticker -->
    <div class="breaking-news bg-danger text-white py-2 mb-4">
        <div class="row align-items-center">
            <div class="col-md-2">
                <strong><i class="fas fa-bolt me-1"></i>TIN MỚI NHẤT</strong>
            </div>
            <div class="col-md-10">
                <div class="breaking-text">
                    @if (Model.LatestArticles.Any())
                    {
                        <span>@Model.LatestArticles.First().Title</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Articles Section -->
    <section class="featured-section mb-5">
        <div class="row">
            @if (Model.FeaturedArticles.Any())
            {
                var mainArticle = Model.FeaturedArticles.First();
                <div class="col-lg-8">
                    <!-- Main Featured Article -->
                    <div class="featured-main">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(mainArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : mainArticle.ThumbnailImage)" 
                                 class="img-fluid w-100" alt="@mainArticle.Title" style="height: 400px; object-fit: cover;">
                            <div class="article-overlay">
                                <div class="category-badge bg-danger text-white px-3 py-1">
                                    @mainArticle.Category.CategoryName
                                </div>
                                <h2 class="text-white mb-2">
                                    <a href="#" class="text-white text-decoration-none">@mainArticle.Title</a>
                                </h2>
                                <p class="text-white-50 mb-2">@mainArticle.Summary</p>
                                <div class="article-meta text-white-50">
                                    <small>
                                        <i class="fas fa-user me-1"></i>@mainArticle.Author.FullName
                                        <i class="fas fa-clock ms-3 me-1"></i>@mainArticle.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <!-- Side Featured Articles -->
                    <div class="featured-sidebar">
                        @foreach (var article in Model.FeaturedArticles.Skip(1).Take(4))
                        {
                            <div class="sidebar-article mb-3">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                             class="img-fluid w-100" alt="@article.Title" style="height: 80px; object-fit: cover;">
                                    </div>
                                    <div class="col-8">
                                        <h6 class="mb-1">
                                            <a href="#" class="text-dark text-decoration-none">@article.Title</a>
                                        </h6>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Latest News Section -->
    <section class="latest-news-section">
        <div class="row">
            <div class="col-lg-8">
                <div class="section-header d-flex align-items-center justify-content-between mb-4">
                    <h3 class="fw-bold text-danger mb-0">
                        <i class="fas fa-newspaper me-2"></i>TIN MỚI NHẤT
                    </h3>
                    <a href="#" class="btn btn-outline-danger btn-sm">Xem tất cả</a>
                </div>

                <!-- Latest Articles Grid -->
                <div class="row g-4">
                    @foreach (var article in Model.LatestArticles)
                    {
                        <div class="col-md-6">
                            <div class="news-card h-100">
                                <div class="news-image position-relative">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                         class="img-fluid w-100" alt="@article.Title" style="height: 200px; object-fit: cover;">
                                    <div class="category-badge bg-danger text-white px-2 py-1 position-absolute top-0 start-0 m-2">
                                        @article.Category.CategoryName
                                    </div>
                                </div>
                                <div class="news-content p-3">
                                    <h5 class="news-title mb-2">
                                        <a href="#" class="text-dark text-decoration-none">@article.Title</a>
                                    </h5>
                                    <p class="news-summary text-muted mb-2">@article.Summary</p>
                                    <div class="news-meta d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fas fa-user me-1"></i>@article.Author.FullName
                                        </small>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Popular Articles -->
                <div class="sidebar-widget mb-4">
                    <h5 class="widget-title bg-danger text-white p-3 mb-0">
                        <i class="fas fa-fire me-2"></i>ĐƯỢC ĐỌC NHIỀU
                    </h5>
                    <div class="widget-content bg-light p-3">
                        @for (int i = 0; i < Math.Min(5, Model.LatestArticles.Count()); i++)
                        {
                            var article = Model.LatestArticles.ElementAt(i);
                            <div class="popular-article d-flex mb-3 @(i == 4 ? "mb-0" : "")">
                                <div class="popular-number bg-danger text-white d-flex align-items-center justify-content-center me-3" style="width: 30px; height: 30px; font-weight: bold;">
                                    @(i + 1)
                                </div>
                                <div class="popular-content">
                                    <h6 class="mb-1">
                                        <a href="#" class="text-dark text-decoration-none">@article.Title</a>
                                    </h6>
                                    <small class="text-muted">@article.PublishedAt?.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Newsletter Subscription -->
                <div class="sidebar-widget">
                    <h5 class="widget-title bg-danger text-white p-3 mb-0">
                        <i class="fas fa-envelope me-2"></i>ĐĂNG KÝ NHẬN TIN
                    </h5>
                    <div class="widget-content bg-light p-3">
                        <p class="mb-3">Nhận tin tức mới nhất qua email</p>
                        <form>
                            <div class="mb-3">
                                <input type="email" class="form-control" placeholder="Nhập địa chỉ email của bạn">
                            </div>
                            <button type="submit" class="btn btn-danger w-100">Đăng ký</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
