@model SacViet.ViewModels.SearchViewModel
@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Chuyên mục";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            <!-- Category Header -->
            <div class="category-header mb-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="category-icon bg-danger bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-list fs-5"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-danger mb-1">
                            @(ViewBag.CategoryName ?? "Chuyên mục")
                        </h2>
                        <p class="text-muted mb-0">
                            <i class="fas fa-newspaper me-1"></i>Tổng cộng <strong>@Model.TotalCount</strong> bài viết
                        </p>
                    </div>
                </div>
            </div>

            <!-- Articles Grid -->
            @if (Model.Articles.Any())
            {
                <div class="row g-4 mb-4">
                    @foreach (var article in Model.Articles)
                    {
                        <div class="col-md-6">
                            <div class="news-card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                <div class="news-image position-relative overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                         class="img-fluid w-100 news-img-hover" alt="@article.Title" style="height: 220px; object-fit: cover;">
                                    <div class="category-badge">
                                        <span class="badge bg-danger bg-gradient shadow-sm">
                                            <i class="fas fa-folder me-1"></i>@article.Category.CategoryName
                                        </span>
                                    </div>
                                </div>
                                <div class="news-content p-3 bg-white">
                                    <h5 class="news-title mb-2 fw-bold">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none news-link">
                                            @article.Title
                                        </a>
                                    </h5>
                                    <p class="news-summary text-muted mb-3 small">@article.Summary</p>
                                    <div class="news-meta d-flex justify-content-between align-items-center pt-2 border-top">
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="fas fa-user-circle me-1 text-danger"></i>
                                            <span>@article.Author.FullName</span>
                                        </small>
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="fas fa-calendar-alt me-1 text-danger"></i>
                                            <span>@article.PublishedAt?.ToString("dd/MM/yyyy")</span>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Category pagination" class="mt-4">
                        <ul class="pagination justify-content-center flex-wrap">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill me-1 shadow-sm" href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = Model.Page - 1 })">
                                        <i class="fas fa-chevron-left"></i> Trước
                                    </a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1 shadow-sm @(i == Model.Page ? "bg-danger border-danger" : "")" 
                                       href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = i })"
                                       style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill ms-1 shadow-sm" href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = Model.Page + 1 })">
                                        Sau <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="no-results text-center py-5 bg-light rounded-3">
                    <div class="mb-3">
                        <i class="fas fa-newspaper fa-4x text-muted opacity-50"></i>
                    </div>
                    <h4 class="text-muted fw-bold mb-2">Chưa có bài viết nào</h4>
                    <p class="text-muted mb-0">Chuyên mục này hiện chưa có bài viết nào được đăng</p>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Categories -->
            <div class="sidebar-widget mb-4 sticky-top" style="top: 20px;">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-danger bg-gradient text-white border-0 p-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-list me-2"></i>CHUYÊN MỤC
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var category in Model.Categories)
                            {
                                <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" 
                                   class="list-group-item list-group-item-action border-0 d-flex justify-content-between align-items-center py-3 category-link @(Model.CategoryId == category.CategoryId ? "active" : "")">
                                    <span class="d-flex align-items-center">
                                        <i class="fas fa-folder me-2 @(Model.CategoryId == category.CategoryId ? "text-white" : "text-danger")"></i>
                                        <span class="fw-medium">@category.CategoryName</span>
                                    </span>
                                    <i class="fas fa-chevron-right small"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* News Card Styles */
    .news-card {
        transition: all 0.3s ease;
        background: #fff;
    }
    
    .news-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .news-img-hover {
        transition: transform 0.4s ease;
    }

    .news-card:hover .news-img-hover {
        transform: scale(1.1);
    }

    .category-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 10;
    }

    .category-badge .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    .news-link {
        transition: color 0.3s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .news-link:hover {
        color: #dc3545 !important;
    }

    .news-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    /* Category Sidebar Styles */
    .category-link {
        transition: all 0.3s ease;
        border-left: 3px solid transparent !important;
    }

    .category-link:not(.active):hover {
        background: linear-gradient(to right, #fff5f5, #fff) !important;
        border-left-color: #dc3545 !important;
        padding-left: 1.25rem !important;
        color: #dc3545 !important;
    }

    .category-link.active {
        background: linear-gradient(135deg, #dc3545, #c82333) !important;
        border-left-color: #fff !important;
        color: #fff !important;
        font-weight: 600;
    }

    .category-link:not(.active):hover i {
        transform: translateX(3px);
        transition: transform 0.3s ease;
    }

    /* Pagination Styles */
    .pagination .page-link {
        border: 1px solid #dee2e6;
        color: #dc3545;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .pagination .page-link:hover {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
        transform: translateY(-2px);
    }

    .pagination .page-item.active .page-link {
        background: #dc3545;
        border-color: #dc3545;
        font-weight: 600;
    }

    /* Category Header Styles */
    .category-icon {
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .sidebar-widget {
            margin-top: 2rem;
        }

        .sticky-top {
            position: relative !important;
            top: 0 !important;
        }
    }

    @@media (max-width: 767px) {
        .news-card .news-image img {
            height: 180px !important;
        }

        .category-header h2 {
            font-size: 1.5rem;
        }

        .pagination .page-link {
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }
    }
</style>