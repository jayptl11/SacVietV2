@model SacViet.ViewModels.SearchViewModel
@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Chuyên mục";
    var mostViewedArticles = ViewBag.MostViewedArticles as IEnumerable<SacViet.Models.Article> ?? new List<SacViet.Models.Article>();
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            <!-- Category Header -->
            <div class="category-header mb-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="category-icon bg-danger bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-list fs-5"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-danger mb-1">
                            @(ViewBag.CategoryName ?? "Chuyên mục")
                        </h2>
                        <p class="text-muted mb-0">
                            <i class="fas fa-newspaper me-1"></i>Tổng cộng <strong>@Model.TotalCount</strong> bài viết
                        </p>
                    </div>
                </div>
            </div>

            <!-- Articles Grid -->
            @if (Model.Articles.Any())
            {
                <div class="row g-4 mb-4">
                    @foreach (var article in Model.Articles)
                    {
                        <div class="col-md-6">
                            <div class="news-card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                <div class="news-image position-relative overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                         class="img-fluid w-100 news-img-hover" alt="@article.Title" style="height: 220px; object-fit: cover;">
                                    <div class="category-badge">
                                        <span class="badge bg-danger bg-gradient shadow-sm">
                                            <i class="fas fa-folder me-1"></i>@article.Category.CategoryName
                                        </span>
                                    </div>
                                </div>
                                <div class="news-content p-3 bg-white">
                                    <h5 class="news-title mb-2 fw-bold">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none news-link">
                                            @article.Title
                                        </a>
                                    </h5>
                                    <p class="news-summary text-muted mb-3 small">@article.Summary</p>
                                    <div class="news-meta d-flex justify-content-between align-items-center pt-2 border-top">
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="fas fa-user-circle me-1 text-danger"></i>
                                            <span>@article.Author.FullName</span>
                                        </small>
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="fas fa-calendar-alt me-1 text-danger"></i>
                                            <span>@article.PublishedAt?.ToString("dd/MM/yyyy")</span>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Category pagination" class="mt-4">
                        <ul class="pagination justify-content-center flex-wrap">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill me-1 shadow-sm" href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = Model.Page - 1 })">
                                        <i class="fas fa-chevron-left"></i> Trước
                                    </a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1 shadow-sm @(i == Model.Page ? "bg-danger border-danger" : "")" 
                                       href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = i })"
                                       style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill ms-1 shadow-sm" href="@Url.Action("Index", "Category", new { categorySlug = ViewBag.CategorySlug, page = Model.Page + 1 })">
                                        Sau <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="no-results text-center py-5 bg-light rounded-3">
                    <div class="mb-3">
                        <i class="fas fa-newspaper fa-4x text-muted opacity-50"></i>
                    </div>
                    <h4 class="text-muted fw-bold mb-2">Chưa có bài viết nào</h4>
                    <p class="text-muted mb-0">Chuyên mục này hiện chưa có bài viết nào được đăng</p>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Most Viewed Articles -->
            <div class="sidebar-widget mb-4">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden sidebar-sticky">
                    <div class="card-header border-0 p-3" style="background-color: #980700;">
                        <h5 class="mb-0 fw-bold d-flex align-items-center text-white">
                            <i class="fas fa-fire me-2"></i>
                            <span>XEM NHIỀU NHẤT</span>
                        </h5>
                        <small class="text-white opacity-75">30 ngày gần đây</small>
                    </div>
                    <div class="card-body p-0">
                        @if (mostViewedArticles.Any())
                        {
                            <div class="list-group list-group-flush">
                                @for (int i = 0; i < mostViewedArticles.Count(); i++)
                                {
                                    var article = mostViewedArticles.ElementAt(i);
                                    var rankColor = i == 0 ? "danger" : i == 1 ? "warning" : i == 2 ? "info" : "secondary";
                                    
                                    <div class="list-group-item border-0 py-3 popular-article-item">
                                        <div class="d-flex gap-3">
                                            <div class="rank-badge bg-@rankColor bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                                                 style="width: 35px; height: 35px; font-weight: bold; font-size: 1.1rem;">
                                                @(i + 1)
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-2 popular-article-title">
                                                    <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" 
                                                       class="text-dark text-decoration-none">
                                                        @article.Title
                                                    </a>
                                                </h6>
                                                <div class="d-flex justify-content-between align-items-center text-muted small">
                                                    <span>
                                                        <i class="far fa-calendar-alt me-1"></i>
                                                        @article.PublishedAt?.ToString("dd/MM/yyyy")
                                                    </span>
                                                    @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                                    {
                                                        <span class="badge bg-light text-danger">
                                                            <i class="far fa-eye me-1"></i>@article.ViewCount
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(article.ThumbnailImage))
                                        {
                                            <div class="mt-2">
                                                <img src="@article.ThumbnailImage" 
                                                     class="img-fluid rounded w-100" 
                                                     alt="@article.Title" 
                                                     style="height: 120px; object-fit: cover;">
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="fas fa-chart-line fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0 small">Chưa có dữ liệu lượt xem trong 30 ngày gần đây</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="sidebar-widget mb-4">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header border-0 p-3" style="background-color: #980700;">
                        <h5 class="mb-0 fw-bold text-white">
                            <i class="fas fa-link me-2"></i>LIÊN KẾT NHANH
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3 quick-link">
                                <i class="fas fa-home text-danger me-3"></i>
                                <span>Trang chủ</span>
                            </a>
                            <a href="@Url.Action("Search", "Home")" class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3 quick-link">
                                <i class="fas fa-search text-danger me-3"></i>
                                <span>Tìm kiếm</span>
                            </a>
                            <a href="@Url.Action("Index", "Home")#category-trong-nuoc" class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3 quick-link">
                                <i class="fas fa-newspaper text-danger me-3"></i>
                                <span>Tin mới nhất</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* News Card Styles */
    .news-card {
        transition: all 0.3s ease;
        background: #fff;
    }
    
    .news-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .news-img-hover {
        transition: transform 0.4s ease;
    }

    .news-card:hover .news-img-hover {
        transform: scale(1.1);
    }

    .category-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 10;
    }

    .category-badge .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
        font-weight: 600;
    }

    .news-link {
        transition: color 0.3s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .news-link:hover {
        color: #dc3545 !important;
    }

    .news-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    /* Sidebar Sticky Behavior */
    .sidebar-sticky {
        position: sticky;

        top: 80px;
        max-height: calc(100vh - 100px);
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Custom scrollbar for sidebar */
    .sidebar-sticky::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-sticky::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .sidebar-sticky::-webkit-scrollbar-thumb {
        background: #dc3545;
        border-radius: 10px;
    }

    .sidebar-sticky::-webkit-scrollbar-thumb:hover {
        background: #c82333;
    }

    /* Popular Articles Styles */
    .popular-article-item {
        transition: all 0.3s ease;
    }

    .popular-article-item:hover {
        background: linear-gradient(to right, #fff5f5, #fff) !important;
    }

    .popular-article-title a {
        transition: color 0.3s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
        font-size: 0.95rem;
    }

    .popular-article-title a:hover {
        color: #dc3545 !important;
    }

    .rank-badge {
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        font-family: 'Arial Black', sans-serif;
    }

    /* Quick Links Styles */
    .quick-link {
        transition: all 0.3s ease;
        border-left: 3px solid transparent !important;
    }

    .quick-link:hover {
        background: linear-gradient(to right, #f8f9fa, #fff) !important;
        border-left-color: #dc3545 !important;
        padding-left: 1.25rem !important;
    }

    .quick-link:hover i {
        transform: translateX(3px);
        transition: transform 0.3s ease;
    }

    /* Pagination Styles */
    .pagination .page-link {
        border: 1px solid #dee2e6;
        color: #dc3545;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .pagination .page-link:hover {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
        transform: translateY(-2px);
    }

    .pagination .page-item.active .page-link {
        background: #dc3545;
        border-color: #dc3545;
        font-weight: 600;
    }

    /* Category Header Styles */
    .category-icon {
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .sidebar-widget {
            margin-top: 2rem;
        }

        .sidebar-sticky {
            position: relative !important;
            top: 0 !important;
            max-height: none !important;
            overflow-y: visible !important;
        }
    }

    @@media (max-width: 767px) {
        .news-card .news-image img {
            height: 180px !important;
        }

        .category-header h2 {
            font-size: 1.5rem;
        }

        .pagination .page-link {
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }

        .rank-badge {
            width: 30px !important;
            height: 30px !important;
            font-size: 0.9rem !important;
        }
    }
</style>