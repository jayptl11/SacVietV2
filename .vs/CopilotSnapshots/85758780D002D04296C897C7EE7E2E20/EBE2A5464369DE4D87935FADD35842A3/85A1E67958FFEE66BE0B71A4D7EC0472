@model SacViet.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">
    <div class="row">
        <!-- Left Sidebar - Small News -->
        <div class="col-lg-3">
            <div class="left-sidebar">
                @if (Model.LatestArticles.Any())
                {
                    @foreach (var article in Model.LatestArticles.Take(3))
                    {
                        <div class="sidebar-news-item mb-4">
                            <div class="news-image-small mb-2 position-relative overflow-hidden rounded">
                                <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                     class="img-fluid w-100" alt="@article.Title" style="height: 150px; object-fit: cover;">
                                <div class="image-overlay"></div>
                            </div>
                            <h6 class="news-title-small mb-2">
                                <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h6>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Main Center Content - Featured Article -->
        <div class="col-lg-6">
            @if (Model.FeaturedArticles.Any())
            {
                var mainArticle = Model.FeaturedArticles.First();
                <div class="main-featured-article mb-4">
                    <div class="featured-image mb-3 position-relative overflow-hidden rounded">
                        <img src="@(string.IsNullOrEmpty(mainArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : mainArticle.ThumbnailImage)"
                             class="img-fluid w-100" alt="@mainArticle.Title" style="height: 450px; object-fit: cover;">
                        <div class="featured-overlay"></div>
                    </div>
                    <h2 class="main-title mb-3">
                        <a href="@Url.Action("Details", "Article", new { slug = mainArticle.Slug })" class="text-dark text-decoration-none">
                            @mainArticle.Title
                        </a>
                    </h2>
                    <div class="main-meta mb-3">
                        <small class="text-danger me-3">
                            <i class="fas fa-clock me-1"></i>@mainArticle.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <p class="main-summary text-muted mb-3">@mainArticle.Summary</p>

                    <!-- Sub bullets -->
                    <ul class="sub-headlines list-unstyled">
                        @foreach (var subArticle in Model.FeaturedArticles.Skip(1).Take(2))
                        {
                            <li class="mb-2">
                                <i class="fas fa-chevron-right text-danger me-2" style="font-size: 0.8rem;"></i>
                                <a href="@Url.Action("Details", "Article", new { slug = subArticle.Slug })" class="text-dark">
                                    @subArticle.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Secondary Articles -->
                <div class="secondary-articles">
                    <div class="row g-3">
                        @foreach (var article in Model.LatestArticles.Skip(3).Take(3))
                        {
                            <div class="col-md-12 mb-3">
                                <div class="row g-2 secondary-card p-2 rounded">
                                    <div class="col-5">
                                        <div class="position-relative overflow-hidden rounded">
                                            <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                                 class="img-fluid w-100" alt="@article.Title" style="height: 120px; object-fit: cover;">
                                            <div class="secondary-overlay"></div>
                                        </div>
                                    </div>
                                    <div class="col-7">
                                        <h6 class="mb-2">
                                            <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                                @article.Title
                                            </a>
                                        </h6>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Sidebar - Latest News với Timeline -->
        <div class="col-lg-3">
            <div class="right-sidebar">
                <div class="latest-news-box bg-white rounded shadow-sm">
                    <div class="latest-header bg-danger text-white p-3 rounded-top d-flex align-items-center">
                        <i class="fas fa-bolt me-2"></i>
                        <h5 class="mb-0 fw-bold">TIN MỚI NHẤT</h5>
                    </div>

                    @if (Model.LatestArticles.Any())
                    {
                        <div class="latest-timeline p-3">
                            @for (int i = 0; i < Math.Min(10, Model.LatestArticles.Count()); i++)
                            {
                                var article = Model.LatestArticles.ElementAt(i);
                                <div class="timeline-item @(i == Model.LatestArticles.Count() - 1 || i == 9 ? "last-item" : "")">
                                    <div class="timeline-marker">
                                        <div class="timeline-dot"></div>
                                    </div>
                                    <div class="timeline-content">
                                        <div class="timeline-time text-danger mb-1">
                                            <i class="far fa-clock me-1"></i>
                                            <small class="fw-semibold">@article.PublishedAt?.ToString("HH:mm")</small>
                                            <small class="text-muted ms-1">@article.PublishedAt?.ToString("dd/MM")</small>
                                        </div>
                                        <h6 class="timeline-title mb-2">
                                            <a href="@Url.Action("Details", "Article", new { slug = article.Slug })"
                                               class="text-dark text-decoration-none timeline-link">
                                                @article.Title
                                            </a>
                                        </h6>
                                        @if (!string.IsNullOrEmpty(article.Summary) && article.Summary.Length > 80)
                                        {
                                            <p class="timeline-summary text-muted small mb-2">
                                                @article.Summary.Substring(0, 80)...</p>
                                        }
                                        <div class="timeline-meta d-flex align-items-center">
                                            <span class="badge bg-light text-dark small me-2">
                                                <i class="fas fa-folder me-1"></i>@article.Category.CategoryName
                                            </span>
                                            @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-eye me-1"></i>@article.ViewCount
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="latest-footer p-3 border-top">
                            <a href="@Url.Action("Search", "Home")" class="btn btn-outline-danger btn-sm w-100">
                                <i class="fas fa-arrow-right me-2"></i>Xem tất cả tin
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hiển thị bài viết theo thứ tự danh mục cố định với layout đa dạng -->
@if (Model.ArticlesByCategory.Any())
{
    // Định nghĩa thứ tự hiển thị danh mục cố định
    var categoryOrder = new List<string>
    {
        "trong-nuoc",     // Nhịp văn hóa: Trong nước
        "the-gioi",       // Nhịp văn hóa: Thế giới
        "du-lich",        // Du lịch
        "con-nguoi",      // Con người
        "am-thuc",        // Ẩm thực
        "trang-phuc-va-kien-truc", // Trang phục & Kiến trúc
        "thanh-sac",      // Thanh - Sắc
        "podcast",        // Multimedia: Podcast
        "video",          // Multimedia: Video
        "infographic",    // Multimedia: Infographic
        "longform",       // Multimedia: Longform
        "emagazine"       // Multimedia: eMagazine
    };

    // Lấy danh mục có bài viết theo thứ tự đã định
    var orderedCategories = new List<SacViet.Models.Category>();
    
    foreach (var slug in categoryOrder)
    {
        var category = Model.AllCategories.FirstOrDefault(c => c.Slug == slug && 
            Model.ArticlesByCategory.ContainsKey(c.CategoryId) && 
            Model.ArticlesByCategory[c.CategoryId].Any());
        
        if (category != null)
        {
            orderedCategories.Add(category);
        }
    }

    for (int categoryIndex = 0; categoryIndex < orderedCategories.Count; categoryIndex++)
    {
        var category = orderedCategories[categoryIndex];
        var articles = Model.ArticlesByCategory[category.CategoryId];
        var layoutType = categoryIndex % 4; // Tạo 4 kiểu layout khác nhau
        
        <div class="container mt-5" id="category-@category.Slug">
            <!-- Header cho category -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="category-header position-relative">
                        @if (layoutType == 0) // Layout gradient header
                        {
                            <div class="gradient-header bg-gradient p-4 rounded-3 text-white position-relative overflow-hidden" 
                                 style="background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);">
                                <div class="position-absolute top-0 end-0 opacity-25" style="font-size: 4rem;">
                                    <i class="fas fa-newspaper"></i>
                                </div>
                                <div class="d-flex align-items-center justify-content-between position-relative">
                                    <div>
                                        @if (category.ParentCategoryId.HasValue)
                                        {
                                            var parentCategory = Model.AllCategories.FirstOrDefault(c => c.CategoryId == category.ParentCategoryId.Value);
                                            if (parentCategory != null)
                                            {
                                                <small class="text-white-50 d-block mb-1">@parentCategory.CategoryName</small>
                                            }
                                        }
                                        <h3 class="mb-0 fw-bold">@category.CategoryName</h3>
                                        <p class="mb-0 mt-2 text-white-75">@category.Description</p>
                                    </div>
                                    <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" 
                                       class="btn btn-light btn-sm rounded-pill px-3">
                                        <i class="fas fa-arrow-right me-1"></i>Xem thêm
                                    </a>
                                </div>
                            </div>
                        }
                        else if (layoutType == 1) // Layout với border và icon
                        {
                            <div class="border-start border-danger border-4 ps-4 py-3 bg-light rounded-end">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-tag text-danger me-2"></i>
                                            @if (category.ParentCategoryId.HasValue)
                                            {
                                                var parentCategory = Model.AllCategories.FirstOrDefault(c => c.CategoryId == category.ParentCategoryId.Value);
                                                if (parentCategory != null)
                                                {
                                                    <span class="text-muted me-2">@parentCategory.CategoryName /</span>
                                                }
                                            }
                                            <h4 class="text-danger mb-0 fw-bold">@category.CategoryName</h4>
                                        </div>
                                        <p class="text-muted mb-0 small">@category.Description</p>
                                    </div>
                                    <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" 
                                       class="btn btn-outline-danger btn-sm">
                                        Khám phá <i class="fas fa-chevron-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        }
                        else if (layoutType == 2) // Layout card style
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3" 
                                                     style="width: 50px; height: 50px;">
                                                    <i class="fas fa-feather"></i>
                                                </div>
                                                <div>
                                                    @if (category.ParentCategoryId.HasValue)
                                                    {
                                                        var parentCategory = Model.AllCategories.FirstOrDefault(c => c.CategoryId == category.ParentCategoryId.Value);
                                                        if (parentCategory != null)
                                                        {
                                                            <small class="text-muted d-block">@parentCategory.CategoryName</small>
                                                        }
                                                    }
                                                    <h4 class="mb-0 text-dark">@category.CategoryName</h4>
                                                </div>
                                            </div>
                                            <p class="text-muted mb-0">@category.Description</p>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" 
                                               class="btn btn-danger">Xem tất cả</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else // Layout simple với underline
                        {
                            <div class="text-center py-3">
                                @if (category.ParentCategoryId.HasValue)
                                {
                                    var parentCategory = Model.AllCategories.FirstOrDefault(c => c.CategoryId == category.ParentCategoryId.Value);
                                    if (parentCategory != null)
                                    {
                                        <small class="text-muted d-block mb-2">@parentCategory.CategoryName</small>
                                    }
                                }
                                <h3 class="text-danger mb-3 position-relative d-inline-block">
                                    @category.CategoryName
                                    <div class="position-absolute bottom-0 start-0 w-100 bg-danger" style="height: 2px;"></div>
                                </h3>
                                <p class="text-muted mb-3">@category.Description</p>
                                <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" 
                                   class="btn btn-outline-danger btn-sm rounded-pill">
                                    <i class="fas fa-plus me-1"></i>Đọc thêm
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Articles layout đa dạng -->
            @if (layoutType == 0) // Grid layout chuẩn
            {
                <div class="row g-4">
                    @foreach (var article in articles.Take(6))
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="news-card h-100 bg-white rounded-3 shadow-sm overflow-hidden hover-lift">
                                <div class="position-relative overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                         class="img-fluid w-100" alt="@article.Title" style="height: 200px; object-fit: cover;">
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge bg-white text-danger fw-bold px-3 py-2 rounded-pill">@article.Category.CategoryName</span>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h5 class="mb-3 fw-bold">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none stretched-link">
                                            @article.Title
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-3">
                                        @if (!string.IsNullOrEmpty(article.Summary))
                                        {
                                            @(article.Summary.Length > 100 ? article.Summary.Substring(0, 100) + "..." : article.Summary)
                                        }
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center small text-muted">
                                        <span><i class="fas fa-calendar me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")</span>
                                        @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                        {
                                            <span><i class="fas fa-eye me-1"></i>@article.ViewCount</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (layoutType == 1) // List layout với thumbnail
            {
                <div class="row g-3">
                    @foreach (var article in articles.Take(4))
                    {
                        <div class="col-md-6">
                            <div class="d-flex bg-white rounded-3 shadow-sm overflow-hidden hover-shadow">
                                <div class="flex-shrink-0">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                         class="img-fluid" alt="@article.Title" style="width: 150px; height: 120px; object-fit: cover;">
                                </div>
                                <div class="flex-grow-1 p-3 d-flex flex-column">
                                    <span class="badge bg-danger-subtle text-danger mb-2 align-self-start">@article.Category.CategoryName</span>
                                    <h6 class="mb-2 flex-grow-1">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                            @article.Title
                                        </a>
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center small text-muted">
                                        <span><i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM")</span>
                                        @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                        {
                                            <span><i class="fas fa-eye me-1"></i>@article.ViewCount</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (layoutType == 2) // Magazine layout với featured article
            {
                var featuredArticle = articles.First();
                var otherArticles = articles.Skip(1).Take(4);
                
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="featured-magazine-card bg-white rounded-3 shadow-sm overflow-hidden">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(featuredArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : featuredArticle.ThumbnailImage)"
                                     class="img-fluid w-100" alt="@featuredArticle.Title" style="height: 300px; object-fit: cover;">
                                <div class="position-absolute bottom-0 start-0 w-100 bg-gradient p-4" 
                                     style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                                    <span class="badge bg-danger mb-2">@featuredArticle.Category.CategoryName</span>
                                    <h4 class="text-white mb-2 fw-bold">
                                        <a href="@Url.Action("Details", "Article", new { slug = featuredArticle.Slug })" class="text-white text-decoration-none">
                                            @featuredArticle.Title
                                        </a>
                                    </h4>
                                    <p class="text-white-75 mb-0 small">@featuredArticle.Summary</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        @foreach (var article in otherArticles)
                        {
                            <div class="mb-3 pb-3 border-bottom">
                                <span class="badge bg-light text-danger mb-2">@article.Category.CategoryName</span>
                                <h6 class="mb-2">
                                    <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                        @article.Title
                                    </a>
                                </h6>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
            else // Compact card layout
            {
                <div class="row g-3">
                    @foreach (var article in articles.Take(8))
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="compact-card bg-white rounded-3 shadow-sm overflow-hidden h-100 hover-lift">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                         class="img-fluid w-100" alt="@article.Title" style="height: 140px; object-fit: cover;">
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-danger small">@article.Category.CategoryName</span>
                                    </div>
                                </div>
                                <div class="p-3">
                                    <h6 class="mb-2 small fw-bold" style="line-height: 1.3;">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none stretched-link">
                                            @(article.Title.Length > 60 ? article.Title.Substring(0, 60) + "..." : article.Title)
                                        </a>
                                    </h6>
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}
else
{
    <!-- Thông báo nếu không có bài viết theo danh mục -->
    <div class="container mt-5">
        <div class="alert alert-info text-center border-0 rounded-3">
            <i class="fas fa-info-circle me-2 text-info"></i>
            <strong>Chưa có bài viết theo danh mục.</strong> Vui lòng thêm bài viết vào các danh mục trong database.
        </div>
    </div>
}

<!-- Tin nổi bật khác -->
<div class="container mt-5">
    <div class="text-center mb-5">
        <h3 class="text-danger mb-3 position-relative d-inline-block">
            <i class="fas fa-star me-2"></i>Tin nổi bật khác
            <div class="position-absolute bottom-0 start-0 w-100 bg-danger" style="height: 2px;"></div>
        </h3>
        <p class="text-muted">Khám phá thêm những câu chuyện thú vị khác</p>
    </div>
    <div class="row g-4">
        @foreach (var article in Model.LatestArticles.Skip(6).Take(6))
        {
            <div class="col-lg-4 col-md-6">
                <div class="news-card h-100 bg-white rounded-3 shadow-sm overflow-hidden hover-lift">
                    <div class="position-relative overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                             class="img-fluid w-100" alt="@article.Title" style="height: 200px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge bg-white text-danger fw-bold px-3 py-2 rounded-pill">@article.Category.CategoryName</span>
                        </div>
                    </div>
                    <div class="p-4">
                        <h5 class="mb-3 fw-bold">
                            <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none stretched-link">
                                @article.Title
                            </a>
                        </h5>
                        <p class="text-muted small mb-3">
                            @if (!string.IsNullOrEmpty(article.Summary))
                            {
                                @(article.Summary.Length > 100 ? article.Summary.Substring(0, 100) + "..." : article.Summary)
                            }
                        </p>
                        <div class="d-flex justify-content-between align-items-center small text-muted">
                            <span><i class="fas fa-calendar me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")</span>
                            @if (article.ViewCount.HasValue && article.ViewCount > 0)
                            {
                                <span><i class="fas fa-eye me-1"></i>@article.ViewCount</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Smooth scroll cho category links với offset cho fixed navbar
        document.addEventListener('DOMContentLoaded', function () {
            // Xử lý smooth scroll cho các category links
            const categoryLinks = document.querySelectorAll('.category-home-link');
            
            categoryLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    const hashIndex = href.indexOf('#');
                    
                    // Chỉ xử lý nếu link có hash
                    if (hashIndex !== -1) {
                        const hash = href.substring(hashIndex);
                        const targetElement = document.querySelector(hash);
                        
                        if (targetElement) {
                            e.preventDefault();
                            
                            // Nếu đang ở trang khác, chuyển về trang chủ trước
                            if (window.location.pathname !== '/Home/Index' && window.location.pathname !== '/') {
                                window.location.href = href;
                                return;
                            }
                            
                            // Tính toán offset cho navbar (navbar height + padding)
                            const navbarHeight = document.getElementById('mainNavbar')?.offsetHeight || 0;
                            const categoryMenuHeight = document.getElementById('categoryMenu')?.offsetHeight || 0;
                            const offset = navbarHeight + categoryMenuHeight + 20; // thêm 20px padding
                            
                            const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - offset;
                            
                            window.scrollTo({
                                top: targetPosition,
                                behavior: 'smooth'
                            });
                            
                            // Highlight effect cho section
                            targetElement.classList.add('highlight-section');
                            setTimeout(() => {
                                targetElement.classList.remove('highlight-section');
                            }, 2000);
                        }
                    }
                });
            });
            
            // Xử lý khi load trang với hash trong URL
            if (window.location.hash) {
                setTimeout(() => {
                    const targetElement = document.querySelector(window.location.hash);
                    if (targetElement) {
                        const navbarHeight = document.getElementById('mainNavbar')?.offsetHeight || 0;
                        const categoryMenuHeight = document.getElementById('categoryMenu')?.offsetHeight || 0;
                        const offset = navbarHeight + categoryMenuHeight + 20;
                        
                        const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - offset;
                        
                        window.scrollTo({
                            top: targetPosition,
                            behavior: 'smooth'
                        });
                        
                        targetElement.classList.add('highlight-section');
                        setTimeout(() => {
                            targetElement.classList.remove('highlight-section');
                        }, 2000);
                    }
                }, 100);
            }
        });
    </script>
}

