<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SacViet</title>
    
    <!-- Preconnect để tải nhanh hơn -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    
    <!-- Critical inline CSS fallback - đảm bảo layout cơ bản hiển thị ngay cả khi external CSS chưa load -->
    <style id="critical-css">
        /* Fallback styles khi CSS chưa load */
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 15px; }
        .row { display: flex; flex-wrap: wrap; margin: 0 -15px; }
        .col-12, .col-md-4, .col-md-6, .col-lg-3, .col-lg-6 { padding: 0 15px; box-sizing: border-box; }
        .col-12 { flex: 0 0 100%; max-width: 100%; }
        .d-flex { display: flex; }
        .text-danger { color: #dc3545; }
        .bg-danger { background-color: #dc3545; }
        .text-white { color: #fff; }
        .bg-white { background-color: #fff; }
        .rounded { border-radius: 0.375rem; }
        .shadow-sm { box-shadow: 0 .125rem .25rem rgba(0,0,0,.075); }
        .mb-0 { margin-bottom: 0; }
        .mb-2 { margin-bottom: 0.5rem; }
        .mb-3 { margin-bottom: 1rem; }
        .mb-4 { margin-bottom: 1.5rem; }
        .mt-4 { margin-top: 1.5rem; }
        .mt-5 { margin-top: 3rem; }
        .p-3 { padding: 1rem; }
        .text-decoration-none { text-decoration: none; }
        .text-dark { color: #212529; }
        img { max-width: 100%; height: auto; }
        .img-fluid { max-width: 100%; height: auto; }
        a { color: inherit; }
        .btn { display: inline-block; padding: 0.375rem 0.75rem; border-radius: 0.375rem; text-decoration: none; cursor: pointer; }
        .btn-danger { background-color: #dc3545; color: #fff; border: 1px solid #dc3545; }
        .btn-outline-danger { background-color: transparent; color: #dc3545; border: 1px solid #dc3545; }
        .sticky-top { position: sticky; top: 0; z-index: 1020; }
        /* Hide loading state */
        .css-loading { opacity: 0.3; }
        .css-loaded { opacity: 1; transition: opacity 0.3s ease; }
    </style>
    
    <!-- Bootstrap CSS with fallback -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" 
          onerror="this.onerror=null; this.href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css';" />
    
    <!-- Site CSS với cache busting -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SacViet.styles.css" asp-append-version="true" />
    
    <!-- Font Awesome với fallback -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" 
          integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" 
          crossorigin="anonymous" 
          referrerpolicy="no-referrer"
          onerror="this.onerror=null; this.href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css';" />
    
    @await RenderSectionAsync("Styles", required: false)
    
    <!-- CSS Load Detection Script -->
    <script>
        // Kiểm tra CSS đã load chưa
        (function() {
            var checkCSSLoaded = function() {
                var testEl = document.createElement('div');
                testEl.className = 'container';
                document.body.appendChild(testEl);
                var style = window.getComputedStyle(testEl);
                var isLoaded = style.maxWidth !== 'none' && style.maxWidth !== '';
                document.body.removeChild(testEl);
                return isLoaded;
            };
            
            document.addEventListener('DOMContentLoaded', function() {
                document.body.classList.add('css-loading');
                
                var attempts = 0;
                var maxAttempts = 50; // 5 seconds max
                
                var checkInterval = setInterval(function() {
                    attempts++;
                    if (checkCSSLoaded() || attempts >= maxAttempts) {
                        clearInterval(checkInterval);
                        document.body.classList.remove('css-loading');
                        document.body.classList.add('css-loaded');
                        
                        // Remove critical CSS after main CSS loaded
                        var criticalCSS = document.getElementById('critical-css');
                        if (criticalCSS && attempts < maxAttempts) {
                            // Keep critical CSS if main CSS failed
                        }
                    }
                }, 100);
            });
        })();
    </script>
</head>
<body>
