@model SacViet.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* Đảm bảo các cột có chiều cao bằng nhau */
    .equal-height-row {
        display: flex;
        flex-wrap: wrap;
    }
    
    .equal-height-col {
        display: flex;
        flex-direction: column;
    }
    
    .left-sidebar,
    .right-sidebar {
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between; /* Phân bố đều các tin */
    }
    
    .sidebar-news-item {
        flex: 1; /* Mỗi tin chiếm không gian đều nhau */
        display: flex;
        flex-direction: column;
    }
    
    .latest-news-box {
        /* display: flex;
        flex-direction: column;
        height: 100%; */
    }
    
    .latest-timeline {
        /* flex: 1;
        overflow-y: auto; */
        /* Bỏ justify-content để tin phân bố tự nhiên */
    }
    
    .timeline-item {
        /* Bỏ flex: 1 để tin không bị giãn cách */
        margin-bottom: 1.5rem; /* Khoảng cách cố định giữa các tin */
    }
    
    .timeline-item.last-item {
        margin-bottom: 0;
    }
    
    .latest-footer {
        margin-top: auto; /* Đẩy nút xuống dưới cùng */
    }
</style>

<div class="container mt-4">
    <div class="row equal-height-row">
        <!-- Left Sidebar - 6 tin nhỏ (tin 7-12) -->
        <div class="col-lg-3 equal-height-col">
            <div class="left-sidebar">
                @if (Model.SidebarArticles.Any() && Model.SidebarArticles.Count() >= 9)
                {
                    @foreach (var article in Model.SidebarArticles.Skip(3).Take(6))
                    {
                        <div class="sidebar-news-item">
                            <div class="news-image-small mb-2 position-relative overflow-hidden rounded">
                                <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                     class="img-fluid w-100" alt="@article.Title" style="height: 130px; object-fit: cover;">
                                <div class="image-overlay"></div>
                            </div>
                            <h6 class="news-title-small mb-2" style="font-size: 0.85rem; line-height: 1.3;">
                                <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h6>
                        </div>
                    }
                }
                else if (Model.SidebarArticles.Any())
                {
                    <!-- Fallback: Lấy tối đa số tin còn lại -->
                    @foreach (var article in Model.SidebarArticles.Skip(3).Take(6))
                    {
                        <div class="sidebar-news-item">
                            <div class="news-image-small mb-2 position-relative overflow-hidden rounded">
                                <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                     class="img-fluid w-100" alt="@article.Title" style="height: 130px; object-fit: cover;">
                                <div class="image-overlay"></div>
                            </div>
                            <h6 class="news-title-small mb-2" style="font-size: 0.85rem; line-height: 1.3;">
                                <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h6>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Main Center Content - 6 tin đầu (tin 1-6) -->
        <div class="col-lg-6 equal-height-col">
            @if (Model.MostViewedTodayArticles.Any())
            {
                var mainArticle = Model.MostViewedTodayArticles.First();
                var articleDate = mainArticle.PublishedAt?.Date ?? DateTime.Today;
                var daysAgo = (DateTime.Today - articleDate).Days;
                var badgeText = daysAgo == 0 ? "Tin mới nhất hôm nay" : 
                               daysAgo == 1 ? "Tin mới nhất hôm qua" : 
                               $"Tin mới {daysAgo} ngày trước";
                
                <!-- Tin chính lớn (Tin 1) -->
                <div class="main-featured-article mb-4">
                    <div class="featured-image mb-3 position-relative overflow-hidden rounded">
                        <img src="@(string.IsNullOrEmpty(mainArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : mainArticle.ThumbnailImage)"
                             class="img-fluid w-100" alt="@mainArticle.Title" style="height: 400px; object-fit: cover;">
                        <div class="featured-overlay"></div>
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge bg-danger">
                                <i class="fas fa-newspaper me-1"></i>@badgeText
                            </span>
                        </div>
                    </div>
                    <h2 class="main-title mb-3">
                        <a href="@Url.Action("Details", "Article", new { slug = mainArticle.Slug })" class="text-dark text-decoration-none">
                            @mainArticle.Title
                        </a>
                    </h2>
                    <div class="main-meta mb-3">
                        <small class="text-danger me-3">
                            <i class="fas fa-clock me-1"></i>@mainArticle.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                        </small>
                        @if (mainArticle.ViewCount.HasValue && mainArticle.ViewCount > 0)
                        {
                            <small class="text-danger">
                                <i class="far fa-eye me-1"></i>@mainArticle.ViewCount lượt xem
                            </small>
                        }
                    </div>
                    <p class="main-summary text-muted mb-3">@mainArticle.Summary</p>

                    <!-- 2 Sub bullets (Tin 2-3) -->
                    @if (Model.MostViewedTodayArticles.Count() > 1)
                    {
                        <ul class="sub-headlines list-unstyled">
                            @foreach (var subArticle in Model.MostViewedTodayArticles.Skip(1).Take(2))
                            {
                                <li class="mb-2">
                                    <i class="fas fa-angle-double-right text-danger me-2" style="font-size: 0.8rem;"></i>
                                    <a href="@Url.Action("Details", "Article", new { slug = subArticle.Slug })" class="text-dark">
                                        @subArticle.Title
                                    </a>
                                    @if (subArticle.ViewCount.HasValue && subArticle.ViewCount > 0)
                                    {
                                        <small class="text-muted ms-2">
                                            <i class="far fa-eye me-1"></i>@subArticle.ViewCount
                                        </small>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- 3 tin phụ horizontal (Tin 4-6) -->
                <div class="secondary-articles">
                    <div class="row g-3">
                        @foreach (var article in Model.SidebarArticles.Take(3))
                        {
                            <div class="col-md-12 mb-2">
                                <div class="row g-2 secondary-card p-2 rounded">
                                    <div class="col-5">
                                        <div class="position-relative overflow-hidden rounded">
                                            <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                                 class="img-fluid w-100" alt="@article.Title" style="height: 110px; object-fit: cover;">
                                            <div class="secondary-overlay"></div>
                                        </div>
                                    </div>
                                    <div class="col-7">
                                        <h6 class="mb-2" style="font-size: 0.95rem; line-height: 1.4;">
                                            <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                                @article.Title
                                            </a>
                                        </h6>
                                        <small class="text-muted">
                                            <i class="far fa-calendar-alt me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Fallback to featured articles if no most viewed today -->
                @if (Model.FeaturedArticles.Any())
                {
                    var mainArticle = Model.FeaturedArticles.First();
                    <div class="main-featured-article mb-4">
                        <div class="featured-image mb-3 position-relative overflow-hidden rounded">
                            <img src="@(string.IsNullOrEmpty(mainArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : mainArticle.ThumbnailImage)"
                                 class="img-fluid w-100" alt="@mainArticle.Title" style="height: 400px; object-fit: cover;">
                            <div class="featured-overlay"></div>
                        </div>
                        <h2 class="main-title mb-3">
                            <a href="@Url.Action("Details", "Article", new { slug = mainArticle.Slug })" class="text-dark text-decoration-none">
                                @mainArticle.Title
                            </a>
                        </h2>
                        <div class="main-meta mb-3">
                            <small class="text-danger me-3">
                                <i class="fas fa-clock me-1"></i>@mainArticle.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        <p class="main-summary text-muted mb-3">@mainArticle.Summary</p>
                    </div>
                }
            }
        </div>

        <!-- Right Sidebar - Latest News với Timeline (kéo dài bằng main) -->
        <div class="col-lg-3 equal-height-col">
            <div class="right-sidebar">
                <div class="latest-news-box bg-white rounded shadow-sm">
                    <div class="latest-header bg-danger text-white p-3 rounded-top d-flex align-items-center">
                        <i class="fas fa-newspaper me-2"></i>
                        <h5 class="mb-0 fw-bold">TIN MỚI NHẤT</h5>
                    </div>

                    @if (ViewBag.TimelineArticles != null && ((IEnumerable<SacViet.Models.Article>)ViewBag.TimelineArticles).Any())
                    {
                        var timelineArticles = (IEnumerable<SacViet.Models.Article>)ViewBag.TimelineArticles;
                        <div class="latest-timeline p-3">
                            @{
                                int i = 0;
                                foreach (var article in timelineArticles)
                                {
                                    <div class="timeline-item @(i == 9 || i == timelineArticles.Count() - 1 ? "last-item" : "")">
                                        <div class="timeline-marker">
                                            <div class="timeline-dot"></div>
                                        </div>
                                        <div class="timeline-content">
                                            <div class="timeline-time text-danger mb-1">
                                                <i class="far fa-clock me-1"></i>
                                                <small class="fw-semibold">@article.PublishedAt?.ToString("HH:mm")</small>
                                                <small class="text-muted ms-1">@article.PublishedAt?.ToString("dd/MM")</small>
                                            </div>
                                            <h6 class="timeline-title mb-1" style="font-size: 0.85rem; line-height: 1.3;">
                                                <a href="@Url.Action("Details", "Article", new { slug = article.Slug })"
                                                   class="text-dark text-decoration-none timeline-link">
                                                    @article.Title
                                                </a>
                                            </h6>
                                            <div class="timeline-meta d-flex align-items-center mt-1">
                                                <span class="badge bg-light text-dark small me-2" style="font-size: 0.65rem;">
                                                    <i class="fas fa-tag me-1"></i>@article.Category.CategoryName
                                                </span>
                                                @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                                {
                                                    <small class="text-muted" style="font-size: 0.7rem;">
                                                        <i class="far fa-eye me-1"></i>@article.ViewCount
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    i++;
                                }
                            }
                        </div>

                        <div class="latest-footer p-3 border-top">
                            <a href="@Url.Action("Search", "Home")" class="btn btn-outline-danger btn-sm w-100">
                                <i class="fas fa-plus me-2"></i>Xem tất cả tin
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hiện thị bài viết theo thứ tự danh mục cố định với thiết kế đa dạng -->
@{
    if (Model.ArticlesByCategory.Any())
    {
        // Định nghĩa thứ tự hiện thị danh mục cố định với icon tương ứng
        var categoryOrder = new List<(string slug, string icon)>
        {
            ("trong-nuoc", "fas fa-home"),           // Nhập văn hóa: Trong nước
            ("the-gioi", "fas fa-globe-asia"),       // Nhập văn hóa: Thế giới
            ("du-lich", "fas fa-plane"),             // Du lịch
            ("con-nguoi", "fas fa-users"),           // Con người
            ("am-thuc", "fas fa-utensils"),          // Ẩm thực
            ("trang-phuc-va-kien-truc", "fas fa-building"), // Trang phục & Kiến trúc
            ("thanh-sac", "fas fa-palette"),         // Thanh - Sắc
            ("podcast", "fas fa-podcast"),           // Multimedia: Podcast
            ("video", "fas fa-video"),               // Multimedia: Video
            ("infographic", "fas fa-chart-bar"),     // Multimedia: Infographic
            ("longform", "fas fa-scroll"),           // Multimedia: Longform
            ("emagazine", "fas fa-book-open")        // Multimedia: eMagazine
        };

        // Lấy danh mục có bài viết theo thứ tự đã định
        var orderedCategories = new List<(SacViet.Models.Category category, string icon)>();
        
        foreach (var (slug, icon) in categoryOrder)
        {
            var category = Model.AllCategories.FirstOrDefault(c => c.Slug == slug && 
                Model.ArticlesByCategory.ContainsKey(c.CategoryId) && 
                Model.ArticlesByCategory[c.CategoryId].Any());
            
            if (category != null)
            {
                orderedCategories.Add((category, icon));
            }
        }

        // Thiết kế đa dạng cho từng danh mục
        var layoutIndex = 0;
        foreach (var (category, categoryIcon) in orderedCategories)
        {
            var articles = Model.ArticlesByCategory[category.CategoryId];
            var currentLayout = layoutIndex % 4; // 4 kiểu layout khác nhau
            
            // Xác định chuyên mục cần xử lý đặc biệt
            var isSpecialCategory = category.Slug == "con-nguoi" || category.Slug == "podcast" || category.Slug == "emagazine";
            
            <div class="container mt-5" id="category-@category.Slug">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between mb-4 category-section-header">
                            <h4 class="section-heading text-uppercase text-danger mb-0">
                                <i class="@categoryIcon me-2"></i>
                                @if (category.ParentCategoryId.HasValue)
                                {
                                    var parentCategory = Model.AllCategories.FirstOrDefault(c => c.CategoryId == category.ParentCategoryId.Value);
                                    if (parentCategory != null)
                                    {
                                        <span class="text-muted" style="font-size: 0.9rem;">@parentCategory.CategoryName / </span>
                                    }
                                }
                                @category.CategoryName
                            </h4>
                            <a href="@Url.Action("Index", "Category", new { categorySlug = category.Slug })" class="btn btn-sm btn-outline-danger">
                                Xem thêm <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                @if (currentLayout == 0)
                {
                    <!-- Layout 1: Classic Grid 3 columns -->
                    <div class="row g-4">
                        @foreach (var article in articles.Take(6))
                        {
                            <div class="col-md-4">
                                <div class="news-card-home h-100 bg-white rounded shadow-sm overflow-hidden">
                                    <div class="news-image-home mb-0 position-relative">
                                        <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                             class="img-fluid w-100" alt="@article.Title" style="height: 200px; object-fit: cover;">
                                        <div class="card-overlay"></div>
                                        <div class="position-absolute top-0 start-0 m-2">
                                            <span class="badge bg-danger">@article.Category.CategoryName</span>
                                        </div>
                                    </div>
                                    <div class="p-3">
                                        <h5 class="news-card-title mb-2">
                                            <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                                @article.Title
                                            </a>
                                        </h5>
                                        @{
                                            var summaryText = "";
                                            var summaryLength = isSpecialCategory ? 180 : 100;
                                            
                                            if (!string.IsNullOrEmpty(article.Summary))
                                            {
                                                summaryText = article.Summary.Length > summaryLength ? 
                                                    article.Summary.Substring(0, summaryLength) + "..." : article.Summary;
                                            }
                                            else if (isSpecialCategory)
                                            {
                                                // Fallback content cho các chuyên mục đặc biệt
                                                if (category.Slug == "con-nguoi")
                                                    summaryText = "Khám phá những câu chuyện sống động về con người, cuộc sống và những trải nghiệm đầy ý nghĩa...";
                                                else if (category.Slug == "podcast")
                                                    summaryText = "Lắng nghe những chia sẻ thú vị qua âm thanh, mang đến góc nhìn mới mẻ về văn hóa và cuộc sống...";
                                                else if (category.Slug == "emagazine")
                                                    summaryText = "Trải nghiệm tạp chí điện tử với nội dung phong phú, thiết kế hiện đại và tương tác hấp dẫn...";
                                            }
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(summaryText))
                                        {
                                            <p class="news-card-summary text-muted small mb-2" style="@(isSpecialCategory ? "min-height: 60px;" : "")">
                                                @summaryText
                                            </p>
                                        }
                                        
                                        @if (isSpecialCategory)
                                        {
                                            <!-- Thêm tags cho các chuyên mục đặc biệt -->
                                            <div class="mb-2">
                                                @if (category.Slug == "con-nguoi")
                                                {
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;">Nhân vật</span>
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;">Câu chuyện</span>
                                                }
                                                else if (category.Slug == "podcast")
                                                {
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;"><i class="fas fa-headphones me-1"></i>Audio</span>
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;">Phỏng vấn</span>
                                                }
                                                else if (category.Slug == "emagazine")
                                                {
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;"><i class="fas fa-tablet-alt me-1"></i>Tương tác</span>
                                                    <span class="badge bg-light text-dark me-1" style="font-size: 0.7rem;">Số mới</span>
                                                }
                                            </div>
                                        }
                                        
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="far fa-calendar me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")
                                            </small>
                                            @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="far fa-eye me-1"></i>@article.ViewCount
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (currentLayout == 1)
                {
                    <!-- Layout 2: Featured Left + Grid Right -->
                    <div class="row g-4">
                        @{
                            var featuredArticle = articles.First();
                            var otherArticles = articles.Skip(1).Take(4);
                        }
                        <div class="col-md-6">
                            <div class="news-card-home h-100 bg-white rounded shadow-sm overflow-hidden">
                                <div class="news-image-home mb-0 position-relative">
                                    <img src="@(string.IsNullOrEmpty(featuredArticle.ThumbnailImage) ? "/images/placeholder-article.jpg" : featuredArticle.ThumbnailImage)"
                                         class="img-fluid w-100" alt="@featuredArticle.Title" style="height: 350px; object-fit: cover;">
                                    <div class="card-overlay"></div>
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge bg-danger ">@featuredArticle.Category.CategoryName</span>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h4 class="news-card-title mb-3">
                                        <a href="@Url.Action("Details", "Article", new { slug = featuredArticle.Slug })" class="text-dark text-decoration-none">
                                            @featuredArticle.Title
                                        </a>
                                    </h4>
                                    @{
                                        var featuredSummaryText = "";
                                        var featuredSummaryLength = isSpecialCategory ? 220 : 150;
                                        
                                        if (!string.IsNullOrEmpty(featuredArticle.Summary))
                                        {
                                            featuredSummaryText = featuredArticle.Summary.Length > featuredSummaryLength ? 
                                                featuredArticle.Summary.Substring(0, featuredSummaryLength) + "..." : featuredArticle.Summary;
                                        }
                                        else if (isSpecialCategory)
                                        {
                                            if (category.Slug == "con-nguoi")
                                                featuredSummaryText = "Đắm mình vào những câu chuyện về cuộc đời, con người và những khoảnh khắc đáng nhớ. Khám phá thế giới nội tâm phong phú và những trải nghiệm sống động từ các nhân vật, các cá nhân tiêu biểu trong xã hội.";
                                            else if (category.Slug == "podcast")
                                                featuredSummaryText = "Trải nghiệm âm thanh đa chiều với những chương trình podcast chất lượng cao. Lắng nghe những chia sẻ sâu sắc, phỏng vấn thú vị và các cuộc trò chuyện mang tính nhân văn về văn hóa, nghệ thuật và cuộc sống.";
                                            else if (category.Slug == "emagazine")
                                                featuredSummaryText = "Khám phá tạp chí điện tử tương tác với thiết kế hiện đại, nội dung phong phú và trải nghiệm đọc hoàn toàn mới. Tận hưởng các bài viết được trình bày sinh động với hình ảnh, video và các yếu tố tương tác hấp dẫn.";
                                        }
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(featuredSummaryText))
                                    {
                                        <p class="news-card-summary text-muted mb-3">
                                            @featuredSummaryText
                                        </p>
                                    }
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="far fa-calendar me-1"></i>@featuredArticle.PublishedAt?.ToString("dd/MM/yyyy")
                                        </small>
                                        @if (featuredArticle.ViewCount.HasValue && featuredArticle.ViewCount > 0)
                                        {
                                            <small class="text-muted">
                                                <i class="far fa-eye me-1"></i>@featuredArticle.ViewCount
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-3">
                                @foreach (var article in otherArticles)
                                {
                                    <div class="col-12">
                                        <div class="row g-3 secondary-card p-3 rounded bg-white shadow-sm">
                                            <div class="col-4">
                                                <div class="position-relative overflow-hidden rounded">
                                                    <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)"
                                                         class="img-fluid w-100" alt="@article.Title" style="height: 100px; object-fit: cover;">
                                                </div>
                                            </div>
                                            <div class="col-8">
                                                <h6 class="mb-2">
                                                    <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none">
                                                        @article.Title
                                                    </a>
                                                </h6>
                                                @if (isSpecialCategory && string.IsNullOrEmpty(article.Summary))
                                                {
                                                    <p class="small text-muted mb-1" style="font-size: 0.8rem;">
                                                        @if (category.Slug == "con-nguoi")
