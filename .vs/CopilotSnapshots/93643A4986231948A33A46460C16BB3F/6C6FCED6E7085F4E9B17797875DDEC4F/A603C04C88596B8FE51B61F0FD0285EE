using System.Diagnostics;
using Microsoft.AspNetCore.Mvc;
using SacViet.Models;
using SacViet.Services;
using SacViet.ViewModels;

namespace SacViet.Controllers
{
    public class HomeController : Controller
    {
        private readonly ILogger<HomeController> _logger;
        private readonly INewsService _newsService;

        public HomeController(ILogger<HomeController> logger, INewsService newsService)
        {
            _logger = logger;
            _newsService = newsService;
        }

        public async Task<IActionResult> Index()
        {
            try
            {
                // Lấy tất cả các danh mục (bao gồm cả danh mục con)
                var navigationCategories = await _newsService.GetNavigationCategoriesAsync();
                
                // Lấy tất cả các danh mục (cả chính và con) để hiển thị bài viết
                var allCategories = await _newsService.GetAllCategoriesAsync();
                
                // Lấy tất cả các category ID (bao gồm cả danh mục chính và danh mục con)
                var allCategoryIds = allCategories
                    .Select(c => c.CategoryId)
                    .ToList();
                
                // Lấy bài viết cho tất cả các danh mục
                var articlesByCategory = await _newsService.GetArticlesByCategoriesForHomeAsync(allCategoryIds, 6);
                
                // Lấy bài viết có nhiều lượt xem nhất trong ngày (cho main content)
                var mostViewedTodayArticles = await _newsService.GetMostViewedTodayArticlesAsync();
                
                // Lấy bài viết mới nhất (cho sidebar và các phần khác)
                var latestArticles = await _newsService.GetLatestArticlesAsync();
                
                // Tách bài viết cho sidebar (không trùng với main content)
                var mainContentArticleIds = mostViewedTodayArticles.Select(a => a.ArticleId).ToHashSet();
                var sidebarArticles = latestArticles
                    .Where(a => !mainContentArticleIds.Contains(a.ArticleId))
                    .Take(10)
                    .ToList();

                var viewModel = new HomePageViewModel
                {
                    FeaturedArticles = mostViewedTodayArticles.Take(5), // Sử dụng bài viết nhiều view nhất trong ngày
                    MostViewedTodayArticles = mostViewedTodayArticles,
                    SidebarArticles = sidebarArticles,
                    LatestArticles = latestArticles,
                    NavigationCategories = navigationCategories,
                    AllCategories = allCategories,
                    ArticlesByCategory = articlesByCategory
                };

                return View(viewModel);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Lỗi khi tải trang chủ");
                // Return empty view model if there's an error
                return View(new HomePageViewModel());
            }
        }

        [HttpGet]
        public async Task<IActionResult> Search(string keyword, int? categoryId, int? authorId, DateTime? fromDate, DateTime? toDate, int page = 1)
        {
            try
            {
                var (articles, totalCount) = await _newsService.SearchArticlesAsync(keyword, categoryId, authorId, fromDate, toDate, page, 10);
                var categories = await _newsService.GetNavigationCategoriesAsync();

                var viewModel = new SearchViewModel
                {
                    Keyword = keyword,
                    CategoryId = categoryId,
                    AuthorId = authorId,
                    FromDate = fromDate,
                    ToDate = toDate,
                    Page = page,
                    PageSize = 10,
                    TotalCount = totalCount,
                    Articles = articles,
                    Categories = categories
                };

                return View(viewModel);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Lỗi khi tìm kiếm");
                return View(new SearchViewModel());
            }
        }

        public IActionResult Privacy()
        {
            return View();
        }

        [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]
        public IActionResult Error()
        {
            return View(new ErrorViewModel { RequestId = Activity.Current?.Id ?? HttpContext.TraceIdentifier });
        }
    }
}
