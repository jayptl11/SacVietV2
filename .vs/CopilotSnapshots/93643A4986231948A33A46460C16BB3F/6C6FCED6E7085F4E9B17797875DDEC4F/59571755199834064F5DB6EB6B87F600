            ("con-nguoi", "fas fa-users"),           // Con ng??i
            ("am-thuc", "fas fa-utensils"),          // ?m th?c
            ("trang-phuc-va-kien-truc", "fas fa-building"), // Trang ph?c & Ki?n trúc
            ("thanh-sac", "fas fa-palette"),         // Thanh - S?c
            ("podcast", "fas fa-podcast"),           // Multimedia: Podcast
            ("video", "fas fa-video"),               // Multimedia: Video
            ("infographic", "fas fa-chart-bar"),     // Multimedia: Infographic
            ("longform", "fas fa-scroll"),           // Multimedia: Longform
            ("emagazine", "fas fa-book-open")        // Multimedia: eMagazine
        };

        // L?y danh m?c có bài vi?t theo th? t? ?ã ??nh
        var orderedCategories = new List<(SacViet.Models.Category category, string icon)>();
        
        foreach (var (slug, icon) in categoryOrder)
        {
            var category = Model.AllCategories.FirstOrDefault(c => c.Slug == slug && 
                Model.ArticlesByCategory.ContainsKey(c.CategoryId) && 
                Model.ArticlesByCategory[c.CategoryId].Any());
            
            if (category != null)
            {
                orderedCategories.Add((category, icon));
            }
        }

        // Thi?t k? ?a d?ng cho t?ng danh m?c
        var layoutIndex = 0;
        foreach (var (category, categoryIcon) in orderedCategories)
        {
            var articles = Model.ArticlesByCategory[category.CategoryId];
            var currentLayout = layoutIndex % 4; // 4 ki?u layout khác nhau
           