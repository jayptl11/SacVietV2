@{
    if (Model.ArticlesByCategory.Any())
    {
        // ??nh ngh?a th? t? hi?n th? danh m?c c? ??nh v?i icon t??ng ?ng
        var categoryOrder = new List<(string slug, string icon)>
        {
            ("trong-nuoc", "fas fa-home"),           // Nh?p v?n hóa: Trong n??c
            ("the-gioi", "fas fa-globe-asia"),       // Nh?p v?n hóa: Th? gi?i
