@model IEnumerable<SacViet.ViewModels.ArticleListItemViewModel>
@{
    ViewData["Title"] = "Duyệt bài viết";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
}

<!-- Anti-forgery token đặt ở đầu để đảm bảo có sẵn cho JavaScript -->
@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-danger">
                <i class="fas fa-check-circle me-2"></i>Duyệt bài viết
            </h2>
            <p class="text-muted">
                <i class="fas fa-info-circle me-1"></i>
                Danh sách các bài viết của bạn đang chờ duyệt. Bạn có thể tự duyệt để đăng bài hoặc hủy để chỉnh sửa lại.
            </p>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-warning fs-6">
                <i class="fas fa-clock me-1"></i>@totalCount bài chờ duyệt
            </span>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                </a>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary">
                    <i class="fas fa-list me-1"></i>Tất cả bài viết
                </a>
                <a href="@Url.Action("Create")" class="btn btn-outline-primary">
                    <i class="fas fa-plus-circle me-1"></i>Viết bài mới
                </a>
            </div>
        </div>
    </div>

    <!-- Articles List -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm article-card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <!-- Thumbnail -->
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(article.ThumbnailImage))
                                    {
                                        <img src="@article.ThumbnailImage" class="img-fluid rounded" alt="@article.Title"
                                             style="height: 120px; width: 100%; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 120px;">
                                            <i class="fas fa-image fa-2x text-muted"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Article Info -->
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <span class="badge bg-secondary me-2">@article.CategoryName</span>
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock me-1"></i>Chờ duyệt
                                        </span>
                                    </div>

                                    <h5 class="card-title mb-2">
                                        <a href="@Url.Action("Edit", new { id = article.ArticleId })"
                                           class="text-dark text-decoration-none">
                                            @article.Title
                                        </a>
                                    </h5>

                                    <div class="text-muted small">
                                        <span class="me-3">
                                            <i class="fas fa-calendar me-1"></i>
                                            Tạo: @article.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                        @if (article.ScheduledPublishDate.HasValue)
                                        {
                                            <span class="text-info">
                                                <i class="fas fa-clock me-1"></i>
                                                Hẹn đăng: @article.ScheduledPublishDate?.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="col-md-4 text-end">
                                    <div class="btn-group-vertical w-100" role="group">
                                        <!-- Approve Button - sử dụng data attributes thay vì inline onclick -->
                                        <button type="button" class="btn btn-success mb-2 btn-approve"
                                                data-article-id="@article.ArticleId"
                                                data-article-title="@Html.Encode(article.Title)">
                                            <i class="fas fa-check-circle me-2"></i>Duyệt & Đăng bài
                                        </button>

                                        <!-- View/Edit Button -->
                                        <a href="@Url.Action("Edit", new { id = article.ArticleId })"
                                           class="btn btn-outline-primary mb-2">
                                            <i class="fas fa-edit me-2"></i>Xem & Chỉnh sửa
                                        </a>

                                        <!-- Cancel/Reject Button - sử dụng data attributes -->
                                        <button type="button" class="btn btn-outline-secondary btn-reject"
                                                data-article-id="@article.ArticleId"
                                                data-article-title="@Html.Encode(article.Title)">
                                            <i class="fas fa-undo me-2"></i>Hủy & Chỉnh sửa lại
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = currentPage - 1 })">
                                <i class="fas fa-chevron-left me-1"></i>Trước
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = i })">
                                @i
                            </a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = currentPage + 1 })">
                                Sau<i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-check-double fa-4x text-success mb-3"></i>
                <h5 class="text-muted">Không có bài viết nào chờ duyệt</h5>
                <p class="text-muted">Tất cả bài viết của bạn đã được xử lý!</p>
                <div class="mt-3">
                    <a href="@Url.Action("Create")" class="btn btn-primary me-2">
                        <i class="fas fa-plus-circle me-2"></i>Viết bài mới
                    </a>
                    <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-2"></i>Xem tất cả bài viết
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle me-2"></i>Xác nhận duyệt bài
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn duyệt và đăng bài viết:</p>
                <p class="fw-bold text-primary" id="approveArticleTitle"></p>
                <div class="mb-3">
                    <label class="form-label">Ghi chú (tùy chọn):</label>
                    <textarea id="approveNote" class="form-control" rows="2" placeholder="Nhập ghi chú nếu cần..."></textarea>
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <small>Bài viết sẽ được đăng ngay lập tức hoặc theo lịch hẹn giờ đã đặt.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="confirmApproveBtn">
                    <i class="fas fa-check-circle me-2"></i>Xác nhận duyệt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-undo me-2"></i>Hủy & Chỉnh sửa lại
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn muốn hủy gửi duyệt và chỉnh sửa lại bài viết:</p>
                <p class="fw-bold text-primary" id="rejectArticleTitle"></p>
                <div class="mb-3">
                    <label class="form-label">Lý do (tùy chọn):</label>
                    <textarea id="rejectNote" class="form-control" rows="2" placeholder="Nhập lý do hủy nếu cần..."></textarea>
                </div>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <small>Bài viết sẽ được chuyển về trạng thái nháp để bạn có thể chỉnh sửa.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="confirmRejectBtn">
                    <i class="fas fa-undo me-2"></i>Xác nhận hủy
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .article-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .article-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.12) !important;
    }

    .btn-group-vertical .btn {
        text-align: left;
        padding: 10px 15px;
    }
</style>

@section Scripts {
    <script>
        (function() {
            // Lưu URL actions
            const selfApproveUrl = '@Url.Action("SelfApprove", "Writer")';
            const selfRejectUrl = '@Url.Action("SelfReject", "Writer")';
            
            let currentArticleId = 0;
            let approveModal = null;
            let rejectModal = null;

            // Khởi tạo khi DOM ready
            document.addEventListener('DOMContentLoaded', function() {
                // Khởi tạo modals
                approveModal = new bootstrap.Modal(document.getElementById('approveModal'));
                rejectModal = new bootstrap.Modal(document.getElementById('rejectModal'));

                // Gán event cho tất cả nút Approve
                document.querySelectorAll('.btn-approve').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        currentArticleId = this.getAttribute('data-article-id');
                        const title = this.getAttribute('data-article-title');
                        document.getElementById('approveArticleTitle').textContent = title;
                        document.getElementById('approveNote').value = '';
                        approveModal.show();
                    });
                });

                // Gán event cho tất cả nút Reject
                document.querySelectorAll('.btn-reject').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        currentArticleId = this.getAttribute('data-article-id');
                        const title = this.getAttribute('data-article-title');
                        document.getElementById('rejectArticleTitle').textContent = title;
                        document.getElementById('rejectNote').value = '';
                        rejectModal.show();
                    });
                });

                // Xác nhận duyệt
                document.getElementById('confirmApproveBtn').addEventListener('click', function() {
                    const note = document.getElementById('approveNote').value;
                    submitAction(selfApproveUrl, currentArticleId, note);
                });

                // Xác nhận hủy
                document.getElementById('confirmRejectBtn').addEventListener('click', function() {
                    const note = document.getElementById('rejectNote').value;
                    submitAction(selfRejectUrl, currentArticleId, note);
                });
            });

            function submitAction(url, articleId, note) {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!tokenElement) {
                    alert('Lỗi: Không tìm thấy token xác thực. Vui lòng tải lại trang.');
                    return;
                }
                const token = tokenElement.value;

                // Disable buttons while processing
                const approveBtn = document.getElementById('confirmApproveBtn');
                const rejectBtn = document.getElementById('confirmRejectBtn');
                approveBtn.disabled = true;
                rejectBtn.disabled = true;

                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        articleId: articleId,
                        note: note || '',
                        __RequestVerificationToken: token
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    // Hide modals
                    if (approveModal) approveModal.hide();
                    if (rejectModal) rejectModal.hide();

                    if (data.success) {
                        // Show success message
                        alert(data.message);
                        // Reload page
                        location.reload();
                    } else {
                        alert('Lỗi: ' + data.message);
                        // Re-enable buttons
                        approveBtn.disabled = false;
                        rejectBtn.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra. Vui lòng thử lại.');
                    // Re-enable buttons
                    approveBtn.disabled = false;
                    rejectBtn.disabled = false;
                });
            }
        })();
    </script>
}
