        public async Task<string> UploadImageAsync(IFormFile file)
        {
            if (file == null || file.Length == 0)
            {
                throw new ArgumentException("File không hợp lệ");
            }

            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
            var extension = Path.GetExtension(file.FileName).ToLowerInvariant();

            if (!allowedExtensions.Contains(extension))
            {
                throw new ArgumentException("Chỉ chấp nhận file ảnh (.jpg, .jpeg, .png, .gif, .webp)");
            }

            var uploadsFolder = Path.Combine(_environment.WebRootPath, "uploads", "articles");
            Directory.CreateDirectory(uploadsFolder);

            var uniqueFileName = $"{Guid.NewGuid()}{extension}";
            var filePath = Path.Combine(uploadsFolder, uniqueFileName);

            using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await file.CopyToAsync(fileStream);
            }

            return $"/uploads/articles/{uniqueFileName}";
        }

        private async Task AddTagsToArticleAsync(int articleId, List<string> tagNames)
        {
            var article = await _context.Articles
                .Include(a => a.Tags)
                .FirstOrDefaultAsync(a => a.ArticleId == articleId);

            if (article == null) return;

            foreach (var tagName in tagNames)
            {
                var tag = await _context.Tags.FirstOrDefaultAsync(t => t.TagName == tagName);
                if (tag == null)
                {
                    tag = new Tag
                    {
                        TagName = tagName,
                        Slug = GenerateSlug(tagName),
                        CreatedAt = DateTime.Now
                    };
                    _context.Tags.Add(tag);
                    await _context.SaveChangesAsync();
                }

                if (!article.Tags.Contains(tag))
                {
                    article.Tags.Add(tag);
                }
            }

            await _context.SaveChangesAsync();
        }

        private string GenerateSlug(string text)
        {
            if (string.IsNullOrWhiteSpace(text))
                return string.Empty;

            // Convert to lowercase
            text = text.ToLowerInvariant();

            // Replace Vietnamese characters
            text = text.Replace("à", "a").Replace("á", "a").Replace("ạ", "a").Replace("ả", "a").Replace("ã", "a")
                       .Replace("â", "a").Replace("ầ", "a").Replace("ấ", "a").Replace("ậ", "a").Replace("ổ", "a").Replace("ỗ", "a")
                       .Replace("ă", "a").Replace("ằ", "a").Replace("ắ", "a").Replace("ặ", "a").Replace("ẳ", "a").Replace("ẵ", "a")
                       .Replace("è", "e").Replace("é", "e").Replace("ẹ", "e").Replace("ẻ", "e").Replace("ẽ", "e")
                       .Replace("ê", "e").Replace("ề", "e").Replace("ế", "e").Replace("ệ", "e").Replace("ể", "e").Replace("ễ", "e")
                       .Replace("ì", "i").Replace("í", "i").Replace("ị", "i").Replace("ỉ", "i").Replace("ĩ", "i")
                       .Replace("ò", "o").Replace("ó", "o").Replace("ọ", "o").Replace("ỏ", "o").Replace("õ", "o")
                       .Replace("ô", "o").Replace("ồ", "o").Replace("ố", "o").Replace("ộ", "o").Replace("ổ", "o").Replace("ỗ", "o")
                       .Replace("ơ", "o").Replace("ờ", "o").Replace("ớ", "o").Replace("ợ", "o").Replace("ở", "o").Replace("ỡ", "o")
                       .Replace("ù", "u").Replace("ú", "u").Replace("ụ", "u").Replace("ủ", "u").Replace("ũ", "u")
                       .Replace("ư", "u").Replace("ừ", "u").Replace("ứ", "u").Replace("ự", "u").Replace("ử", "u").Replace("ữ", "u")
                       .Replace("ỳ", "y").Replace("ý", "y").Replace("ỵ", "y").Replace("ỷ", "y").Replace("ỹ", "y")
                       .Replace("đ", "d");

            // Remove invalid characters
            text = Regex.Replace(text, @"[^a-z0-9\s-]", "");

            // Convert multiple spaces/hyphens into one space
            text = Regex.Replace(text, @"[\s-]+", " ").Trim();

            // Replace spaces with hyphens
            text = Regex.Replace(text, @"\s", "-");

            // Add timestamp to make it unique
            text = $"{text}-{DateTime.Now:yyyyMMddHHmmss}";

            return text;
        }

        /// <summary>
        /// Convert Google Drive share URL to direct playable URL
        /// </summary>
        private string? ConvertGoogleDriveAudioUrl(string? audioUrl)
        {
            if (string.IsNullOrWhiteSpace(audioUrl))
                return audioUrl;

            // If not a Google Drive URL, return as-is
            if (!audioUrl.Contains("drive.google.com"))
                return audioUrl;

            // Extract FILE_ID from various Google Drive URL formats
            string? fileId = null;

            // Format 1: https://drive.google.com/file/d/FILE_ID/view
            var match1 = Regex.Match(audioUrl, @"/file/d/([^/\?]+)");
            if (match1.Success)
            {
                fileId = match1.Groups[1].Value;
            }

            // Format 2: https://drive.google.com/open?id=FILE_ID
            if (string.IsNullOrEmpty(fileId))
            {
                var match2 = Regex.Match(audioUrl, @"[?&]id=([^&]+)");
                if (match2.Success)
                {
                    fileId = match2.Groups[1].Value;
                }
            }

            // If FILE_ID found, convert to direct playable URL
            if (!string.IsNullOrEmpty(fileId))
            {
                // Use 'export=open' for inline playback (not forced download)
                return $"https://drive.google.com/uc?export=open&id={fileId}";
            }

            // If already in direct format or can't extract, return original
            return audioUrl;
        }

        public async Task<(IEnumerable<ArticleListItemViewModel> Articles, int TotalCount)> GetPendingArticlesForSelfApprovalAsync(
            int userId, int page, int pageSize)
        {
            var query = _context.Articles
                .Include(a => a.Category)
                .Where(a => a.AuthorId == userId && a.Status == "Pending");

            var totalCount = await query.CountAsync();

            var articles = await query
                .OrderByDescending(a => a.CreatedAt)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(a => new ArticleListItemViewModel
                {
                    ArticleId = a.ArticleId,
                    Title = a.Title,
                    Slug = a.Slug,
                    ThumbnailImage = a.ThumbnailImage,
                    CategoryName = a.Category.CategoryName,
                    Status = a.Status ?? "Draft",
                    ViewCount = a.ViewCount ?? 0,
                    CreatedAt = a.CreatedAt,
                    UpdatedAt = a.UpdatedAt,
                    PublishedAt = a.PublishedAt,
                    ScheduledPublishDate = a.ScheduledPublishDate,
                    LatestApprovalStatus = a.ArticleApprovals
                        .OrderByDescending(aa => aa.SubmittedAt)
                        .Select(aa => aa.Status)
                        .FirstOrDefault(),
                    RejectionReason = a.ArticleApprovals
                        .Where(aa => aa.Status == "Rejected")
                        .OrderByDescending(aa => aa.ReviewedAt)
                        .Select(aa => aa.ReviewNote)
                        .FirstOrDefault()
                })
                .ToListAsync();

            return (articles, totalCount);
        }

        public async Task<ServiceResult> SelfApproveArticleAsync(int articleId, int userId, string note = "")
        {
            try
            {
                var article = await _context.Articles
                    .Include(a => a.ArticleApprovals)
                    .FirstOrDefaultAsync(a => a.ArticleId == articleId && a.AuthorId == userId);

                if (article == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy bài viết hoặc bạn không có quyền duyệt bài viết này");
                }

                if (article.Status != "Pending")
                {
                    return ServiceResult.CreateError("Chỉ có thể duyệt bài viết đang chờ duyệt");
                }

                Console.WriteLine($"[SelfApproveArticle] Article found: {article.Title}, Status: {article.Status}");
                Console.WriteLine($"[SelfApproveArticle] Scheduled: {article.ScheduledPublishDate}");

                // Check if article has scheduled publish date
                if (article.ScheduledPublishDate.HasValue)
                {
                    // If scheduled date is in the future, approve but don't publish yet
                    if (article.ScheduledPublishDate.Value > DateTime.Now)
                    {
                        article.Status = "Approved";
                        Console.WriteLine($"[SelfApproveArticle] Set status to Approved (scheduled for future)");
                    }
                    else
                    {
                        // Scheduled date has passed, publish immediately
                        article.Status = "Published";
                        article.PublishedAt = DateTime.Now;
                        Console.WriteLine($"[SelfApproveArticle] Set status to Published (scheduled date passed)");
                    }
                }
                else
                {
                    // No scheduled date, publish immediately
                    article.Status = "Published";
                    article.PublishedAt = DateTime.Now;
                    Console.WriteLine($"[SelfApproveArticle] Set status to Published (no schedule)");
                }

                // Update or create approval record
                var approval = article.ArticleApprovals
                    .OrderByDescending(a => a.SubmittedAt)
                    .FirstOrDefault(a => a.Status == "Pending");

                if (approval != null)
                {
                    // Update existing approval - Writer self-approves
                    Console.WriteLine($"[SelfApproveArticle] Updating existing approval: {approval.ApprovalId}");
                    approval.Status = "Approved";
                    approval.ReviewedAt = DateTime.Now;
                    approval.ReviewedByUserId = userId; // Writer approves their own article
                    approval.ReviewNote = string.IsNullOrEmpty(note) ? "Tự duyệt bởi tác giả" : note;
                }
                else
                {
                    // Create new approval record if not exists
                    Console.WriteLine($"[SelfApproveArticle] Creating new approval record");
                    var newApproval = new ArticleApproval
                    {
                        ArticleId = articleId,
                        SubmittedByUserId = userId,
                        ReviewedByUserId = userId, // Writer self-approves
                        Status = "Approved",
                        SubmittedAt = DateTime.Now,
                        ReviewedAt = DateTime.Now,
                        ReviewNote = string.IsNullOrEmpty(note) ? "Tự duyệt bởi tác giả" : note
                    };
                    _context.ArticleApprovals.Add(newApproval);
                }

                Console.WriteLine($"[SelfApproveArticle] Saving changes...");
                var changes = await _context.SaveChangesAsync();
                Console.WriteLine($"[SelfApproveArticle] Changes saved: {changes} rows affected");

                var message = article.Status == "Approved"
                    ? $"Bài viết đã được duyệt và sẽ tự động đăng vào {article.ScheduledPublishDate?.ToString("dd/MM/yyyy HH:mm")}"
                    : "Bài viết đã được duyệt và đăng thành công";

                return ServiceResult.CreateSuccess(message);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SelfApproveArticle] Exception: {ex.Message}");
                Console.WriteLine($"[SelfApproveArticle] InnerException: {ex.InnerException?.Message}");
                Console.WriteLine($"[SelfApproveArticle] StackTrace: {ex.StackTrace}");

                var innerException = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
                return ServiceResult.CreateError($"Lỗi: {innerException}");
            }
        }

        public async Task<ServiceResult> SelfRejectArticleAsync(int articleId, int userId, string note)
        {
            try
            {
                var article = await _context.Articles
                    .Include(a => a.ArticleApprovals)
                    .FirstOrDefaultAsync(a => a.ArticleId == articleId && a.AuthorId == userId);

                if (article == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy bài viết hoặc bạn không có quyền từ chối bài viết này");
                }

                if (article.Status != "Pending")
                {
                    return ServiceResult.CreateError("Chỉ có thể từ chối bài viết đang chờ duyệt");
                }

                // Update article status back to Draft for editing
                article.Status = "Draft";

                // Update or create approval record
                var approval = article.ArticleApprovals
                    .OrderByDescending(a => a.SubmittedAt)
                    .FirstOrDefault(a => a.Status == "Pending");

                if (approval != null)
                {
                    // Update existing approval
                    approval.Status = "Rejected";
                    approval.ReviewedAt = DateTime.Now;
                    approval.ReviewedByUserId = userId;
                    approval.ReviewNote = string.IsNullOrEmpty(note) ? "Tự hủy bởi tác giả" : note;
                }
                else
                {
                    // Create new approval record if not exists
                    var newApproval = new ArticleApproval
                    {
                        ArticleId = articleId,
                        SubmittedByUserId = userId,
                        ReviewedByUserId = userId,
                        Status = "Rejected",
                        SubmittedAt = DateTime.Now,
                        ReviewedAt = DateTime.Now,
                        ReviewNote = string.IsNullOrEmpty(note) ? "Tự hủy bởi tác giả" : note
                    };
                    _context.ArticleApprovals.Add(newApproval);
                }

                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Bài viết đã được chuyển về trạng thái nháp để chỉnh sửa");
            }
            catch (Exception ex)
            {
                var innerException = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
                return ServiceResult.CreateError($"Lỗi: {innerException}");
            }
        }
    }
