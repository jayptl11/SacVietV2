        public async Task<WriterStatsViewModel> GetWriterStatsAsync(int userId)
        {
            var articles = await _context.Articles
                .Where(a => a.AuthorId == userId)
                .ToListAsync();

            var stats = new WriterStatsViewModel
            {
                TotalArticles = articles.Count,
                DraftArticles = articles.Count(a => a.Status == "Draft"),
                PendingArticles = articles.Count(a => a.Status == "Pending"),
                PublishedArticles = articles.Count(a => a.Status == "Published"),
                TotalViews = articles.Sum(a => a.ViewCount ?? 0)
            };

            // Count approved and rejected from ArticleApprovals
            var approvals = await _context.ArticleApprovals
                .Where(aa => aa.SubmittedByUserId == userId)
                .GroupBy(aa => aa.Status)
                .Select(g => new { Status = g.Key, Count = g.Count() })
                .ToListAsync();

            stats.ApprovedArticles = approvals.FirstOrDefault(a => a.Status == "Approved")?.Count ?? 0;
            stats.RejectedArticles = approvals.FirstOrDefault(a => a.Status == "Rejected")?.Count ?? 0;

            return stats;
        }

        public async Task<(IEnumerable<ArticleListItemViewModel> Articles, int TotalCount)> GetMyArticlesAsync(
            int userId, string? status, int page, int pageSize)
        {
            var query = _context.Articles
                .Include(a => a.Category)
                .Where(a => a.AuthorId == userId);

            if (!string.IsNullOrEmpty(status))
            {
                query = query.Where(a => a.Status == status);
            }

            var totalCount = await query.CountAsync();

            var articles = await query
                .OrderByDescending(a => a.CreatedAt)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(a => new ArticleListItemViewModel
                {
                    ArticleId = a.ArticleId,
                    Title = a.Title,
                    Slug = a.Slug,
                    ThumbnailImage = a.ThumbnailImage,
                    CategoryName = a.Category.CategoryName,
                    Status = a.Status ?? "Draft",
                    ViewCount = a.ViewCount ?? 0,
                    CreatedAt = a.CreatedAt,
                    UpdatedAt = a.UpdatedAt,
                    PublishedAt = a.PublishedAt,
                    LatestApprovalStatus = a.ArticleApprovals
                        .OrderByDescending(aa => aa.SubmittedAt)
                        .Select(aa => aa.Status)
                        .FirstOrDefault(),
                    RejectionReason = a.ArticleApprovals
                        .Where(aa => aa.Status == "Rejected")
                        .OrderByDescending(aa => aa.ReviewedAt)
                        .Select(aa => aa.ReviewNote)
                        .FirstOrDefault()
                })
                .ToListAsync();

            return (articles, totalCount);
        }

        public async Task<int> CreateArticleAsync(ArticleCreateViewModel model, int userId, string status)
        {
            // Decode inputs that might be HTML-encoded by client or upstream tools
            var decodedTitle = WebUtility.HtmlDecode(model.Title ?? string.Empty);
            var decodedSummary = WebUtility.HtmlDecode(model.Summary ?? string.Empty);
            var decodedVideoTitle = string.IsNullOrWhiteSpace(model.VideoTitle) ? null : WebUtility.HtmlDecode(model.VideoTitle);

            var article = new Article
            {
                Title = decodedTitle,
                Slug = GenerateSlug(decodedTitle),
                Summary = decodedSummary,
                Content = model.Content,
                ThumbnailImage = model.ThumbnailImage,
                CategoryId = model.CategoryId,
                AuthorId = userId,
                Status = status,
                ViewCount = 0,
                ScheduledPublishDate = model.ScheduledPublishDate,
                AudioUrl = ConvertGoogleDriveAudioUrl(model.AudioUrl),
                VideoUrl = model.VideoUrl,
                VideoTitle = decodedVideoTitle,
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now
            };

            _context.Articles.Add(article);
            await _context.SaveChangesAsync();

            // Persist inline media
            await UpsertInlineMediaAsync(article.ArticleId, model.Videos, model.Images);

            if (model.Tags != null && model.Tags.Any())
            {
                await AddTagsToArticleAsync(article.ArticleId, model.Tags);
            }

            if (status == "Pending")
            {
                var approval = new ArticleApproval
                {
                    ArticleId = article.ArticleId,
                    SubmittedByUserId = userId,
                    Status = "Pending",
                    SubmittedAt = DateTime.Now
                };
                _context.ArticleApprovals.Add(approval);
                await _context.SaveChangesAsync();
            }

            return article.ArticleId;
        }

        public async Task<ArticleEditViewModel?> GetArticleForEditAsync(int articleId, int userId)
        {
            var article = await _context.Articles
                .Include(a => a.Category)
                .Include(a => a.Tags)
                .Include(a => a.InlineMedia)
                .FirstOrDefaultAsync(a => a.ArticleId == articleId && a.AuthorId == userId);

            if (article == null)
            {
                return null;
            }

            return new ArticleEditViewModel
            {
                ArticleId = article.ArticleId,
                Title = article.Title,
                Slug = article.Slug,
                Summary = article.Summary,
                Content = article.Content,
                ThumbnailImage = article.ThumbnailImage,
                CategoryId = article.CategoryId,
                Status = article.Status,
                ScheduledPublishDate = article.ScheduledPublishDate,
                AudioUrl = article.AudioUrl,
                VideoUrl = article.VideoUrl,
                VideoTitle = article.VideoTitle,
                CreatedAt = article.CreatedAt,
                UpdatedAt = article.UpdatedAt,
                Tags = article.Tags.Select(t => t.TagName).ToList(),
                Videos = article.InlineMedia.Where(m => m.MediaType == "video")
                          .OrderBy(m => m.DisplayOrder)
                          .Select(m => new MediaLinkViewModel { Url = m.Url, Title = m.Title })
                          .ToList(),
                Images = article.InlineMedia.Where(m => m.MediaType == "image")
                          .OrderBy(m => m.DisplayOrder)
                          .Select(m => new MediaLinkViewModel { Url = m.Url, Title = m.Title })
                          .ToList()
            };
        }

        public async Task<bool> UpdateArticleAsync(int articleId, ArticleEditViewModel model, int userId, string status)
        {
            var article = await _context.Articles
                .Include(a => a.Tags)
                .FirstOrDefaultAsync(a => a.ArticleId == articleId && a.AuthorId == userId);

            if (article == null)
            {
                return false;
            }

            // Allow updates if Draft/Rejected OR if Admin and article is Published
            var isAdmin = await _context.Users.AnyAsync(u => u.UserId == userId && u.Role.RoleName == "Admin");
            if (!(article.Status == "Draft" || article.Status == "Rejected" || (isAdmin && article.Status == "Published")))
            {
                return false;
            }

            // Decode potentially HTML-encoded inputs
            var decodedTitle = WebUtility.HtmlDecode(model.Title ?? string.Empty);
            var decodedSummary = WebUtility.HtmlDecode(model.Summary ?? string.Empty);
            var decodedVideoTitle = string.IsNullOrWhiteSpace(model.VideoTitle) ? null : WebUtility.HtmlDecode(model.VideoTitle);

            article.Title = decodedTitle;
            article.Slug = GenerateSlug(decodedTitle);
            article.Summary = decodedSummary;
            article.Content = model.Content;
            article.ThumbnailImage = model.ThumbnailImage;
            article.CategoryId = model.CategoryId;
            article.ScheduledPublishDate = model.ScheduledPublishDate;
            article.AudioUrl = ConvertGoogleDriveAudioUrl(model.AudioUrl);
            article.VideoUrl = model.VideoUrl;
            article.VideoTitle = decodedVideoTitle;
            article.UpdatedAt = DateTime.Now;

            // If admin is editing published, keep status Published; otherwise apply requested status
            if (isAdmin && article.Status == "Published")
            {
                article.Status = "Published";
            }
            else
            {
                article.Status = status;
            }

            // Update tags
            article.Tags.Clear();
            if (model.Tags != null && model.Tags.Any())
            {
                await AddTagsToArticleAsync(article.ArticleId, model.Tags);
            }

            // Upsert inline media
            await UpsertInlineMediaAsync(article.ArticleId, model.Videos, model.Images);

            if (status == "Pending" && !(isAdmin && article.Status == "Published"))
            {
                var approval = new ArticleApproval
                {
                    ArticleId = article.ArticleId,
                    SubmittedByUserId = userId,
                    Status = "Pending",
                    SubmittedAt = DateTime.Now
                };
                _context.ArticleApprovals.Add(approval);
            }

            await _context.SaveChangesAsync();
            return true;
        }

        private async Task UpsertInlineMediaAsync(int articleId, List<MediaLinkViewModel> videos, List<MediaLinkViewModel> images)
        {
            // Remove current then add again (simpler approach)
            var existing = _context.ArticleInlineMedia.Where(m => m.ArticleId == articleId);
            _context.ArticleInlineMedia.RemoveRange(existing);
            await _context.SaveChangesAsync();

            int order = 0;
            foreach (var v in videos.Where(v => !string.IsNullOrWhiteSpace(v.Url)))
            {
                _context.ArticleInlineMedia.Add(new ArticleInlineMedia
                {
                    ArticleId = articleId,
                    MediaType = "video",
                    Url = v.Url!,
                    Title = string.IsNullOrWhiteSpace(v.Title) ? null : WebUtility.HtmlDecode(v.Title),
                    DisplayOrder = order++,
                    CreatedAt = DateTime.Now
                });
            }
            foreach (var i in images.Where(i => !string.IsNullOrWhiteSpace(i.Url)))
            {
                _context.ArticleInlineMedia.Add(new ArticleInlineMedia
                {
                    ArticleId = articleId,
                    MediaType = "image",
                    Url = i.Url!,
                    Title = string.IsNullOrWhiteSpace(i.Title) ? null : WebUtility.HtmlDecode(i.Title),
                    DisplayOrder = order++,
                    CreatedAt = DateTime.Now
                });
            }
            await _context.SaveChangesAsync();
        }

        public async Task<bool> DeleteArticleAsync(int articleId, int userId)
        {
            var article = await _context.Articles
                .FirstOrDefaultAsync(a => a.ArticleId == articleId && a.AuthorId == userId);

            if (article == null)
            {
                return false;
            }

            // Only allow deleting Draft articles
            if (article.Status != "Draft")
            {
                return false;
            }

            _context.Articles.Remove(article);
            await _context.SaveChangesAsync();
            return true;
        }

