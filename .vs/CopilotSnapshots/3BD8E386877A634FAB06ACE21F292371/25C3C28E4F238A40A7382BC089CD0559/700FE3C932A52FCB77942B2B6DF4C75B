        public async Task<AdminDashboardViewModel> GetDashboardStatsAsync()
        {
            var today = DateTime.Today;
            var thisMonth = new DateTime(today.Year, today.Month, 1);

            var dashboard = new AdminDashboardViewModel
            {
                TotalArticles = await _context.Articles.CountAsync(),
                PendingArticles = await _context.Articles.CountAsync(a => a.Status == "Pending"),
                PublishedArticles = await _context.Articles.CountAsync(a => a.Status == "Published"),
                TotalUsers = await _context.Users.CountAsync(),
                TotalWriters = await _context.Users.Include(u => u.Role).CountAsync(u => u.Role.RoleName == "Writer"),
                TotalCategories = await _context.Categories.CountAsync(),
                TodayViews = await _context.Articles.Where(a => a.PublishedAt >= today).SumAsync(a => (int?)a.ViewCount) ?? 0,
                TotalViews = await _context.Articles.SumAsync(a => (int?)a.ViewCount) ?? 0
            };

            // Recent Articles
            dashboard.RecentArticles = await _context.Articles
                .Include(a => a.Author)
                .OrderByDescending(a => a.CreatedAt)
                .Take(10)
                .Select(a => new AdminRecentArticleViewModel
                {
                    ArticleId = a.ArticleId,
                    Title = a.Title,
                    AuthorName = a.Author.FullName,
                    Status = a.Status ?? "Draft",
                    CreatedAt = a.CreatedAt ?? DateTime.Now,
                    ViewCount = a.ViewCount ?? 0
                })
                .ToListAsync();

            // Top Articles
            dashboard.TopArticles = await _context.Articles
                .Include(a => a.Author)
                .Where(a => a.Status == "Published")
                .OrderByDescending(a => a.ViewCount)
                .Take(10)
                .Select(a => new AdminTopArticleViewModel
                {
                    ArticleId = a.ArticleId,
                    Title = a.Title,
                    AuthorName = a.Author.FullName,
                    ViewCount = a.ViewCount ?? 0,
                    Slug = a.Slug
                })
                .ToListAsync();

            // Recent Users
            dashboard.RecentUsers = await _context.Users
                .Include(u => u.Role)
                .OrderByDescending(u => u.CreatedAt)
                .Take(10)
                .Select(u => new AdminRecentUserViewModel
                {
                    UserId = u.UserId,
                    FullName = u.FullName,
                    Email = u.Email,
                    Role = u.Role.RoleName,
                    CreatedAt = u.CreatedAt ?? DateTime.Now,
                    IsActive = u.IsActive ?? true
                })
                .ToListAsync();

            // Monthly Stats
            dashboard.MonthlyStats = await GetMonthlyStatsAsync(6);

            return dashboard;
        }

        public async Task<AdminArticlesViewModel> GetArticlesAsync(string status, string search, int page, int pageSize = 20)
        {
            var query = _context.Articles
                .Include(a => a.Author)
                .Include(a => a.Category)
                .Include(a => a.ArticleApprovals)
                .AsQueryable();

            if (!string.IsNullOrEmpty(status))
            {
                query = query.Where(a => a.Status == status);
            }

            if (!string.IsNullOrEmpty(search))
            {
                query = query.Where(a => a.Title.Contains(search) || a.Author.FullName.Contains(search));
            }

            var totalItems = await query.CountAsync();
            var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

            var articles = await query
                .OrderByDescending(a => a.CreatedAt)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(a => new AdminArticleListItemViewModel
                {
                    ArticleId = a.ArticleId,
                    Title = a.Title,
                    Slug = a.Slug,
                    AuthorName = a.Author.FullName,
                    CategoryName = a.Category.CategoryName,
                    Status = a.Status ?? "Draft",
                    CreatedAt = a.CreatedAt ?? DateTime.Now,
                    PublishedAt = a.PublishedAt,
                    ViewCount = a.ViewCount ?? 0,
                    ThumbnailImage = a.ThumbnailImage ?? "",
                    IsFeatured = false, // Will need to add this field to Article model later
                    LatestApprovalStatus = a.ArticleApprovals.OrderByDescending(ap => ap.SubmittedAt).FirstOrDefault().Status ?? "",
                    RejectionReason = a.ArticleApprovals.Where(ap => ap.Status == "Rejected").OrderByDescending(ap => ap.ReviewedAt).FirstOrDefault().ReviewNote ?? ""
                })
                .ToListAsync();

            return new AdminArticlesViewModel
            {
                Items = articles,
                CurrentPage = page,
                TotalPages = totalPages,
                TotalItems = totalItems,
                PageSize = pageSize,
                StatusFilter = status ?? "",
                SearchQuery = search ?? ""
            };
        }

        public async Task<ServiceResult> ApproveArticleAsync(int articleId, int adminUserId, string note = "")
        {
            try
            {
                var article = await _context.Articles
                    .Include(a => a.ArticleApprovals)
                    .FirstOrDefaultAsync(a => a.ArticleId == articleId);

                if (article == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy bài viết");
                }

                if (article.Status != "Pending")
                {
                    return ServiceResult.CreateError("Chỉ có thể duyệt bài viết đang chờ duyệt");
                }

                // Check if article has scheduled publish date
                if (article.ScheduledPublishDate.HasValue)
                {
                    // If scheduled date is in the future, approve but don't publish yet
                    if (article.ScheduledPublishDate.Value > DateTime.Now)
                    {
                        article.Status = "Approved"; // New status: approved but not published yet
                        // PublishedAt will be set by background job when scheduled time arrives
                    }
                    else
                    {
                        // Scheduled date has passed, publish immediately
                        article.Status = "Published";
                        article.PublishedAt = DateTime.Now;
                    }
                }
                else
                {
                    // No scheduled date, publish immediately
                    article.Status = "Published";
                    article.PublishedAt = DateTime.Now;
                }

                // Update approval record
                var approval = article.ArticleApprovals.FirstOrDefault(a => a.Status == "Pending");
                if (approval != null)
                {
                    approval.Status = "Approved";
                    approval.ReviewedAt = DateTime.Now;
                    approval.ReviewedByUserId = adminUserId;
                    approval.ReviewNote = note;
                }

                await _context.SaveChangesAsync();
                
                var message = article.Status == "Approved" 
                    ? $"Bài viết đã được duyệt và sẽ tự động đăng vào {article.ScheduledPublishDate?.ToString("dd/MM/yyyy HH:mm")}"
                    : "Bài viết đã được duyệt và đăng thành công";
                
                return ServiceResult.CreateSuccess(message);
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

        public async Task<ServiceResult> RejectArticleAsync(int articleId, int adminUserId, string note)
        {
            try
            {
                var article = await _context.Articles
                    .Include(a => a.ArticleApprovals)
                    .FirstOrDefaultAsync(a => a.ArticleId == articleId);

                if (article == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy bài viết");
                }

                if (article.Status != "Pending")
                {
                    return ServiceResult.CreateError("Chỉ có thể từ chối bài viết đang chờ duyệt");
                }

                // Update article status
                article.Status = "Rejected";

                // Update approval record
                var approval = article.ArticleApprovals.FirstOrDefault(a => a.Status == "Pending");
                if (approval != null)
                {
                    approval.Status = "Rejected";
                    approval.ReviewedAt = DateTime.Now;
                    approval.ReviewedByUserId = adminUserId;
                    approval.ReviewNote = note;
                }

                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Bài viết đã được từ chối");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

