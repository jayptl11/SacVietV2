        public async Task<ServiceResult> DeleteUserAsync(int userId)
        {
            try
            {
                var user = await _context.Users
                    .Include(u => u.Articles)
                    .FirstOrDefaultAsync(u => u.UserId == userId);

                if (user == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy người dùng");
                }

                if (user.Articles.Any())
                {
                    return ServiceResult.CreateError("Không thể xóa người dùng có bài viết");
                }

                _context.Users.Remove(user);
                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Đã xóa người dùng");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

        public async Task<AdminCategoriesViewModel> GetCategoriesAsync()
        {
            var categories = await _context.Categories
                .Include(c => c.ParentCategory)
                .Where(c => c.ParentCategoryId == null)
                .OrderBy(c => c.DisplayOrder)
                .Select(c => new AdminCategoryListItemViewModel
                {
                    CategoryId = c.CategoryId,
                    CategoryName = c.CategoryName,
                    Description = c.Description ?? "",
                    ParentCategoryId = c.ParentCategoryId,
                    ArticleCount = c.Articles.Count(),
                    IsActive = c.IsActive ?? true,
                    DisplayOrder = c.DisplayOrder ?? 0,
                    SubCategories = _context.Categories
                        .Where(sc => sc.ParentCategoryId == c.CategoryId)
                        .Select(sc => new AdminCategoryListItemViewModel
                        {
                            CategoryId = sc.CategoryId,
                            CategoryName = sc.CategoryName,
                            Description = sc.Description ?? "",
                            ParentCategoryId = sc.ParentCategoryId,
                            ArticleCount = sc.Articles.Count(),
                            IsActive = sc.IsActive ?? true,
                            DisplayOrder = sc.DisplayOrder ?? 0
                        }).OrderBy(sc => sc.DisplayOrder).ToList()
                })
                .ToListAsync();

            return new AdminCategoriesViewModel
            {
                Categories = categories
            };
        }

