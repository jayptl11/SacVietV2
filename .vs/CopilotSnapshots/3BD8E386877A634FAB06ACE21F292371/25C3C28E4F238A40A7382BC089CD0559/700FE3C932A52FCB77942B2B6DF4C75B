        public async Task<ServiceResult> DeleteCategoryAsync(int categoryId)
        {
            try
            {
                var category = await _context.Categories
                    .Include(c => c.Articles)
                    .FirstOrDefaultAsync(c => c.CategoryId == categoryId);

                if (category == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy danh mục");
                }

                var hasSubCategories = await _context.Categories.AnyAsync(c => c.ParentCategoryId == categoryId);
                
                if (category.Articles.Any() || hasSubCategories)
                {
                    return ServiceResult.CreateError("Không thể xóa danh mục có bài viết hoặc danh mục con");
                }

                _context.Categories.Remove(category);
                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Danh mục đã được xóa");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

