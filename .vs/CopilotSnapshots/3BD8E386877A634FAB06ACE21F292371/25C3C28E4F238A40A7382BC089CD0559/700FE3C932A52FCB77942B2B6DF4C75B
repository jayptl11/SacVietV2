        public async Task<AdminUsersViewModel> GetUsersAsync(string role, string search, int page, int pageSize = 20)
        {
            var query = _context.Users.Include(u => u.Role).AsQueryable();

            if (!string.IsNullOrEmpty(role))
            {
                query = query.Where(u => u.Role.RoleName == role);
            }

            if (!string.IsNullOrEmpty(search))
            {
                query = query.Where(u => u.FullName.Contains(search) || u.Email.Contains(search));
            }

            var totalItems = await query.CountAsync();
            var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

            var users = await query
                .OrderByDescending(u => u.CreatedAt)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(u => new AdminUserListItemViewModel
                {
                    UserId = u.UserId,
                    FullName = u.FullName,
                    Email = u.Email,
                    Role = u.Role.RoleName,
                    CreatedAt = u.CreatedAt ?? DateTime.Now,
                    LastLoginAt = u.LastLogin,
                    IsActive = u.IsActive ?? true,
                    IsBanned = false, // Will need to add this field to User model later
                    BanReason = "", // Will need to add this field to User model later
                    ArticleCount = u.Articles.Count(),
                    Avatar = u.Avatar ?? ""
                })
                .ToListAsync();

            return new AdminUsersViewModel
            {
                Items = users,
                CurrentPage = page,
                TotalPages = totalPages,
                TotalItems = totalItems,
                PageSize = pageSize,
                RoleFilter = role ?? "",
                SearchQuery = search ?? ""
            };
        }

        public async Task<ServiceResult> UpdateUserRoleAsync(int userId, string roleName)
        {
            try
            {
                var user = await _context.Users.FindAsync(userId);
                if (user == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy người dùng");
                }

                var role = await _context.Roles.FirstOrDefaultAsync(r => r.RoleName == roleName);
                if (role == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy vai trò");
                }

                user.RoleId = role.RoleId;
                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess($"Đã cập nhật quyền thành {roleName}");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

