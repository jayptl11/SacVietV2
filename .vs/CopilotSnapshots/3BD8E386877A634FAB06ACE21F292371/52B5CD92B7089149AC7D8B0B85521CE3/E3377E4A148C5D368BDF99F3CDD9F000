                article.PublishedAt = DateTime.Now;

                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Bài viết đã được đăng");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

