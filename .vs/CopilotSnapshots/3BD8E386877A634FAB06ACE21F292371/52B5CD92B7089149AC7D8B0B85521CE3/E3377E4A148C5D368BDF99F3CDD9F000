        public async Task<ServiceResult> DeleteUserAsync(int userId)
        {
            try
            {
                var user = await _context.Users
                    .Include(u => u.Articles)
                    .FirstOrDefaultAsync(u => u.UserId == userId);

                if (user == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy người dùng");
                }

                if (user.Articles.Any())
                {
                    return ServiceResult.CreateError("Không thể xóa người dùng có bài viết");
                }

                _context.Users.Remove(user);
                await _context.SaveChangesAsync();
                return ServiceResult.CreateSuccess("Đã xóa người dùng");
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

        public async Task<List<AdminMonthlyStatsViewModel>> GetMonthlyStatsAsync(int months = 12)
        {
            var stats = new List<AdminMonthlyStatsViewModel>();
            var startDate = DateTime.Now.AddMonths(-months);

            for (int i = 0; i < months; i++)
            {
                var monthStart = startDate.AddMonths(i);
                var monthEnd = monthStart.AddMonths(1);

                var articleCount = await _context.Articles
                    .CountAsync(a => a.CreatedAt >= monthStart && a.CreatedAt < monthEnd);

                var userCount = await _context.Users
                    .CountAsync(u => u.CreatedAt >= monthStart && u.CreatedAt < monthEnd);

                var viewCount = await _context.Articles
                    .Where(a => a.PublishedAt >= monthStart && a.PublishedAt < monthEnd)
                    .SumAsync(a => (int?)a.ViewCount) ?? 0;

                stats.Add(new AdminMonthlyStatsViewModel
                {
                    Month = monthStart.ToString("MM/yyyy"),
                    Articles = articleCount,
                    Users = userCount,
                    Views = viewCount
                });
            }

            return stats;
        }

        public async Task<Dictionary<string, int>> GetArticleStatusStatsAsync()
        {
            return await _context.Articles
                .Where(a => a.Status != null)
                .GroupBy(a => a.Status!)
                .ToDictionaryAsync(g => g.Key, g => g.Count());
        }

        public async Task<Dictionary<string, int>> GetUserRoleStatsAsync()
        {
            return await _context.Users
                .Include(u => u.Role)
                .GroupBy(u => u.Role.RoleName)
                .ToDictionaryAsync(g => g.Key, g => g.Count());
        }
