        public async Task<ServiceResult> ToggleFeaturedArticleAsync(int articleId)
        {
            try
            {
                var article = await _context.Articles.FindAsync(articleId);
                if (article == null)
                {
                    return ServiceResult.CreateError("Không tìm thấy bài viết");
                }

                article.IsFeatured = !article.IsFeatured;
                await _context.SaveChangesAsync();

                var message = article.IsFeatured ? "Đã đặt làm bài viết nổi bật" : "Đã bỏ khỏi bài viết nổi bật";
                return ServiceResult.CreateSuccess(message);
            }
            catch (Exception ex)
            {
                return ServiceResult.CreateError($"Lỗi: {ex.Message}");
            }
        }

        public async Task<AdminUsersViewModel> GetUsersAsync(string role, string search, int page, int pageSize = 20)
        {
            var query = _context.Users.AsQueryable();

            if (!string.IsNullOrEmpty(role))
            {
                query = query.Where(u => u.Role == role);
            }

            if (!string.IsNullOrEmpty(search))
            {
                query = query.Where(u => u.FullName.Contains(search) || u.Email.Contains(search));
            }

            var totalItems = await query.CountAsync();
            var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

            var users = await query
                .OrderByDescending(u => u.CreatedAt)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(u => new AdminUserListItemViewModel
                {
                    UserId = u.UserId,
                    FullName = u.FullName,
                    Email = u.Email,
                    Role = u.Role,
                    CreatedAt = u.CreatedAt,
                    LastLoginAt = u.LastLoginAt,
                    IsActive = u.IsActive,
                    IsBanned = u.IsBanned,
                    BanReason = u.BanReason,
                    ArticleCount = u.Articles.Count(),
                    Avatar = u.Avatar
                })
                .ToListAsync();

            return new AdminUsersViewModel
            {
                Items = users,
                CurrentPage = page,
                TotalPages = totalPages,
                TotalItems = totalItems,
                PageSize = pageSize,
                RoleFilter = role,
                SearchQuery = search
            };
        }

