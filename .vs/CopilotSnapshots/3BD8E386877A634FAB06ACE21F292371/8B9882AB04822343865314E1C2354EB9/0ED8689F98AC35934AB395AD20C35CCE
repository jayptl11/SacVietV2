        public async Task<List<AdminMonthlyStatsViewModel>> GetMonthlyStatsAsync(int months = 12)
        {
            var stats = new List<AdminMonthlyStatsViewModel>();
            var startDate = DateTime.Now.AddMonths(-months);

            for (int i = 0; i < months; i++)
            {
                var monthStart = startDate.AddMonths(i);
                var monthEnd = monthStart.AddMonths(1);

                var articleCount = await _context.Articles
                    .CountAsync(a => a.CreatedAt >= monthStart && a.CreatedAt < monthEnd);

                var userCount = await _context.Users
                    .CountAsync(u => u.CreatedAt >= monthStart && u.CreatedAt < monthEnd);

                var viewCount = await _context.Articles
                    .Where(a => a.PublishedAt >= monthStart && a.PublishedAt < monthEnd)
                    .SumAsync(a => a.ViewCount);

                stats.Add(new AdminMonthlyStatsViewModel
                {
                    Month = monthStart.ToString("MM/yyyy"),
                    Articles = articleCount,
                    Users = userCount,
                    Views = viewCount
                });
            }

            return stats;
        }

