@section Scripts {
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script>
        var canEdit = @(canEdit ? "true" : "false");
        
        // Initialize CKEditor (without Google Drive Video plugin)
        document.addEventListener('DOMContentLoaded', function() {
            CKEDITOR.replace('editor', {
                height: 450,
                filebrowserUploadUrl: '@Url.Action("UploadImage")',
                filebrowserUploadMethod: 'form',
                readOnly: !canEdit,
                toolbar: [
                    { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                    { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'Undo', 'Redo'] },
                    { name: 'editing', items: ['Find', 'Replace'] },
                    { name: 'forms', items: ['Checkbox', 'Radio', 'TextField', 'Textarea', 'Select', 'Button', 'ImageButton'] },
                    { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'RemoveFormat'] },
                    { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', 'CreateDiv'] },
                    { name: 'insert', items: ['Image', 'Table', 'HorizontalRule', 'SpecialChar'] },
                    { name: 'styles', items: ['Format', 'Font', 'FontSize'] },
                    { name: 'colors', items: ['TextColor', 'BGColor'] },
                    { name: 'tools', items: ['Maximize', 'ShowBlocks'] },
                    { name: 'about', items: ['About'] }
                ]
            });
        });

        renderTags();

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('form')?.addEventListener('submit', function(e) {
                for (var instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
            });
        });

        // Crawler functionality (only when canEdit)
        @if (canEdit)
        {
            <text>
            function startCrawl() {
                const urlInput = document.getElementById('crawl-url');
                const url = urlInput.value.trim();
                const statusDiv = document.getElementById('crawl-status');
                const btnCrawl = document.querySelector('.btn-crawl');

                if (!url) {
                    alert('Vui lòng nhập URL bài báo');
                    return;
                }

                // Show loading
                statusDiv.className = 'crawl-status loading';
                statusDiv.style.display = 'block';
                statusDiv.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lấy nội dung từ trang web...';
                btnCrawl.disabled = true;
                btnCrawl.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

                // Call API
                fetch('@Url.Action("CrawlUrl", "Writer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ url: url })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success
                        statusDiv.className = 'crawl-status success';
                        statusDiv.innerHTML = '<i class="fas fa-check-circle me-2"></i>Lấy nội dung thành công! Đang điền vào form...';

                        // Fill form with crawled data
                        if (data.title) {
                            document.querySelector('input[name="Title"]').value = data.title;
                        }

                        if (data.summary) {
                            document.querySelector('textarea[name="Summary"]').value = data.summary;
                        }

                        if (data.content) {
                            CKEDITOR.instances.editor.setData(data.content);
                        }

                        if (data.thumbnailUrl) {
                            document.getElementById('thumbnail-url').value = data.thumbnailUrl;
                            document.getElementById('thumbnail-img').src = data.thumbnailUrl;
                            document.getElementById('thumbnail-preview').style.display = 'block';
                            document.getElementById('thumbnail-upload').style.display = 'none';
                        }

                        // Add source URL as note in content
                        setTimeout(() => {
                            const currentContent = CKEDITOR.instances.editor.getData();
                            const sourceNote = `<hr><p><em><strong>Nguồn tham khảo:</strong> <a href="${data.sourceUrl}" target="_blank">${data.sourceUrl}</a></em></p>`;
                            CKEDITOR.instances.editor.setData(currentContent + sourceNote);
                        }, 500);

                        // Hide status after 3 seconds
                        setTimeout(() => {
                            statusDiv.style.display = 'none';
                        }, 3000);

                    } else {
                        // Show error
                        statusDiv.className = 'crawl-status error';
                        statusDiv.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i>' + (data.message || 'Không thể lấy nội dung');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    statusDiv.className = 'crawl-status error';
                    statusDiv.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i>Có lỗi xảy ra khi lấy nội dung';
                })
                .finally(() => {
                    btnCrawl.disabled = false;
                    btnCrawl.innerHTML = '<i class="fas fa-download me-2"></i>Lấy nội dung';
                });
            }
            </text>
        }
    </script>
}
