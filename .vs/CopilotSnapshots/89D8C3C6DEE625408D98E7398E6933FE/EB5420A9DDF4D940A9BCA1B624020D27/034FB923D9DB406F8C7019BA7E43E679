@model SacViet.ViewModels.ArticleEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    var categories = ViewBag.Categories as IEnumerable<SacViet.Models.Category>;
    var approval = ViewBag.ApprovalStatus as SacViet.Models.ArticleApproval;
    var canEdit = Model.Status == "Draft" || Model.Status == "Rejected";
}

<div class="edit-article-container">
    <!-- Page Header -->
    <div class="page-header-bar mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">
                    <i class="fas fa-edit text-primary me-2"></i>
                    Chỉnh sửa bài viết
                </h2>
                <p class="page-subtitle mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    @if (canEdit)
                    {
                        <span>Cập nhật nội dung bài viết của bạn</span>
                    }
                    else
                    {
                        <span>Xem chi tiết bài viết (chỉ đọc)</span>
                    }
                </p>
            </div>
            <div>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Status Alert -->
    @if (approval != null)
    {
        <div class="status-alert-card mb-4">
            @switch (approval.Status)
            {
                case "Pending":
                    <div class="status-alert status-pending">
                        <div class="status-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="status-content">
                            <h6>Đang chờ duyệt</h6>
                            <p>Bài viết đã được gửi lúc: @approval.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    break;
                case "Approved":
                    <div class="status-alert status-approved">
                        <div class="status-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="status-content">
                            <h6>Đã được duyệt</h6>
                            <p>Người duyệt: <strong>@approval.ReviewedByUser?.FullName</strong> • @approval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                            @if (!string.IsNullOrEmpty(approval.ReviewNote))
                            {
                                <p class="review-note">💬 @approval.ReviewNote</p>
                            }
                        </div>
                    </div>
                    break;
                case "Rejected":
                    <div class="status-alert status-rejected">
                        <div class="status-icon">
                            <i class="fas fa-times-circle"></i>
                        </div>
                        <div class="status-content">
                            <h6>Bị từ chối</h6>
                            <p>Người duyệt: <strong>@approval.ReviewedByUser?.FullName</strong> • @approval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                            @if (!string.IsNullOrEmpty(approval.ReviewNote))
                            {
                                <p class="review-note"><strong>Lý do:</strong> @approval.ReviewNote</p>
                            }
                            <p class="mb-0"><small>⚠️ Vui lòng chỉnh sửa theo yêu cầu và gửi lại</small></p>
                        </div>
                    </div>
                    break;
            }
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.ArticleId" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ArticleId" />
        <input type="hidden" asp-for="Slug" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="row g-4">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Crawler Card (only show when editing) -->
                @if (canEdit)
                {
                    <div class="crawler-card mb-4">
                        <div class="crawler-card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-magic text-danger me-2"></i>
                                <strong>Tự động lấy nội dung từ link</strong>
                            </h5>
                        </div>
                        <div class="crawler-card-body">
                            <div class="crawler-input-group">
                                <input type="url" id="crawl-url" class="form-control-crawler" 
                                       placeholder="Paste link bài báo vào đây (VD: https://example.com/bai-viet)..." />
                                <button type="button" class="btn-crawl" onclick="startCrawl()">
                                    <i class="fas fa-download me-2"></i>Lấy nội dung
                                </button>
                            </div>
                            <div id="crawl-status" class="crawl-status mt-3" style="display: none;"></div>
                            <div class="crawl-hint mt-2">
                                <i class="fas fa-info-circle text-primary me-2"></i>
                                <small>Hệ thống sẽ tự động lấy tiêu đề, nội dung, hình ảnh từ link bạn cung cấp.</small>
                            </div>
                            <div class="crawl-warning mt-2">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                <small><strong>Lưu ý:</strong> Chức năng này chỉ nên dùng để tham khảo. 
                                Hãy viết lại nội dung theo cách của bạn và ghi rõ nguồn.</small>
                            </div>
                        </div>
                    </div>
                }

                <!-- Content Card -->
                <div class="content-card mb-4">
                    <div class="content-card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-file-alt text-primary me-2"></i>
                            Nội dung bài viết
                            @if (!canEdit)
                            {
                                <span class="badge bg-secondary ms-2">Chỉ xem</span>
                            }
                        </h5>
                    </div>
                    <div class="content-card-body">
                        <!-- Title -->
                        <div class="form-group-modern mb-4">
                            <label asp-for="Title" class="form-label-modern">
                                <i class="fas fa-heading me-2"></i>Tiêu đề <span class="text-danger">*</span>
                            </label>
                            @if (canEdit)
                            {
                                <input asp-for="Title" class="form-control-modern" 
                                       placeholder="Nhập tiêu đề bài viết..." />
                            }
                            else
                            {
                                <input asp-for="Title" class="form-control-modern" 
                                       placeholder="Nhập tiêu đề bài viết..." readonly />
                            }
                            <span asp-validation-for="Title" class="validation-message"></span>
                        </div>

                        <!-- Summary -->
                        <div class="form-group-modern mb-4">
                            <label asp-for="Summary" class="form-label-modern">
                                <i class="fas fa-align-left me-2"></i>Tóm tắt
                            </label>
                            @if (canEdit)
                            {
                                <textarea asp-for="Summary" class="form-control-modern" rows="3"
                                          placeholder="Viết tóm tắt ngắn gọn..."></textarea>
                            }
                            else
                            {
                                <textarea asp-for="Summary" class="form-control-modern" rows="3"
                                          placeholder="Viết tóm tắt ngắn gọn..." readonly></textarea>
                            }
                            <span asp-validation-for="Summary" class="validation-message"></span>
                        </div>

                        <!-- Content -->
                        <div class="form-group-modern">
                            <label asp-for="Content" class="form-label-modern">
                                <i class="fas fa-paragraph me-2"></i>Nội dung <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Content" id="editor" class="form-control-modern"></textarea>
                            <span asp-validation-for="Content" class="validation-message"></span>
                        </div>
                    </div>
                </div>

                <!-- Article Info Card -->
                <div class="info-card">
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="fas fa-calendar-plus"></i>
                            <div>
                                <small>Tạo lúc</small>
                                <strong>@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-calendar-check"></i>
                            <div>
                                <small>Cập nhật</small>
                                <strong>@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</strong>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-link"></i>
                            <div>
                                <small>Slug</small>
                                <strong>@Model.Slug</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Status Card -->
                <div class="status-card mb-4">
                    <div class="status-card-header">
                        <h6 class="mb-0">Trạng thái</h6>
                    </div>
                    <div class="status-card-body">
                        @switch (Model.Status)
                        {
                            case "Draft":
                                <div class="status-badge-large status-draft">
                                    <i class="fas fa-edit"></i>
                                    <span>Nháp</span>
                                </div>
                                break;
                            case "Pending":
                                <div class="status-badge-large status-pending">
                                    <i class="fas fa-clock"></i>
                                    <span>Chờ duyệt</span>
                                </div>
                                break;
                            case "Published":
                                <div class="status-badge-large status-published">
                                    <i class="fas fa-check-circle"></i>
                                    <span>Đã đăng</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Slug))
                                {
                                    <a href="@Url.Action("Details", "Article", new { slug = Model.Slug })" 
                                       target="_blank" class="btn-view-article">
                                        <i class="fas fa-external-link-alt me-2"></i>Xem bài viết
                                    </a>
                                }
                                break;
                            case "Rejected":
                                <div class="status-badge-large status-rejected">
                                    <i class="fas fa-times-circle"></i>
                                    <span>Bị từ chối</span>
                                </div>
                                break;
                        }
                    </div>
                </div>

                <!-- Actions Card -->
                @if (canEdit)
                {
                    <div class="action-card mb-4">
                        <div class="action-card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-cog me-2"></i>Hành động
                            </h6>
                        </div>
                        <div class="action-card-body">
                            <button type="submit" name="action" value="submit" class="action-btn action-btn-primary">
                                <i class="fas fa-paper-plane"></i>
                                <div>
                                    <strong>Gửi để duyệt</strong>
                                    <small>Gửi cho Admin xét duyệt</small>
                                </div>
                            </button>
                            <button type="submit" name="action" value="draft" class="action-btn action-btn-secondary">
                                <i class="fas fa-save"></i>
                                <div>
                                    <strong>Lưu nháp</strong>
                                    <small>Lưu để chỉnh sửa sau</small>
                                </div>
                            </button>
                        </div>
                    </div>
                }

                <!-- Category Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-folder text-warning me-2"></i>Danh mục
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        @if (canEdit)
                        {
                            <select asp-for="CategoryId" class="form-select-modern">
                                <option value="">-- Chọn danh mục --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories.Where(c => c.ParentCategoryId == null))
                                    {
                                        <option value="@category.CategoryId">📁 @category.CategoryName</option>
                                        
                                        @foreach (var subCategory in categories.Where(c => c.ParentCategoryId == category.CategoryId))
                                        {
                                            <option value="@subCategory.CategoryId">  └─ @subCategory.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <select asp-for="CategoryId" class="form-select-modern" disabled>
                                <option value="">-- Chọn danh mục --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories.Where(c => c.ParentCategoryId == null))
                                    {
                                        <option value="@category.CategoryId">📁 @category.CategoryName</option>
                                        
                                        @foreach (var subCategory in categories.Where(c => c.ParentCategoryId == category.CategoryId))
                                        {
                                            <option value="@subCategory.CategoryId">  └─ @subCategory.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        }
                        <span asp-validation-for="CategoryId" class="validation-message"></span>
                    </div>
                </div>

                <!-- Thumbnail Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-image text-info me-2"></i>Ảnh đại diện
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        <div id="thumbnail-preview" class="thumbnail-preview" style="@(!string.IsNullOrEmpty(Model.ThumbnailImage) ? "" : "display: none;")">
                            <img id="thumbnail-img" src="@Model.ThumbnailImage" alt="Thumbnail" />
                            @if (canEdit)
                            {
                                <button type="button" class="btn-remove-thumbnail" onclick="removeThumbnail()">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                        </div>
                        <div id="thumbnail-upload" class="thumbnail-upload" style="@(string.IsNullOrEmpty(Model.ThumbnailImage) ? "" : "display: none;")">
                            @if (canEdit)
                            {
                                <div class="upload-area" onclick="document.getElementById('thumbnail-file').click()">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p>Chọn ảnh hoặc kéo thả</p>
                                    <small>JPG, PNG (Max 5MB)</small>
                                </div>
                                <input type="file" id="thumbnail-file" accept="image/*" style="display: none;" onchange="uploadThumbnail()" />
                            }
                            else
                            {
                                <p class="text-muted text-center">Không có ảnh</p>
                            }
                        </div>
                        <input type="hidden" asp-for="ThumbnailImage" id="thumbnail-url" />
                    </div>
                </div>

                <!-- Scheduled Publish Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-clock text-success me-2"></i>Hẹn giờ đăng
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        @if (canEdit)
                        {
                            <input asp-for="ScheduledPublishDate" type="datetime-local" 
                                   class="form-control-modern" />
                        }
                        else
                        {
                            <input asp-for="ScheduledPublishDate" type="datetime-local" 
                                   class="form-control-modern" readonly />
                        }
                        <small class="form-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Bài viết sẽ tự động đăng sau khi duyệt
                        </small>
                    </div>
                </div>

                <!-- Tags Card -->
                <div class="sidebar-card">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-tags text-danger me-2"></i>Thẻ Tags
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        @if (canEdit)
                        {
                            <input type="text" id="tags-input" class="form-control-modern" 
                                   placeholder="Nhập tag và nhấn Enter..." />
                        }
                        <div id="tags-container" class="tags-container mt-3"></div>
                        @if (canEdit)
                        {
                            <small class="form-hint">
                                <i class="fas fa-keyboard me-1"></i>
                                Nhấn Enter để thêm tag
                            </small>
                        }
                    </div>
                </div>

                <!-- Approval History Link -->
                @if (approval != null)
                {
                    <div class="mt-4">
                        <a href="@Url.Action("ApprovalHistory", new { articleId = Model.ArticleId })" 
                           class="btn btn-outline-info w-100">
                            <i class="fas fa-history me-2"></i>Xem lịch sử duyệt
                        </a>
                    </div>
                }
            </div>
        </div>

        @Html.AntiForgeryToken()
    </form>
</div>

<style>
    .edit-article-container {
        padding: 1.5rem;
        background: #f8f9fa;
        min-height: 100vh;
    }

    /* Copy styles from Create.cshtml */
    .page-header-bar {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #6c757d;
        font-size: 0.95rem;
    }

    /* Status Alert */
    .status-alert-card {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .status-alert {
        display: flex;
        align-items: start;
        gap: 1.25rem;
        padding: 1.5rem;
    }

    .status-alert.status-pending {
        background: linear-gradient(135deg, #fff9e6 0%, #ffffff 100%);
        border-left: 4px solid #ffc107;
    }

    .status-alert.status-approved {
        background: linear-gradient(135deg, #e7f7ef 0%, #ffffff 100%);
        border-left: 4px solid #198754;
    }

    .status-alert.status-rejected {
        background: linear-gradient(135deg, #ffe6e6 0%, #ffffff 100%);
        border-left: 4px solid #dc3545;
    }

    .status-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .status-pending .status-icon {
        background: #ffc107;
        color: white;
    }

    .status-approved .status-icon {
        background: #198754;
        color: white;
    }

    .status-rejected .status-icon {
        background: #dc3545;
        color: white;
    }

    .status-content h6 {
        font-size: 1.125rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .status-content p {
        font-size: 0.95rem;
        color: #6c757d;
        margin-bottom: 0.5rem;
    }

    .status-content p:last-child {
        margin-bottom: 0;
    }

    .review-note {
        padding: 0.75rem;
        background: white;
        border-radius: 8px;
        font-size: 0.9rem !important;
        margin-top: 0.75rem !important;
    }

    /* Info Card */
    .info-card {
        background: white;
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .info-item {
        display: flex;
        align-items: start;
        gap: 0.75rem;
    }

    .info-item i {
        font-size: 1.25rem;
        color: #0d6efd;
        margin-top: 0.25rem;
    }

    .info-item small {
        display: block;
        font-size: 0.8rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .info-item strong {
        display: block;
        font-size: 0.9rem;
        color: #2c3e50;
    }

    /* Status Card */
    .status-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .status-card-header {
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
        background: #f8f9fa;
    }

    .status-card-header h6 {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .status-card-body {
        padding: 1.5rem;
        text-align: center;
    }

    .status-badge-large {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        font-size: 1.125rem;
        font-weight: 600;
    }

    .status-badge-large i {
        font-size: 1.5rem;
    }

    .status-draft {
        background: #e9ecef;
        color: #6c757d;
    }

    .status-pending {
        background: #fff3cd;
        color: #997404;
    }

    .status-published {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-rejected {
        background: #f8d7da;
        color: #842029;
    }

    .btn-view-article {
        display: block;
        margin-top: 1rem;
        padding: 0.75rem;
        background: #e7f1ff;
        border: 2px solid #0d6efd;
        color: #0d6efd;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-view-article:hover {
        background: #0d6efd;
        color: white;
    }

    /* Copy remaining styles from Create.cshtml */
    /* Content Card, Form, Actions, Sidebar, etc. */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .content-card-header {
        padding: 1.25rem;
        border-bottom: 1px solid #e9ecef;
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }

    .content-card-header h5 {
        font-size: 1.125rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .content-card-body {
        padding: 1.5rem;
    }

    .form-group-modern {
        margin-bottom: 1.5rem;
    }

    .form-label-modern {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s;
        width: 100%;
    }

    .form-control-modern:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
        outline: none;
    }

    .form-control-modern:read-only {
        background: #f8f9fa;
        cursor: not-allowed;
    }

    .form-select-modern {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s;
        width: 100%;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 16px 12px;
