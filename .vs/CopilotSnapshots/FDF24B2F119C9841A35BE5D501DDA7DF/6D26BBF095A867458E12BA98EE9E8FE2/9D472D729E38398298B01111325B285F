@model AdminUsersViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="admin-users-container">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">
                    <i class="fas fa-users text-primary me-2"></i>
                    Quản lý người dùng
                </h2>
                <p class="page-subtitle">
                    <i class="fas fa-database me-2"></i>
                    Tổng cộng <strong>@Model.TotalItems</strong> người dùng
                </p>
            </div>
            <div>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="filter-card mb-4">
        <form method="get" class="row g-3">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">
                    <i class="fas fa-user-tag me-1"></i>Vai trò
                </label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">👥 Tất cả</option>
                    @if (Model.RoleFilter == "User")
                    {
                        <option value="User" selected>👤 Người dùng</option>
                    }
                    else
                    {
                        <option value="User">👤 Người dùng</option>
                    }
                    @if (Model.RoleFilter == "Writer")
                    {
                        <option value="Writer" selected>✍️ Tác giả</option>
                    }
                    else
                    {
                        <option value="Writer">✍️ Tác giả</option>
                    }
                    @if (Model.RoleFilter == "Admin")
                    {
                        <option value="Admin" selected>👑 Quản trị viên</option>
                    }
                    else
                    {
                        <option value="Admin">👑 Quản trị viên</option>
                    }
                </select>
            </div>
            <div class="col-lg-7 col-md-6">
                <label class="form-label">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </label>
                <input type="text" name="search" class="form-control form-control-sm" 
                       placeholder="Nhập tên hoặc email..." value="@Model.SearchQuery">
            </div>
            <div class="col-lg-2 col-md-12">
                <label class="form-label d-none d-md-block">&nbsp;</label>
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    <!-- Users Grid -->
    @if (Model.Items.Any())
    {
        <div class="users-grid">
            @foreach (var user in Model.Items)
            {
                <div class="user-card @(user.IsBanned ? "user-banned" : "")" id="user-@user.UserId">
                    <div class="user-header">
                        <div class="user-avatar-large">
                            @if (!string.IsNullOrEmpty(user.Avatar))
                            {
                                <img src="@user.Avatar" alt="@user.FullName">
                            }
                            else
                            {
                                <div class="avatar-placeholder">
                                    @user.FullName.Substring(0, 1).ToUpper()
                                </div>
                            }
                        </div>
                        
                        <div class="user-role-badge">
                            @if (user.Role == "Admin")
                            {
                                <span class="role-badge role-admin">
                                    <i class="fas fa-crown"></i>Admin
                                </span>
                            }
                            else if (user.Role == "Writer")
                            {
                                <span class="role-badge role-writer">
                                    <i class="fas fa-pen"></i>Tác giả
                                </span>
                            }
                            else
                            {
                                <span class="role-badge role-user">
                                    <i class="fas fa-user"></i>User
                                </span>
                            }
                        </div>
                    </div>

                    <div class="user-body">
                        <h5 class="user-name">@user.FullName</h5>
                        <p class="user-email">
                            <i class="fas fa-envelope"></i>
                            @user.Email
                        </p>

                        <div class="user-stats-grid">
                            <div class="stat-box">
                                <i class="fas fa-newspaper"></i>
                                <div>
                                    <strong>@user.ArticleCount</strong>
                                    <small>Bài viết</small>
                                </div>
                            </div>
                            <div class="stat-box">
                                <i class="fas fa-calendar"></i>
                                <div>
                                    <strong>@user.CreatedAt.ToString("dd/MM/yy")</strong>
                                    <small>Ngày tham gia</small>
                                </div>
                            </div>
                        </div>

                        @if (user.LastLoginAt.HasValue)
                        {
                            <div class="last-login">
                                <i class="fas fa-clock"></i>
                                <small>Lần cuối: @user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        }

                        @if (user.IsBanned)
                        {
                            <div class="ban-info">
                                <i class="fas fa-ban"></i>
                                <div>
                                    <strong>Tài khoản bị khóa</strong>
                                    @if (!string.IsNullOrEmpty(user.BanReason))
                                    {
                                        <small>@user.BanReason</small>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="status-badge">
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-active">
                                        <i class="fas fa-check-circle"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">
                                        <i class="fas fa-pause-circle"></i>Tạm dừng
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="user-actions">
                        <div class="dropdown w-100">
                            <button class="btn-action-dropdown dropdown-toggle" type="button" 
                                    data-bs-toggle="dropdown">
                                <i class="fas fa-cog me-2"></i>Thao tác
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end w-100">
                                <li class="dropdown-header">
                                    <i class="fas fa-user-tag me-1"></i>Vai trò
                                </li>
                                @if (user.Role != "User")
                                {
                                    <li>
                                        <a class="dropdown-item" href="#" 
                                           onclick="updateUserRole(@user.UserId, 'User')">
                                            <i class="fas fa-user me-2"></i>Đặt làm người dùng
                                        </a>
                                    </li>
                                }
                                @if (user.Role != "Writer")
                                {
                                    <li>
                                        <a class="dropdown-item" href="#" 
                                           onclick="updateUserRole(@user.UserId, 'Writer')">
                                            <i class="fas fa-pen me-2"></i>Đặt làm tác giả
                                        </a>
                                    </li>
                                }
                                @if (user.Role != "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item text-warning" href="#" 
                                           onclick="updateUserRole(@user.UserId, 'Admin')">
                                            <i class="fas fa-crown me-2"></i>Đặt làm Admin
                                        </a>
                                    </li>
                                }
                                
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header">
                                    <i class="fas fa-shield-alt me-1"></i>Trạng thái
                                </li>
                                
                                @if (user.IsBanned)
                                {
                                    <li>
                                        <a class="dropdown-item text-success" href="#" 
                                           onclick="unbanUser(@user.UserId)">
                                            <i class="fas fa-unlock me-2"></i>Mở khóa
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" 
                                           onclick="banUser(@user.UserId)">
                                            <i class="fas fa-ban me-2"></i>Khóa tài khoản
                                        </a>
                                    </li>
                                }
                                
                                @if (user.ArticleCount == 0)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" 
                                           onclick="deleteUser(@user.UserId)">
                                            <i class="fas fa-trash me-2"></i>Xóa tài khoản
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-nav mt-4">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Users", new { role = Model.RoleFilter, search = Model.SearchQuery, page = Model.CurrentPage - 1 })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Users", new { role = Model.RoleFilter, search = Model.SearchQuery, page = i })">
                                @i
                            </a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Users", new { role = Model.RoleFilter, search = Model.SearchQuery, page = Model.CurrentPage + 1 })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="empty-state-card">
            <i class="fas fa-users"></i>
            <h5>Không tìm thấy người dùng nào</h5>
            <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm</p>
        </div>
    }
</div>

<!-- Ban Modal -->
<div class="modal fade" id="banModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-ban text-danger me-2"></i>
                    Khóa tài khoản
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Lý do khóa tài khoản <span class="text-danger">*</span></label>
                    <textarea id="banReason" class="form-control" rows="4" 
                              placeholder="Nhập lý do khóa tài khoản..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmBan()">
                    <i class="fas fa-check me-1"></i>Khóa tài khoản
                </button>
            </div>
        </div>
    </div>
</div>

