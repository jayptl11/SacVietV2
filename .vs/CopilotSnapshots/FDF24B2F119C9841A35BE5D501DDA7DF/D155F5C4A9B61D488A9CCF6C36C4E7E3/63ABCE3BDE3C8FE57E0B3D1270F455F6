@model SacViet.ViewModels.ArticleEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    var categories = ViewBag.Categories as IEnumerable<SacViet.Models.Category>;
    var approval = ViewBag.ApprovalStatus as SacViet.Models.ArticleApproval;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12 mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <h2 class="text-danger mb-0">
                    <i class="fas fa-edit me-2"></i>Chỉnh sửa bài viết
                </h2>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Approval Status Alert -->
    @if (approval != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                @switch (approval.Status)
                {
                    case "Pending":
                        <div class="alert alert-warning alert-dismissible fade show">
                            <i class="fas fa-clock me-2"></i>
                            <strong>Đang chờ duyệt</strong>
                            <p class="mb-0 mt-2">Bài viết đã được gửi lúc: @approval.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        break;
                    case "Approved":
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Đã được duyệt</strong>
                            <p class="mb-0 mt-2">
                                Người duyệt: @approval.ReviewedByUser?.FullName<br/>
                                Thời gian: @approval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @if (!string.IsNullOrEmpty(approval.ReviewNote))
                            {
                                <p class="mb-0 mt-2">
                                    <strong>Ghi chú:</strong> @approval.ReviewNote
                                </p>
                            }
                        </div>
                        break;
                    case "Rejected":
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-times-circle me-2"></i>
                            <strong>Bị từ chối</strong>
                            <p class="mb-0 mt-2">
                                Người duyệt: @approval.ReviewedByUser?.FullName<br/>
                                Thời gian: @approval.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @if (!string.IsNullOrEmpty(approval.ReviewNote))
                            {
                                <p class="mb-0 mt-2">
                                    <strong>Lý do từ chối:</strong> @approval.ReviewNote
                                </p>
                            }
                            <p class="mb-0 mt-2 small">
                                <i class="fas fa-info-circle me-1"></i>
                                Vui lòng chỉnh sửa bài viết theo yêu cầu và gửi lại để duyệt.
                            </p>
                        </div>
                        break;
                }
            </div>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.ArticleId" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ArticleId" />
        <input type="hidden" asp-for="Slug" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Nội dung bài viết</h5>
                    </div>
                    <div class="card-body">
                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">
                                Tiêu đề <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg" 
                                   placeholder="Nhập tiêu đề bài viết..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Summary -->
                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label fw-bold">Tóm tắt</label>
                            <textarea asp-for="Summary" class="form-control" rows="3"
                                      placeholder="Nhập tóm tắt ngắn gọn về bài viết..."></textarea>
                            <span asp-validation-for="Summary" class="text-danger small"></span>
                        </div>

                        <!-- Content -->
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">
                                Nội dung <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Content" id="editor" class="form-control" rows="15"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Article Info -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <small class="text-muted">
                                    <i class="fas fa-calendar-plus me-1"></i>
                                    <strong>Tạo lúc:</strong><br/>
                                    @Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">
                                    <i class="fas fa-calendar-check me-1"></i>
                                    <strong>Cập nhật:</strong><br/>
                                    @Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">
                                    <i class="fas fa-link me-1"></i>
                                    <strong>Slug:</strong><br/>
                                    @Model.Slug
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Actions -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Hành động</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == "Draft" || Model.Status == "Rejected")
                        {
                            <div class="d-grid gap-2">
                                <button type="submit" name="action" value="draft" class="btn btn-outline-secondary">
                                    <i class="fas fa-save me-2"></i>Lưu nháp
                                </button>
                                <button type="submit" name="action" value="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-2"></i>Gửi để duyệt
                                </button>
                            </div>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                Bài viết đang chờ duyệt. Bạn không thể chỉnh sửa lúc này.
                            </div>
                        }
                        else if (Model.Status == "Published")
                        {
                            <div class="alert alert-success mb-0">
                                <i class="fas fa-check-circle me-2"></i>
                                Bài viết đã được đăng.
                            </div>
                            <a href="@Url.Action("Details", "Article", new { slug = Model.Slug })" 
                               target="_blank" class="btn btn-outline-info w-100 mt-2">
                                <i class="fas fa-eye me-2"></i>Xem bài viết
                            </a>
                        }
                    </div>
                </div>

                <!-- Status Badge -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center">
                        <h6 class="mb-3">Trạng thái hiện tại</h6>
                        @switch (Model.Status)
                        {
                            case "Draft":
                                <span class="badge bg-secondary fs-6 px-4 py-2">
                                    <i class="fas fa-file-alt me-2"></i>Nháp
                                </span>
                                break;
                            case "Pending":
                                <span class="badge bg-warning fs-6 px-4 py-2">
                                    <i class="fas fa-clock me-2"></i>Chờ duyệt
                                </span>
                                break;
                            case "Published":
                                <span class="badge bg-success fs-6 px-4 py-2">
                                    <i class="fas fa-check-circle me-2"></i>Đã đăng
                                </span>
                                break;
                            case "Rejected":
                                <span class="badge bg-danger fs-6 px-4 py-2">
                                    <i class="fas fa-times-circle me-2"></i>Bị từ chối
                                </span>
                                break;
                        }
                    </div>
                </div>

                <!-- Category -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Danh mục</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == "Pending" || Model.Status == "Published")
                        {
                            <select asp-for="CategoryId" class="form-select" disabled>
                                <option value="">-- Chọn danh mục --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories.Where(c => c.ParentCategoryId == null))
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                        
                                        @foreach (var subCategory in categories.Where(c => c.ParentCategoryId == category.CategoryId))
                                        {
                                            <option value="@subCategory.CategoryId">  └─ @subCategory.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories.Where(c => c.ParentCategoryId == null))
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                        
                                        @foreach (var subCategory in categories.Where(c => c.ParentCategoryId == category.CategoryId))
                                        {
                                            <option value="@subCategory.CategoryId">  └─ @subCategory.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        }
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Thumbnail -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Ảnh đại diện</h6>
                    </div>
                    <div class="card-body">
                        <div id="thumbnail-preview" style="@(!string.IsNullOrEmpty(Model.ThumbnailImage) ? "" : "display: none;")">
                            <img id="thumbnail-img" src="@Model.ThumbnailImage" class="img-fluid rounded" alt="Thumbnail" />
                            @if (Model.Status == "Pending" || Model.Status == "Published")
                            {
                                <button type="button" class="btn btn-sm btn-danger mt-2 w-100" onclick="removeThumbnail()" disabled>
                                    <i class="fas fa-trash me-1"></i>Xóa ảnh
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-danger mt-2 w-100" onclick="removeThumbnail()">
                                    <i class="fas fa-trash me-1"></i>Xóa ảnh
                                </button>
                            }
                        </div>
                        <div id="thumbnail-upload" style="@(string.IsNullOrEmpty(Model.ThumbnailImage) ? "" : "display: none;")">
                            @if (Model.Status == "Pending" || Model.Status == "Published")
                            {
                                <input type="file" id="thumbnail-file" class="form-control mb-2" accept="image/*" disabled />
                                <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="uploadThumbnail()" disabled>
                                    <i class="fas fa-upload me-1"></i>Tải ảnh lên
                                </button>
                            }
                            else
                            {
                                <input type="file" id="thumbnail-file" class="form-control mb-2" accept="image/*" />
                                <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="uploadThumbnail()">
                                    <i class="fas fa-upload me-1"></i>Tải ảnh lên
                                </button>
                            }
                        </div>
                        <input type="hidden" asp-for="ThumbnailImage" id="thumbnail-url" />
                    </div>
                </div>

                <!-- Scheduled Publish -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Hẹn giờ đăng bài</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == "Pending" || Model.Status == "Published")
                        {
                            <input asp-for="ScheduledPublishDate" type="datetime-local" class="form-control" disabled />
                        }
                        else
                        {
                            <input asp-for="ScheduledPublishDate" type="datetime-local" class="form-control" />
                        }
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle me-1"></i>
                            Bài viết sẽ tự động đăng vào thời điểm này sau khi được duyệt.
                        </small>
                    </div>
                </div>

                <!-- Tags -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Thẻ (Tags)</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == "Pending" || Model.Status == "Published")
                        {
                            <input type="text" id="tags-input" class="form-control" 
                                   placeholder="Nhập tag và nhấn Enter..." disabled />
                        }
                        else
                        {
                            <input type="text" id="tags-input" class="form-control" 
                                   placeholder="Nhập tag và nhấn Enter..." />
                        }
                        <div id="tags-container" class="mt-2"></div>
                    </div>
                </div>

                <!-- Approval History Link -->
                @if (approval != null)
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body text-center">
                            <a href="@Url.Action("ApprovalHistory", new { articleId = Model.ArticleId })" 
                               class="btn btn-outline-secondary w-100">
                                <i class="fas fa-history me-2"></i>Xem lịch sử duyệt
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script>
        // Initialize CKEditor
        CKEDITOR.replace('editor', {
            height: 400,
            filebrowserUploadUrl: '@Url.Action("UploadImage")',
            filebrowserUploadMethod: 'form',
            readOnly: @((Model.Status == "Pending" || Model.Status == "Published") ? "true" : "false")
        });

        // Thumbnail upload
        function uploadThumbnail() {
            const fileInput = document.getElementById('thumbnail-file');
            const file = fileInput.files[0];

            if (!file) {
                alert('Vui lòng chọn file ảnh');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            fetch('@Url.Action("UploadImage")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('thumbnail-url').value = data.url;
                    document.getElementById('thumbnail-img').src = data.url;
                    document.getElementById('thumbnail-preview').style.display = 'block';
                    document.getElementById('thumbnail-upload').style.display = 'none';
                } else {
                    alert(data.message || 'Upload thất bại');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi upload ảnh');
            });
        }

        function removeThumbnail() {
            document.getElementById('thumbnail-url').value = '';
            document.getElementById('thumbnail-img').src = '';
            document.getElementById('thumbnail-preview').style.display = 'none';
            document.getElementById('thumbnail-upload').style.display = 'block';
            document.getElementById('thumbnail-file').value = '';
        }

        // Tags management
        let tags = @Html.Raw(Json.Serialize(Model.Tags ?? new List<string>()));
        const tagsInput = document.getElementById('tags-input');
        const tagsContainer = document.getElementById('tags-container');

        tagsInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const tag = this.value.trim();
                if (tag && !tags.includes(tag)) {
                    tags.push(tag);
                    renderTags();
                    this.value = '';
                }
            }
        });

        function renderTags() {
            tagsContainer.innerHTML = '';
            const isDisabled = '@Model.Status' === 'Pending' || '@Model.Status' === 'Published';
            
            tags.forEach((tag, index) => {
                const badge = document.createElement('span');
                badge.className = 'badge bg-primary me-1 mb-1';
                badge.innerHTML = `
                    ${tag}
                    ${!isDisabled ? `<i class="fas fa-times ms-1" style="cursor: pointer;" onclick="removeTag(${index})"></i>` : ''}
                    <input type="hidden" name="Tags" value="${tag}" />
                `;
                tagsContainer.appendChild(badge);
            });
        }

        function removeTag(index) {
            tags.splice(index, 1);
            renderTags();
        }

        // Initial render
        renderTags();

        // Form validation
        document.querySelector('form')?.addEventListener('submit', function(e) {
            for (var instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }
        });
    </script>
}
