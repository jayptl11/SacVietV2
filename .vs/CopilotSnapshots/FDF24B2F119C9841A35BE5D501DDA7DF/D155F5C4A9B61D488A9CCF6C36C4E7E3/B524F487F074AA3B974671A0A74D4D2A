@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-container">
    <!-- Welcome Header -->
    <div class="welcome-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1">
                    <i class="fas fa-tachometer-alt text-danger me-2"></i>
                    Chào mừng, Admin!
                </h2>
                <p class="text-muted mb-0">
                    <i class="far fa-calendar-alt me-2"></i>
                    @DateTime.Now.ToString("dddd, dd/MM/yyyy")
                </p>
            </div>
            <div class="text-end">
                <small class="text-muted d-block">Hệ thống quản lý nội dung</small>
                <strong class="text-danger">SacViet CMS</strong>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Articles -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-primary">
                <div class="stat-icon">
                    <i class="fas fa-newspaper"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Tổng bài viết</div>
                    <div class="stat-value">@Model.TotalArticles.ToString("N0")</div>
                </div>
                <div class="stat-footer">
                    <a href="@Url.Action("Articles", "Admin")" class="stat-link">
                        Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Pending Articles -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-warning">
                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Chờ duyệt</div>
                    <div class="stat-value">@Model.PendingArticles.ToString("N0")</div>
                </div>
                <div class="stat-footer">
                    <a href="@Url.Action("Articles", "Admin", new { status = "Pending" })" class="stat-link">
                        Duyệt ngay <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Users -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-success">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Người dùng</div>
                    <div class="stat-value">@Model.TotalUsers.ToString("N0")</div>
                </div>
                <div class="stat-footer">
                    <a href="@Url.Action("Users", "Admin")" class="stat-link">
                        Quản lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Views -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-card-info">
                <div class="stat-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Lượt xem</div>
                    <div class="stat-value">@Model.TotalViews.ToString("N0")</div>
                </div>
                <div class="stat-footer">
                    <span class="stat-link text-muted">
                        <i class="fas fa-chart-line me-1"></i>Tổng số
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-3">
        <!-- Left Column -->
        <div class="col-lg-8">
            <!-- Recent Articles -->
            <div class="content-card mb-3">
                <div class="content-card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-newspaper text-primary me-2"></i>
                            Bài viết mới nhất
                        </h5>
                        <a href="@Url.Action("Articles", "Admin")" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-list me-1"></i>Tất cả
                        </a>
                    </div>
                </div>
                <div class="content-card-body p-0">
                    @if (Model.RecentArticles.Any())
                    {
                        <div class="article-list">
                            @foreach (var article in Model.RecentArticles)
                            {
                                <div class="article-item">
                                    <div class="article-content">
                                        <h6 class="article-title mb-1">@article.Title</h6>
                                        <div class="article-meta">
                                            <span class="meta-item">
                                                <i class="fas fa-user"></i>
                                                @article.AuthorName
                                            </span>
                                            <span class="meta-item">
                                                <i class="fas fa-calendar"></i>
                                                @article.CreatedAt.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="article-status">
                                        @switch (article.Status)
                                        {
                                            case "Draft":
                                                <span class="status-badge status-draft">
                                                    <i class="fas fa-edit"></i>Nháp
                                                </span>
                                                break;
                                            case "Pending":
                                                <span class="status-badge status-pending">
                                                    <i class="fas fa-clock"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case "Published":
                                                <span class="status-badge status-published">
                                                    <i class="fas fa-check"></i>Đã đăng
                                                </span>
                                                break;
                                            case "Rejected":
                                                <span class="status-badge status-rejected">
                                                    <i class="fas fa-times"></i>Từ chối
                                                </span>
                                                break;
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>Chưa có bài viết nào</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Monthly Stats Chart -->
            <div class="content-card">
                <div class="content-card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-line text-success me-2"></i>
                        Thống kê theo tháng
                    </h5>
                </div>
                <div class="content-card-body">
                    <canvas id="monthlyChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="content-card mb-3">
                <div class="content-card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt text-warning me-2"></i>
                        Thao tác nhanh
                    </h5>
                </div>
                <div class="content-card-body">
                    <div class="quick-actions">
                        <a href="@Url.Action("Articles", "Admin", new { status = "Pending" })" class="quick-action-btn btn-warning">
                            <i class="fas fa-clock"></i>
                            <div>
                                <strong>Duyệt bài viết</strong>
                                @if (Model.PendingArticles > 0)
                                {
                                    <span class="action-badge">@Model.PendingArticles</span>
                                }
                            </div>
                        </a>
                        <a href="@Url.Action("Articles", "Admin")" class="quick-action-btn btn-primary">
                            <i class="fas fa-newspaper"></i>
                            <div>
                                <strong>Quản lý bài viết</strong>
                            </div>
                        </a>
                        <a href="@Url.Action("Users", "Admin")" class="quick-action-btn btn-success">
                            <i class="fas fa-users"></i>
                            <div>
                                <strong>Quản lý người dùng</strong>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Top Articles -->
            <div class="content-card mb-3">
                <div class="content-card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-fire text-danger me-2"></i>
                        Top bài viết
                    </h5>
                </div>
                <div class="content-card-body p-0">
                    @if (Model.TopArticles.Any())
                    {
                        <div class="top-list">
                            @for (int i = 0; i < Model.TopArticles.Count && i < 5; i++)
                            {
                                var article = Model.TopArticles[i];
                                <div class="top-item">
                                    <div class="top-rank rank-@(i + 1)">@(i + 1)</div>
                                    <div class="top-content">
                                        <h6 class="top-title">@article.Title</h6>
                                        <div class="top-meta">
                                            <i class="fas fa-eye"></i>
                                            @article.ViewCount.ToString("N0") lượt xem
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state small">
                            <i class="fas fa-chart-line"></i>
                            <p>Chưa có dữ liệu</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Users -->
            <div class="content-card">
                <div class="content-card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-user-plus text-info me-2"></i>
                            Người dùng mới
                        </h5>
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-sm btn-outline-info">
                            <i class="fas fa-list me-1"></i>Tất cả
                        </a>
                    </div>
                </div>
                <div class="content-card-body p-0">
                    @if (Model.RecentUsers.Any())
                    {
                        <div class="user-list">
                            @foreach (var user in Model.RecentUsers.Take(5))
                            {
                                <div class="user-item">
                                    <div class="user-avatar">
                                        @user.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="user-info">
                                        <h6 class="user-name">@user.FullName</h6>
                                        <div class="user-email">@user.Email</div>
                                    </div>
                                    <div class="user-role">
                                        <span class="role-badge role-@user.Role.ToLower()">
                                            @user.Role
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state small">
                            <i class="fas fa-users"></i>
                            <p>Chưa có người dùng mới</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

