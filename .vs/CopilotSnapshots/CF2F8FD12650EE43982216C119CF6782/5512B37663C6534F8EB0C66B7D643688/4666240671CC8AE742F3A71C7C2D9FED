@* Partial View: Action Buttons *@
@{
    var isEditMode = ViewContext.ViewData["isEditMode"] as bool? ?? false;
    var isAdminPublishedEdit = ViewContext.ViewData["isAdminPublishedEdit"] as bool? ?? false;
}

<div class="action-card mb-4">
    <div class="action-card-header">
        <h6 class="mb-0">
            <i class="fas fa-cog me-2"></i>Hành động
        </h6>
    </div>
    <div class="action-card-body">
        <!-- Hidden field to ensure submitAction is always posted, even on Enter key -->
        <input type="hidden" name="submitAction" id="submitActionInput" value="draft" />

        @if (!isAdminPublishedEdit)
        {
            <button type="submit" name="submitAction" value="submit" class="action-btn action-btn-primary"
                    onclick="var i=document.getElementById('submitActionInput'); if(i) i.value='submit';">
                <i class="fas fa-paper-plane"></i>
                <div>
                    <strong>Gửi để duyệt</strong>
                    <small>Gửi cho Admin xét duyệt</small>
                </div>
            </button>
        }
        <button type="submit" name="submitAction" value="draft" class="action-btn action-btn-secondary"
                onclick="var i=document.getElementById('submitActionInput'); if(i) i.value='draft';">
            <i class="fas fa-save"></i>
            <div>
                <strong>@(isAdminPublishedEdit ? "Lưu cập nhật" : "Lưu nháp")</strong>
                <small>@(isAdminPublishedEdit ? "Lưu thay đổi trực tiếp" : "Lưu để chỉnh sửa sau")</small>
            </div>
        </button>
    </div>
</div>
