// Convert Google Drive share link to direct link
function convertGoogleDriveUrl(url) {
    // Example input formats:
    // 1. https://drive.google.com/file/d/FILE_ID/view?usp=sharing
    // 2. https://drive.google.com/open?id=FILE_ID
    // 3. https://drive.google.com/uc?id=FILE_ID&export=download (already direct)

    // Extract FILE_ID from various formats
    let fileId = null;

    // Format 1: /file/d/FILE_ID/
    const match1 = url.match(/\/file\/d\/([^\/\?]+)/);
    if (match1) {
        fileId = match1[1];
    }

    // Format 2: ?id=FILE_ID or &id=FILE_ID
    if (!fileId) {
        const match2 = url.match(/[?&]id=([^&]+)/);
        if (match2) {
            fileId = match2[1];
        }
    }

    // If we found FILE_ID, convert to direct download link
    if (fileId) {
        // IMPORTANT: For audio/video, use 'preview' mode instead of 'download'
        // This allows inline playback without forcing download
        return `https://drive.google.com/uc?export=open&id=${fileId}`;
    }

    // If can't extract ID or already in correct format, return as-is
    return url;
}

// === THUMBNAIL VALIDATION FOR SUBMIT ===
function initThumbnailValidation() {
    const form = document.querySelector('form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        // Check which button was clicked
        const submitter = e.submitter;
        if (!submitter) return;

        const action = submitter.value;

        // Only validate thumbnail for "submit" action, not "draft"
        if (action === 'submit') {
            const thumbnailUrl = document.getElementById('thumbnail-url')?.value;

            if (!thumbnailUrl || thumbnailUrl.trim() === '') {
                e.preventDefault();

                // Show error alert
                showThumbnailError();

                // Scroll to thumbnail section
                scrollToThumbnail();

                console.error('❌ Validation failed: Thumbnail required for submit');
                return false;
            }
        }

        console.log('✅ Validation passed for action:', action);
    });
}

// Show thumbnail error with visual feedback
function showThumbnailError() {
    // Show alert dialog
    alert('⚠️ Vui lòng chọn ảnh đại diện trước khi gửi duyệt!\n\n' +
        'Bạn có thể:\n' +
        '• Upload ảnh từ máy tính\n' +
        '• Dán URL ảnh\n' +
        '• Hoặc lưu nháp để thêm ảnh sau');

    // Show error banner
    const thumbnailCard = document.getElementById('thumbnail-card');
    if (thumbnailCard) {
        // Create error banner if not exists
        let errorBanner = thumbnailCard.querySelector('.thumbnail-error-banner');
        if (!errorBanner) {
            errorBanner = document.createElement('div');
            errorBanner.className = 'thumbnail-error-banner';
            errorBanner.innerHTML = `
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Bắt buộc:</strong> Vui lòng chọn ảnh đại diện để gửi duyệt
                <button type="button" class="btn-close-banner" onclick="closeThumbnailError()">
                    <i class="fas fa-times"></i>
                </button>
            `;
            thumbnailCard.insertBefore(errorBanner, thumbnailCard.firstChild);
        }

        // Show banner with animation
        errorBanner.style.display = 'flex';
        errorBanner.classList.add('shake-animation');

        // Remove shake animation after it completes
        setTimeout(() => {
            errorBanner.classList.remove('shake-animation');
        }, 500);
    }
}

// Scroll to thumbnail section
function scrollToThumbnail() {
    const thumbnailCard = document.getElementById('thumbnail-card');
    if (thumbnailCard) {
        thumbnailCard.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });

        // Highlight thumbnail card
        thumbnailCard.style.border = '3px solid #dc3545';
        thumbnailCard.style.boxShadow = '0 0 20px rgba(220, 53, 69, 0.3)';

        setTimeout(() => {
            thumbnailCard.style.border = '';
            thumbnailCard.style.boxShadow = '';
        }, 3000);
    }
}

// Close thumbnail error banner
function closeThumbnailError() {
    const errorBanner = document.querySelector('.thumbnail-error-banner');
    if (errorBanner) {
        errorBanner.style.display = 'none';
    }
}

