// Utility: safely get CKEditor instance
function getEditorInstance() {
    if (window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances.editor) {
        return CKEDITOR.instances.editor;
    }
    return null;
}

function insertTokenToEditor(token) {
    try {
        const ed = getEditorInstance();
        if (ed) {
            ed.insertText(token);
            return true;
        }
        // Fallback to textarea
        const ta = document.getElementById('editor');
        if (ta) {
            ta.value += (ta.value ? '\n' : '') + token + '\n';
            return true;
        }
    } catch (e) {
        console.error('insertTokenToEditor error:', e);
    }
    alert('Không thể chèn vào nội dung. Vui lòng tải lại trang và thử lại.');
    return false;
}

// === SCHEDULED PUBLISH DEFAULT ===
function initScheduledPublish() {
    const scheduledInput = document.querySelector('input[name="ScheduledPublishDate"]');

    if (scheduledInput && !scheduledInput.value) {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');

        scheduledInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
    }
}

// === THUMBNAIL MANAGEMENT ===
function uploadThumbnail(uploadImageUrl) {
    const fileInput = document.getElementById('thumbnail-file');
    const file = fileInput.files[0];

    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
        alert('Ảnh quá lớn! Vui lòng chọn ảnh nhỏ hơn 5MB');
        return;
    }

    const formData = new FormData();
    formData.append('file', file);

    fetch(uploadImageUrl, {
        method: 'POST',
        body: formData
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('thumbnail-url').value = data.url;
                document.getElementById('thumbnail-img').src = data.url;
                document.getElementById('thumbnail-preview').style.display = 'block';
                document.getElementById('thumbnail-upload').style.display = 'none';

                // Hide error banner when thumbnail uploaded
                onThumbnailUploaded();
            } else {
                alert(data.message || 'Upload thất bại');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi upload ảnh');
        });
}

function removeThumbnail() {
    document.getElementById('thumbnail-url').value = '';
    document.getElementById('thumbnail-img').src = '';
    document.getElementById('thumbnail-preview').style.display = 'none';
    document.getElementById('thumbnail-upload').style.display = 'block';
    document.getElementById('thumbnail-file').value = '';
    document.getElementById('thumbnail-url-input').value = '';
}

function setThumbnailByUrl() {
    const urlInput = document.getElementById('thumbnail-url-input');
    const imageUrl = urlInput.value.trim();

    if (!imageUrl) {
        alert('Vui lòng nhập URL hình ảnh');
        return;
    }

    try {
        new URL(imageUrl);
    } catch (e) {
        alert('URL không hợp lệ');
        return;
    }

    document.getElementById('thumbnail-url').value = imageUrl;
    document.getElementById('thumbnail-img').src = imageUrl;
    document.getElementById('thumbnail-preview').style.display = 'block';
    document.getElementById('thumbnail-upload').style.display = 'none';

    // Hide error banner when thumbnail set
    onThumbnailUploaded();
}

// === TAGS MANAGEMENT ===
let tags = [];

function initTagsInput() {
    const tagsInput = document.getElementById('tags-input');
    const tagsContainer = document.getElementById('tags-container');

    if (tagsInput) {
        tagsInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const tag = this.value.trim();
                if (tag && !tags.includes(tag)) {
                    tags.push(tag);
                    renderTags();
                    this.value = '';
                }
            }
        });
    }
}

function renderTags() {
    const tagsContainer = document.getElementById('tags-container');
    if (tagsContainer) {
        tagsContainer.innerHTML = '';
        tags.forEach((tag, index) => {
            const badge = document.createElement('span');
            badge.className = 'tag-badge';
            badge.innerHTML = `
                ${tag}
                <i class="fas fa-times" onclick="removeTag(${index})"></i>
                <input type="hidden" name="Tags" value="${tag}" />
            `;
            tagsContainer.appendChild(badge);
        });
    }
}

function removeTag(index) {
    tags.splice(index, 1);
    renderTags();
}

