// === VIDEO URL MANAGEMENT ===
function setVideoUrl() {
    const urlInput = document.getElementById('video-url-input');
    const videoUrl = urlInput.value.trim();

    if (!videoUrl) {
        alert('Vui lòng nhập URL video');
        return;
    }

    // Validate URL
    try {
        new URL(videoUrl);
    } catch (e) {
        alert('URL không hợp lệ. Vui lòng nhập URL đầy đủ từ Google Drive hoặc YouTube');
        return;
    }

    // Store video URL in hidden input
    document.getElementById('video-url').value = videoUrl;

    // Update video preview
    const videoPreview = document.getElementById('video-preview');
    const videoUpload = document.getElementById('video-upload');

    if (videoPreview && videoUpload) {
        let previewHTML = '';

        // Check if it's Google Drive
        if (videoUrl.includes('drive.google.com')) {
            // Extract FILE_ID for iframe embed
            let fileId = null;
            const match1 = videoUrl.match(/\/file\/d\/([^\/\?]+)/);
            if (match1) {
                fileId = match1[1];
            } else {
                const match2 = videoUrl.match(/[?&]id=([^&]+)/);
                if (match2) {
                    fileId = match2[1];
                }
            }

            if (fileId) {
                previewHTML = `
                    <div class="video-player-wrapper mb-2">
                        <iframe 
                            id="video-player-iframe"
                            src="https://drive.google.com/file/d/${fileId}/preview" 
                            width="100%" 
                            height="200"
                            allow="autoplay"
                            style="border: none; border-radius: 8px;"
                            class="video-iframe">
                        </iframe>
                    </div>
                    <small class="text-muted d-block text-center" style="font-size: 0.75rem;">
                        <i class="fab fa-google-drive me-1"></i>Google Drive
                    </small>
                `;
            }
        }
        // Check if it's YouTube
        else if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
            let youtubeId = '';
            if (videoUrl.includes('youtube.com/watch?v=')) {
                const match = videoUrl.match(/[?&]v=([^&]+)/);
                if (match) youtubeId = match[1];
            } else if (videoUrl.includes('youtu.be/')) {
                const match = videoUrl.match(/youtu\.be\/([^?]+)/);
                if (match) youtubeId = match[1];
            }

            if (youtubeId) {
                previewHTML = `
                    <div class="video-player-wrapper mb-2">
                        <iframe 
                            id="video-player-iframe"
                            src="https://www.youtube.com/embed/${youtubeId}" 
                            width="100%" 
                            height="200"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            style="border: none; border-radius: 8px;"
                            class="video-iframe">
                        </iframe>
                    </div>
                    <small class="text-muted d-block text-center" style="font-size: 0.75rem;">
                        <i class="fab fa-youtube me-1"></i>YouTube
                    </small>
                `;
            }
        }
        // Generic video URL
        else {
            previewHTML = `
                <div class="video-player-wrapper mb-2">
                    <video id="video-player" controls class="w-100" style="border-radius: 8px; max-height: 200px;">
                        <source src="${videoUrl}" type="video/mp4">
                        Trình duyệt không hỗ trợ.
                    </video>
                </div>
            `;
        }

        // Add remove button
        previewHTML += `
            <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-2" onclick="removeVideo()">
                <i class="fas fa-times me-1"></i>Xóa
            </button>
        `;

        videoPreview.innerHTML = previewHTML;

        // Show preview, hide input
        videoPreview.style.display = 'block';
        videoUpload.style.display = 'none';
    }

    console.log('✅ Video URL set:', videoUrl);

    // Show success message
    showVideoNotification('✅ Video loaded!', 'success');
}

// NEW: Insert token to editor to place video inline
function copyVideoToken() {
    const token = '[SV-VIDEO]';
    if (window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances.editor) {
        CKEDITOR.instances.editor.insertText(token);
        showVideoNotification('Đã chèn token [SV-VIDEO] vào nội dung', 'success');
    } else {
        // fallback: copy to clipboard
        navigator.clipboard.writeText(token).then(() => {
            showVideoNotification('Đã copy [SV-VIDEO] vào clipboard', 'success');
        });
    }
}

