// === WEB CRAWLER ===
function startCrawl(crawlUrl) {
    const urlInput = document.getElementById('crawl-url');
    const url = urlInput.value.trim();
    const statusDiv = document.getElementById('crawl-status');
    const btnCrawl = document.querySelector('.btn-crawl');

    if (!url) {
        alert('Vui lòng nhập URL bài báo');
        return;
    }

    try {
        new URL(url);
    } catch (e) {
        alert('URL không hợp lệ. Vui lòng nhập URL đầy đủ (bắt đầu với http:// hoặc https://)');
        return;
    }

    // CLEAR OLD DATA BEFORE CRAWLING - NEW BEHAVIOR
    console.log('🗑️ Clearing old data before crawl...');

    // Clear old thumbnail
    var thumbnailUrlInput = document.getElementById('thumbnail-url');
    var thumbnailImg = document.getElementById('thumbnail-img');
    var thumbnailPreview = document.getElementById('thumbnail-preview');
    var thumbnailUpload = document.getElementById('thumbnail-upload');

    if (thumbnailUrlInput) thumbnailUrlInput.value = '';
    if (thumbnailImg) thumbnailImg.src = '';
    if (thumbnailPreview) thumbnailPreview.style.display = 'none';
    if (thumbnailUpload) thumbnailUpload.style.display = 'block';

    console.log('✅ Old thumbnail cleared');

    // Show loading
    statusDiv.className = 'crawl-status loading';
    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lấy nội dung từ trang web... (có thể mất 5-10 giây)';
    btnCrawl.disabled = true;
    btnCrawl.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

    // Call API
    fetch(crawlUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify({ url: url })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                statusDiv.className = 'crawl-status success';
                statusDiv.innerHTML = '<i class="fas fa-check-circle me-2"></i>✅ Lấy nội dung thành công! Đang điền vào form...';

                // Fill form - ONLY if data exists
                if (data.title) {
                    document.querySelector('input[name="Title"]').value = data.title;
                }
                if (data.summary) {
                    document.querySelector('textarea[name="Summary"]').value = data.summary;
                }
                if (data.content) {
                    CKEDITOR.instances.editor.setData(data.content);
                }

                // AUTO SET THUMBNAIL - Priority: thumbnailUrl > first imageUrl
                var thumbnailToSet = data.thumbnailUrl
                    || (data.imageUrls && data.imageUrls.length > 0 ? data.imageUrls[0] : null);

                if (thumbnailToSet) {
                    console.log('🖼️ Setting new thumbnail:', thumbnailToSet);

                    // Set thumbnail URL to hidden input
                    if (thumbnailUrlInput) {
                        thumbnailUrlInput.value = thumbnailToSet;
                    }

                    // Set thumbnail image preview
                    if (thumbnailImg) {
                        thumbnailImg.src = thumbnailToSet;

                        // Handle image load error
                        thumbnailImg.onerror = function () {
                            console.error('❌ Failed to load thumbnail image:', thumbnailToSet);
                            // Try next image if available
                            if (data.imageUrls && data.imageUrls.length > 1) {
                                var nextImage = data.imageUrls[1];
                                console.log('🔄 Trying next image:', nextImage);
                                thumbnailImg.src = nextImage;
                                if (thumbnailUrlInput) {
                                    thumbnailUrlInput.value = nextImage;
                                }
                            }
                        };
                    }

                    // Show preview, hide upload area
                    if (thumbnailPreview) {
                        thumbnailPreview.style.display = 'block';
                    }
                    if (thumbnailUpload) {
                        thumbnailUpload.style.display = 'none';
                    }

                    console.log('✅ New thumbnail set successfully');
                } else {
                    console.warn('⚠️ No thumbnail available from crawler - thumbnail remains empty');
                }

                // Add source note
                setTimeout(() => {
                    const currentContent = CKEDITOR.instances.editor.getData();
                    const sourceNote = `
<hr>
<p style="background-color: #fff3cd; padding: 10px; border-left: 4px solid #ffc107;">
    <strong>📌 Nguồn tham khảo:</strong> 
    <a href="${data.sourceUrl}" target="_blank" rel="noopener">${data.sourceUrl}</a>
</p>`;
                    CKEDITOR.instances.editor.setData(currentContent + sourceNote);
                }, 1000);

                // Update status with thumbnail info
                var thumbnailStatus = thumbnailToSet
                    ? '✅ Đã tự động set'
                    : '❌ Không tìm thấy';

                statusDiv.innerHTML = `
                <i class="fas fa-check-circle me-2"></i>
                ✅ <strong>Hoàn tất!</strong><br>
                <small>
                    • Tiêu đề: ${data.title ? '✅' : '❌'}<br>
                    • Tóm tắt: ${data.summary ? '✅' : '❌'}<br>
                    • Nội dung: ${data.content ? '✅ (Đã bao gồm hình ảnh)' : '❌'}<br>
                    • Ảnh đại diện: ${thumbnailStatus}
                </small>
            `;

                setTimeout(() => {
                    statusDiv.style.display = 'none';
                }, 5000);

            } else {
                statusDiv.className = 'crawl-status error';
                statusDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Không thể lấy nội dung</strong><br>
                <small>${data.message || 'Lỗi không xác định'}</small><br>
                <small style="color: #666;">💡 Gợi ý: Thử với trang web khác hoặc nhập thủ công</small>
            `;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            statusDiv.className = 'crawl-status error';
            statusDiv.innerHTML = `
            <i class="fas fa-exclamation-circle me-2"></i>
            <strong>Lỗi kết nối</strong><br>
            <small>Không thể kết nối tới server. Vui lòng thử lại.</small>
        `;
        })
        .finally(() => {
            btnCrawl.disabled = false;
            btnCrawl.innerHTML = '<i class="fas fa-download me-2"></i>Lấy nội dung';
        });
}

