@* Partial View: Article Content Form Fields *@
@using SacViet.ViewModels

@* Accept both Create and Edit ViewModels *@
@model object

<div class="content-card mb-4">
    <div class="content-card-header">
        <h5 class="mb-0">
            <i class="fas fa-file-alt text-primary me-2"></i>
            Nội dung bài viết
        </h5>
    </div>
    <div class="content-card-body">
        <!-- Title -->
        <div class="form-group-modern mb-4">
            <label class="form-label-modern">
                <i class="fas fa-heading me-2"></i>Tiêu đề <span class="text-danger">*</span>
            </label>
            <input name="Title" 
                   value="@(Model is ArticleEditViewModel edit ? edit.Title : (Model as ArticleCreateViewModel)?.Title)" 
                   class="form-control-modern"
                   placeholder="Nhập tiêu đề hấp dẫn cho bài viết..."
                   required
                   maxlength="500" />
            <span class="validation-message"></span>
            <small class="form-hint">Tiêu đề nên ngắn gọn, súc tích và thu hút</small>
        </div>

        <!-- Summary -->
        <div class="form-group-modern mb-4">
            <label class="form-label-modern">
                <i class="fas fa-align-left me-2"></i>Tóm tắt
            </label>
            <textarea name="Summary" 
                      class="form-control-modern" 
                      rows="3"
                      placeholder="Viết tóm tắt ngắn gọn về nội dung bài viết..."
                      maxlength="1000">@(Model is ArticleEditViewModel editSum ? editSum.Summary : (Model as ArticleCreateViewModel)?.Summary)</textarea>
            <span class="validation-message"></span>
            <small class="form-hint">Tóm tắt giúp người đọc nắm nhanh nội dung</small>
        </div>

        <!-- Content -->
        <div class="form-group-modern">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label-modern mb-0">
                    <i class="fas fa-paragraph me-2"></i>Nội dung <span class="text-danger">*</span>
                </label>
                <button type="button" class="btn-video-embed" onclick="openVideoEmbedModal()">
                    <i class="fas fa-video"></i>
                    Chèn Video
                </button>
            </div>
            <textarea name="Content" 
                      id="editor" 
                      class="form-control-modern" 
                      rows="10"
                      required>@(Model is ArticleEditViewModel editContent ? editContent.Content : (Model as ArticleCreateViewModel)?.Content)</textarea>
            <span class="validation-message"></span>
            <small class="form-hint">
                <i class="fas fa-info-circle me-1"></i>
                Sử dụng nút "Chèn Video" để thêm video với tiêu đề vào bất kỳ vị trí nào trong bài viết
            </small>
        </div>
    </div>
</div>

<!-- Tips Card -->
<div class="tips-card-horizontal">
    <div class="tips-icon">
        <i class="fas fa-lightbulb"></i>
    </div>
    <div class="tips-content">
        <h6>Mẹo viết bài hiệu quả</h6>
        <p>• Dùng tiêu đề ngắn gọn, dễ hiểu • Chia nhỏ đoạn văn • Thêm hình ảnh và video minh họa</p>
    </div>
</div>

<!-- Video Embed Modal -->
<div class="modal fade video-embed-modal" id="videoEmbedModal" tabindex="-1" aria-labelledby="videoEmbedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoEmbedModalLabel">
                    <i class="fas fa-video me-2"></i>Chèn Video vào Bài Viết
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="embed-video-title" class="form-label">
                        <i class="fas fa-heading me-2"></i>Tiêu đề Video <span class="text-danger">*</span>
                    </label>
                    <input type="text" 
                           class="form-control" 
                           id="embed-video-title" 
                           placeholder="VD: Hướng dẫn sử dụng sản phẩm mới"
                           maxlength="200" 
                           required>
                    <small class="text-muted">Tiêu đề sẽ hiển thị phía trên video</small>
                </div>
                
                <div class="mb-3">
                    <label for="embed-video-url" class="form-label">
                        <i class="fas fa-link me-2"></i>URL Video <span class="text-danger">*</span>
                    </label>
                    <input type="url" 
                           class="form-control" 
                           id="embed-video-url" 
                           placeholder="https://drive.google.com/file/d/... hoặc https://youtube.com/watch?v=..."
                           required>
                    <small class="text-muted">Hỗ trợ Google Drive, YouTube và URL trực tiếp</small>
                </div>
                
                <div class="video-hint">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>Hướng dẫn nhanh:</strong>
                    </small>
                    <ol class="small text-muted mb-0 ps-3 mt-2">
                        <li>Upload video lên Google Drive hoặc YouTube</li>
                        <li>Đổi quyền file thành "Anyone with the link can view" (Google Drive)</li>
                        <li>Copy link share và paste vào ô trên</li>
                        <li>Nhập tiêu đề cho video</li>
                        <li>Nhấn "Chèn Video" - video sẽ được chèn tại vị trí con trỏ trong bài viết</li>
                    </ol>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-primary" onclick="insertVideoIntoCKEditor()">
                    <i class="fas fa-check me-1"></i>Chèn Video
                </button>
            </div>
        </div>
    </div>
</div>
