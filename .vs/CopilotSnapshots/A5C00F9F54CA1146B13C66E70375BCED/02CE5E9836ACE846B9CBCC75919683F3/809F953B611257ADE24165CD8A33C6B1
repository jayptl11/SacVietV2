@model SacViet.ViewModels.ArticleCreateViewModel
@{
    ViewData["Title"] = "Tạo bài viết mới";
    var categories = ViewBag.Categories as IEnumerable<SacViet.Models.Category>;
}

@* Link CSS *@
<link rel="stylesheet" href="~/css/writer-article-form.css" />

<div class="create-article-container">
    <!-- Page Header -->
    <div class="page-header-bar mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">
                    <i class="fas fa-plus-circle text-primary me-2"></i>
                    Tạo bài viết mới
                </h2>
                <p class="page-subtitle mb-0">
                    <i class="fas fa-pen me-2"></i>
                    Bắt đầu viết câu chuyện của bạn
                </p>
            </div>
            <div>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- TempData Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Crawler Card -->
                @await Html.PartialAsync("_CrawlerCard")

                <!-- Content Form Fields -->
                @await Html.PartialAsync("_ContentFormFields", Model)
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Sidebar (Category, Thumbnail, Schedule, Tags) -->
                @{
                    var sidebarData = new ViewDataDictionary(ViewData);
                    sidebarData["Categories"] = categories;
                    sidebarData["AudioUrl"] = Model.AudioUrl; // NEW: Pass AudioUrl
                    sidebarData["ThumbnailImage"] = Model.ThumbnailImage;
                    sidebarData["ScheduledPublishDate"] = Model.ScheduledPublishDate;
                    sidebarData["Tags"] = Model.Tags;

                    sidebarData["CanEdit"] = true;
                }
                @await Html.PartialAsync("_ArticleSidebar", Model, sidebarData)

                <!-- Actions Card -->
                @await Html.PartialAsync("_ActionButtons", new { isEditMode = false })
            </div>
        </div>

        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script src="~/js/writer-article-form.js"></script>
    <script>
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Init CKEditor
            initCKEditor('@Url.Action("UploadImage", "Writer")');
            
            // Update CKEditor before submit
            updateCKEditorBeforeSubmit();
            
            // Show server-side error if exists
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                // Trigger thumbnail error banner
                var thumbnailCard = document.getElementById('thumbnail-card');
                if (thumbnailCard) {
                    showThumbnailError();
                    scrollToThumbnail();
                }
                </text>
            }
        });
    </script>
}