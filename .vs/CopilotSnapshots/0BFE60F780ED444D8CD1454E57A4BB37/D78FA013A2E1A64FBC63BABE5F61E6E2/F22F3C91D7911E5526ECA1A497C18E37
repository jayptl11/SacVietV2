using System.ComponentModel.DataAnnotations;

namespace SacViet.ViewModels
{
    public class MediaLinkViewModel
    {
        [SacViet.Validation.UrlOrPath(ErrorMessage = "URL ảnh không hợp lệ. Hãy dùng URL http/https hoặc đường dẫn bắt đầu bằng '/'")]
        [StringLength(1000)]
        public string? Url { get; set; }

        [StringLength(200)]
        public string? Title { get; set; }
    }

    public class ArticleCreateViewModel
    {
        [Required(ErrorMessage = "Tiêu đề không được để trống")]
        [StringLength(500, ErrorMessage = "Tiêu đề không được vượt quá 500 ký tự")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng chọn danh mục")]
        public int CategoryId { get; set; }

        [StringLength(1000, ErrorMessage = "Tóm tắt không được vượt quá 1000 ký tự")]
        public string? Summary { get; set; }

        [Required(ErrorMessage = "Nội dung không được để trống")]
        public string Content { get; set; } = string.Empty;

        public string? ThumbnailImage { get; set; }

        public DateTime? ScheduledPublishDate { get; set; } = DateTime.Now;

        public List<string> Tags { get; set; } = new List<string>();

        // Audio URL for Podcast category
        public string? AudioUrl { get; set; }

        // Deprecated single video fields (kept for backward compatibility)
        public string? VideoUrl { get; set; }
        [StringLength(200)]
        public string? VideoTitle { get; set; }

        // NEW: Multiple inline media lists
        public List<MediaLinkViewModel> Videos { get; set; } = new();
        public List<MediaLinkViewModel> Images { get; set; } = new();
    }

    public class ArticleEditViewModel
    {
        public int ArticleId { get; set; }

        [Required(ErrorMessage = "Tiêu đề không được để trống")]
        [StringLength(500, ErrorMessage = "Tiêu đề không được vượt quá 500 ký tự")]
        public string Title { get; set; } = string.Empty;

        public string Slug { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng chọn danh mục")]
        public int CategoryId { get; set; }

        [StringLength(1000, ErrorMessage = "Tóm tắt không được vượt quá 1000 ký tự")]
        public string? Summary { get; set; }

        [Required(ErrorMessage = "Nội dung không được để trống")]
        public string Content { get; set; } = string.Empty;

        public string? ThumbnailImage { get; set; }

        public string? Status { get; set; }

        public DateTime? ScheduledPublishDate { get; set; }

        public DateTime? CreatedAt { get; set; }

        public DateTime? UpdatedAt { get; set; }

        public List<string> Tags { get; set; } = new List<string>();

        // Audio URL for Podcast category
        public string? AudioUrl { get; set; }

        // Deprecated single video fields (kept for backward compatibility)
        public string? VideoUrl { get; set; }
        [StringLength(200)]
        public string? VideoTitle { get; set; }

        // NEW: Multiple inline media lists
        public List<MediaLinkViewModel> Videos { get; set; } = new();
        public List<MediaLinkViewModel> Images { get; set; } = new();
    }

    public class WriterStatsViewModel
    {
        public int TotalArticles { get; set; }
        public int DraftArticles { get; set; }
        public int PendingArticles { get; set; }
        public int ApprovedArticles { get; set; }
        public int RejectedArticles { get; set; }
        public int PublishedArticles { get; set; }
        public int TotalViews { get; set; }
    }

    public class ArticleListItemViewModel
    {
        public int ArticleId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string? ThumbnailImage { get; set; }
        public string CategoryName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int ViewCount { get; set; }
        public DateTime? CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
        public DateTime? PublishedAt { get; set; }
        public DateTime? ScheduledPublishDate { get; set; }
        public string? LatestApprovalStatus { get; set; }
        public string? RejectionReason { get; set; }
    }

    public class ApprovalHistoryViewModel
    {
        public int ApprovalId { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? ReviewNote { get; set; }
        public string? ReviewerName { get; set; }
        public DateTime? SubmittedAt { get; set; }
        public DateTime? ReviewedAt { get; set; }
    }

    // ViewModel cho chi tiết bài viết cần duyệt (Writer tự duyệt)
    public class ArticleDetailForApprovalViewModel
    {
        public int ArticleId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string? Summary { get; set; }
        public string Content { get; set; } = string.Empty;
        public string? ThumbnailImage { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
        public DateTime? ScheduledPublishDate { get; set; }
        public int ViewCount { get; set; }

        // Category info
        public int CategoryId { get; set; }
        public string CategoryName { get; set; } = string.Empty;

        // Author info
        public int AuthorId { get; set; }
        public string AuthorName { get; set; } = string.Empty;
        public string? AuthorAvatar { get; set; }

        // Approval history
        public List<ApprovalHistoryViewModel> ApprovalHistory { get; set; } = new();

        // Latest approval info
        public string? LatestApprovalStatus { get; set; }
        public string? LatestApprovalNote { get; set; }
        public DateTime? LatestApprovalDate { get; set; }

        // Tags
        public List<string> Tags { get; set; } = new();
    }

    // ViewModel cho danh sách bài viết chờ duyệt (Writer tự duyệt)
    public class WriterPendingArticlesViewModel
    {
        public List<ArticleListItemViewModel> Articles { get; set; } = new();
        public int CurrentPage { get; set; }
        public int TotalPages { get; set; }
        public int TotalItems { get; set; }
        public int PageSize { get; set; }
        public bool HasPreviousPage => CurrentPage > 1;
        public bool HasNextPage => CurrentPage < TotalPages;
    }
}