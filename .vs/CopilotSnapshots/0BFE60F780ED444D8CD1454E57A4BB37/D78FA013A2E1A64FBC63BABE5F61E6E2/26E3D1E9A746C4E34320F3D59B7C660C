@model SacViet.ViewModels.WriterPendingArticlesViewModel
@{
    ViewData["Title"] = "Quản lý duyệt bài viết";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">
                    <i class="fas fa-check-double text-success me-2"></i>
                    Quản lý duyệt bài viết
                </h2>
                <p class="page-subtitle">
                    <i class="fas fa-clock me-2"></i>
                    <strong>@Model.TotalItems</strong> bài viết đang chờ duyệt
                </p>
            </div>
            <div>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Dashboard
                </a>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-list me-1"></i>Tất cả bài viết
                </a>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="alert alert-info mb-4">
        <div class="d-flex align-items-center">
            <i class="fas fa-info-circle fa-2x me-3"></i>
            <div>
                <strong>Tự duyệt bài viết của bạn</strong>
                <p class="mb-0">Bạn có thể xem trước và tự duyệt các bài viết của mình. Sau khi duyệt, bài viết sẽ được đăng ngay lập tức (hoặc theo lịch hẹn giờ nếu có).</p>
            </div>
        </div>
    </div>

    @if (Model.Articles.Any())
    {
        <!-- Articles List -->
        <div class="row g-4">
            @foreach (var article in Model.Articles)
            {
                <div class="col-lg-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 article-card">
                        @if (!string.IsNullOrEmpty(article.ThumbnailImage))
                        {
                            <div class="position-relative">
                                <img src="@article.ThumbnailImage" class="card-img-top" alt="@article.Title"
                                     style="height: 180px; object-fit: cover;">
                                <span class="badge bg-warning position-absolute top-0 end-0 m-2">
                                    <i class="fas fa-clock me-1"></i>Chờ duyệt
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center position-relative" style="height: 180px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                                <span class="badge bg-warning position-absolute top-0 end-0 m-2">
                                    <i class="fas fa-clock me-1"></i>Chờ duyệt
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">@article.CategoryName</span>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>@article.CreatedAt?.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <h5 class="card-title mb-3">
                                <a href="@Url.Action("ArticlePreview", new { id = article.ArticleId })"
                                   class="text-dark text-decoration-none article-title">
                                    @article.Title
                                </a>
                            </h5>

                            @if (article.ScheduledPublishDate.HasValue && article.ScheduledPublishDate > DateTime.Now)
                            {
                                <div class="alert alert-info alert-sm py-2 px-3 mb-3">
                                    <small>
                                        <i class="fas fa-clock me-1"></i>
                                        <strong>Hẹn giờ:</strong> @article.ScheduledPublishDate?.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            }

                            <div class="mt-auto">
                                <div class="btn-group w-100" role="group">
                                    <a href="@Url.Action("ArticlePreview", new { id = article.ArticleId })"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>Xem trước
                                    </a>
                                    <button type="button" class="btn btn-sm btn-success"
                                            onclick="approveArticle(@article.ArticleId, '@article.Title.Replace("'", "\\'"))')">
                                        <i class="fas fa-check me-1"></i>Duyệt
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            onclick="cancelSubmission(@article.ArticleId)">
                                        <i class="fas fa-undo me-1"></i>Hủy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = Model.CurrentPage - 1 })">
                                <i class="fas fa-chevron-left"></i> Trước
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("PendingArticles", new { page = Model.CurrentPage + 1 })">
                                Sau <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                <h5 class="text-muted">Không có bài viết nào đang chờ duyệt</h5>
                <p class="text-muted">Tất cả bài viết của bạn đã được xử lý.</p>
                <div class="mt-3">
                    <a href="@Url.Action("Create")" class="btn btn-primary me-2">
                        <i class="fas fa-plus-circle me-1"></i>Tạo bài viết mới
                    </a>
                    <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-1"></i>Xem tất cả bài viết
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Approve Confirmation Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle me-2"></i>Xác nhận duyệt bài viết
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn duyệt và đăng bài viết này?</p>
                <p class="fw-bold text-primary" id="approveArticleTitle"></p>
                <div class="mb-3">
                    <label class="form-label">Ghi chú (tùy chọn):</label>
                    <textarea class="form-control" id="approveNote" rows="2" placeholder="Nhập ghi chú nếu cần..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="confirmApproveBtn">
                    <i class="fas fa-check me-1"></i>Xác nhận duyệt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Confirmation Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-undo me-2"></i>Hủy gửi duyệt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn hủy gửi duyệt bài viết này?</p>
                <p class="text-muted">Bài viết sẽ được chuyển về trạng thái <strong>Nháp</strong> để bạn có thể chỉnh sửa lại.</p>
                <div class="mb-3">
                    <label class="form-label">Lý do hủy (tùy chọn):</label>
                    <textarea class="form-control" id="cancelNote" rows="2" placeholder="Nhập lý do nếu cần..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="confirmCancelBtn">
                    <i class="fas fa-undo me-1"></i>Xác nhận hủy
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<style>
    .page-header {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #6c757d;
        margin: 0;
    }

    .article-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .article-title {
        transition: color 0.3s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .article-title:hover {
        color: #0d6efd !important;
    }

    .alert-sm {
        font-size: 0.85rem;
    }
</style>

<script>
    let currentArticleId = null;

    function approveArticle(articleId, title) {
        currentArticleId = articleId;
        document.getElementById('approveArticleTitle').textContent = title;
        document.getElementById('approveNote').value = '';
        new bootstrap.Modal(document.getElementById('approveModal')).show();
    }

    function cancelSubmission(articleId) {
        currentArticleId = articleId;
        document.getElementById('cancelNote').value = '';
        new bootstrap.Modal(document.getElementById('cancelModal')).show();
    }

    document.getElementById('confirmApproveBtn').addEventListener('click', function() {
        if (!currentArticleId) return;

        const note = document.getElementById('approveNote').value;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('@Url.Action("SelfApprove")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                articleId: currentArticleId,
                note: note,
                __RequestVerificationToken: token
            })
        })
        .then(response => response.json())
        .then(data => {
            bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
            if (data.success) {
                showAlert('success', data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showAlert('danger', data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('danger', 'Có lỗi xảy ra. Vui lòng thử lại.');
        });
    });

    document.getElementById('confirmCancelBtn').addEventListener('click', function() {
        if (!currentArticleId) return;

        const note = document.getElementById('cancelNote').value;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('@Url.Action("CancelSubmission")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                articleId: currentArticleId,
                note: note,
                __RequestVerificationToken: token
            })
        })
        .then(response => response.json())
        .then(data => {
            bootstrap.Modal.getInstance(document.getElementById('cancelModal')).hide();
            if (data.success) {
                showAlert('success', data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showAlert('danger', data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlert('danger', 'Có lỗi xảy ra. Vui lòng thử lại.');
        });
    });

    function showAlert(type, message) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
        alertDiv.style.zIndex = '9999';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alertDiv);
        setTimeout(() => alertDiv.remove(), 5000);
    }
</script>
