}

// === WEB CRAWLER ===
function startCrawl(crawlUrl) {
    const urlInput = document.getElementById('crawl-url');
    const url = urlInput.value.trim();
    const statusDiv = document.getElementById('crawl-status');
    const btnCrawl = document.querySelector('.btn-crawl');

    if (!url) {
        alert('Vui lòng nhập URL bài báo');
        return;
    }

    try {
        new URL(url);
    } catch (e) {
        alert('URL không hợp lệ. Vui lòng nhập URL đầy đủ (bắt đầu với http:// hoặc https://)');
        return;
    }

    // CLEAR OLD DATA BEFORE CRAWLING - NEW BEHAVIOR
    console.log('🗑️ Clearing old data before crawl...');
    
    // Clear old thumbnail
    var thumbnailUrlInput = document.getElementById('thumbnail-url');
    var thumbnailImg = document.getElementById('thumbnail-img');
    var thumbnailPreview = document.getElementById('thumbnail-preview');
    var thumbnailUpload = document.getElementById('thumbnail-upload');
    
    if (thumbnailUrlInput) thumbnailUrlInput.value = '';
    if (thumbnailImg) thumbnailImg.src = '';
    if (thumbnailPreview) thumbnailPreview.style.display = 'none';
    if (thumbnailUpload) thumbnailUpload.style.display = 'block';
    
    console.log('✅ Old thumbnail cleared');

    // Show loading
    statusDiv.className = 'crawl-status loading';
    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lấy nội dung từ trang web... (có thể mất 5-10 giây)';
    btnCrawl.disabled = true;
    btnCrawl.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

    // Call API
    fetch(crawlUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify({ url: url })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            statusDiv.className = 'crawl-status success';
            statusDiv.innerHTML = '<i class="fas fa-check-circle me-2"></i>✅ Lấy nội dung thành công! Đang điền vào form...';

            // Fill form - ONLY if data exists
            if (data.title) {
                document.querySelector('input[name="Title"]').value = data.title;
            }
            if (data.summary) {
                document.querySelector('textarea[name="Summary"]').value = data.summary;
            }
            if (data.content) {
                CKEDITOR.instances.editor.setData(data.content);
            }
            
            // AUTO SET THUMBNAIL - Priority: thumbnailUrl > first imageUrl
            var thumbnailToSet = data.thumbnailUrl 
                || (data.imageUrls && data.imageUrls.length > 0 ? data.imageUrls[0] : null);
            
            if (thumbnailToSet) {
                console.log('🖼️ Setting new thumbnail:', thumbnailToSet);
                
                // Set thumbnail URL to hidden input
                if (thumbnailUrlInput) {
                    thumbnailUrlInput.value = thumbnailToSet;
                }
                
                // Set thumbnail image preview
                if (thumbnailImg) {
                    thumbnailImg.src = thumbnailToSet;
                    
                    // Handle image load error
                    thumbnailImg.onerror = function() {
                        console.error('❌ Failed to load thumbnail image:', thumbnailToSet);
                        // Try next image if available
                        if (data.imageUrls && data.imageUrls.length > 1) {
                            var nextImage = data.imageUrls[1];
                            console.log('🔄 Trying next image:', nextImage);
                            thumbnailImg.src = nextImage;
                            if (thumbnailUrlInput) {
                                thumbnailUrlInput.value = nextImage;
                            }
                        }
                    };
                }
                
                // Show preview, hide upload area
                if (thumbnailPreview) {
                    thumbnailPreview.style.display = 'block';
                }
                if (thumbnailUpload) {
                    thumbnailUpload.style.display = 'none';
                }
                
                console.log('✅ New thumbnail set successfully');
            } else {
                console.warn('⚠️ No thumbnail available from crawler - thumbnail remains empty');
            }

            // Add source note
            setTimeout(() => {
                const currentContent = CKEDITOR.instances.editor.getData();
                const sourceNote = `
<hr>
<p style="background-color: #fff3cd; padding: 10px; border-left: 4px solid #ffc107;">
    <strong>📌 Nguồn tham khảo:</strong> 
    <a href="${data.sourceUrl}" target="_blank" rel="noopener">${data.sourceUrl}</a>
</p>`;
                CKEDITOR.instances.editor.setData(currentContent + sourceNote);
            }, 1000);

            // Update status with thumbnail info
            var thumbnailStatus = thumbnailToSet 
                ? '✅ Đã tự động set' 
                : '❌ Không tìm thấy';
            
            statusDiv.innerHTML = `
                <i class="fas fa-check-circle me-2"></i>
                ✅ <strong>Hoàn tất!</strong><br>
                <small>
                    • Tiêu đề: ${data.title ? '✅' : '❌'}<br>
                    • Tóm tắt: ${data.summary ? '✅' : '❌'}<br>
                    • Nội dung: ${data.content ? '✅ (Đã bao gồm hình ảnh)' : '❌'}<br>
                    • Ảnh đại diện: ${thumbnailStatus}
                </small>
            `;

            setTimeout(() => {
                statusDiv.style.display = 'none';
            }, 5000);

        } else {
            statusDiv.className = 'crawl-status error';
            statusDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Không thể lấy nội dung</strong><br>
                <small>${data.message || 'Lỗi không xác định'}</small><br>
                <small style="color: #666;">💡 Gợi ý: Thử với trang web khác hoặc nhập thủ công</small>
            `;
        }
    })
    .catch(error => {
        console.error('Error:', error);
        statusDiv.className = 'crawl-status error';
        statusDiv.innerHTML = `
            <i class="fas fa-exclamation-circle me-2"></i>
            <strong>Lỗi kết nối</strong><br>
            <small>Không thể kết nối tới server. Vui lòng thử lại.</small>
        `;
    })
    .finally(() => {
        btnCrawl.disabled = false;
        btnCrawl.innerHTML = '<i class="fas fa-download me-2"></i>Lấy nội dung';
    });
}

// === INITIALIZATION ===
document.addEventListener('DOMContentLoaded', function() {
    initScheduledPublish();
    initTagsInput();
    initThumbnailValidation();
    initCategoryChangeListener(); // NEW: Listen to category changes
});

// === CATEGORY CHANGE HANDLER ===
function initCategoryChangeListener() {
    const categorySelect = document.querySelector('select[name="CategoryId"]');
    const audioCard = document.getElementById('audio-card');
    
    if (!categorySelect || !audioCard) return;
    
    // Check on page load
    checkCategoryAndShowAudio();
    
    // Listen to category changes
    categorySelect.addEventListener('change', checkCategoryAndShowAudio);
}

function checkCategoryAndShowAudio() {
    const categorySelect = document.querySelector('select[name="CategoryId"]');
    const audioCard = document.getElementById('audio-card');
    
    if (!categorySelect || !audioCard) return;
    
    const selectedOption = categorySelect.options[categorySelect.selectedIndex];
    const categoryName = selectedOption.text.toLowerCase();
    
    // Show audio card if "podcast" is in category name
    if (categoryName.includes('podcast')) {
        audioCard.style.display = 'block';
        console.log('✅ Audio card shown for Podcast category');
    } else {
        audioCard.style.display = 'none';
        console.log('ℹ️ Audio card hidden (not Podcast category)');
    }
}

// === AUDIO URL MANAGEMENT ===
function setAudioUrl() {
    const urlInput = document.getElementById('audio-url-input');
    const audioUrl = urlInput.value.trim();
    
    if (!audioUrl) {
        alert('Vui lòng nhập URL file âm thanh');
        return;
    }
    
    // Validate URL
    try {
        new URL(audioUrl);
    } catch (e) {
        alert('URL không hợp lệ. Vui lòng nhập URL đầy đủ từ Google Drive');
        return;
    }
    
    // Convert Google Drive share link to direct link if needed
    let directUrl = audioUrl;
    if (audioUrl.includes('drive.google.com')) {
        directUrl = convertGoogleDriveUrl(audioUrl);
    }
    
    // Set audio URL
    document.getElementById('audio-url').value = directUrl;
    
    // Update audio player
    const audioPlayer = document.getElementById('audio-player');
    const audioSource = document.getElementById('audio-source');
    if (audioPlayer && audioSource) {
        audioSource.src = directUrl;
        audioPlayer.load();
    }
    
    // Show preview, hide input
    document.getElementById('audio-preview').style.display = 'block';
    document.getElementById('audio-upload').style.display = 'none';
    
    console.log('✅ Audio URL set:', directUrl);
}

function removeAudio() {
    // Clear audio URL
    document.getElementById('audio-url').value = '';
    document.getElementById('audio-url-input').value = '';
    
    // Clear audio player
    const audioPlayer = document.getElementById('audio-player');
    const audioSource = document.getElementById('audio-source');
    if (audioPlayer && audioSource) {
        audioSource.src = '';
        audioPlayer.load();
    }
    
    // Hide preview, show input
    document.getElementById('audio-preview').style.display = 'none';
    document.getElementById('audio-upload').style.display = 'block';
    
    console.log('🗑️ Audio removed');
}

// Convert Google Drive share link to direct link
function convertGoogleDriveUrl(url) {
    // Example input: https://drive.google.com/file/d/FILE_ID/view?usp=sharing
    // Example output: https://drive.google.com/uc?export=download&id=FILE_ID
    
    const fileIdMatch = url.match(/\/d\/([^\/]+)/);
    if (fileIdMatch && fileIdMatch[1]) {
        const fileId = fileIdMatch[1];
        return `https://drive.google.com/uc?export=download&id=${fileId}`;
    }
    
    // If already in direct format or can't convert, return as-is
    return url;
}

// === THUMBNAIL VALIDATION FOR SUBMIT ===
function initThumbnailValidation() {
    const form = document.querySelector('form');
    if (!form) return;

    form.addEventListener('submit', function(e) {
        // Check which button was clicked
        const submitter = e.submitter;
        if (!submitter) return;

        const action = submitter.value;
        
        // Only validate thumbnail for "submit" action, not "draft"
        if (action === 'submit') {
            const thumbnailUrl = document.getElementById('thumbnail-url')?.value;
            
            if (!thumbnailUrl || thumbnailUrl.trim() === '') {
                e.preventDefault();
                
                // Show error alert
                showThumbnailError();
                
                // Scroll to thumbnail section
                scrollToThumbnail();
                
                console.error('❌ Validation failed: Thumbnail required for submit');
                return false;
            }
        }
        
        console.log('✅ Validation passed for action:', action);
    });
}

// Show thumbnail error with visual feedback
function showThumbnailError() {
    // Show alert dialog
    alert('⚠️ Vui lòng chọn ảnh đại diện trước khi gửi duyệt!\n\n' +
          'Bạn có thể:\n' +
          '• Upload ảnh từ máy tính\n' +
          '• Dán URL ảnh\n' +
          '• Hoặc lưu nháp để thêm ảnh sau');
    
    // Show error banner
    const thumbnailCard = document.getElementById('thumbnail-card');
    if (thumbnailCard) {
        // Create error banner if not exists
        let errorBanner = thumbnailCard.querySelector('.thumbnail-error-banner');
        if (!errorBanner) {
            errorBanner = document.createElement('div');
            errorBanner.className = 'thumbnail-error-banner';
            errorBanner.innerHTML = `
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Bắt buộc:</strong> Vui lòng chọn ảnh đại diện để gửi duyệt
                <button type="button" class="btn-close-banner" onclick="closeThumbnailError()">
                    <i class="fas fa-times"></i>
                </button>
            `;
            thumbnailCard.insertBefore(errorBanner, thumbnailCard.firstChild);
        }
        
        // Show banner with animation
        errorBanner.style.display = 'flex';
        errorBanner.classList.add('shake-animation');
        
        // Remove shake animation after it completes
        setTimeout(() => {
            errorBanner.classList.remove('shake-animation');
        }, 500);
    }
}

// Scroll to thumbnail section
function scrollToThumbnail() {
    const thumbnailCard = document.getElementById('thumbnail-card');
    if (thumbnailCard) {
        thumbnailCard.scrollIntoView({ 
            behavior: 'smooth', 
            block: 'center' 
        });
        
        // Highlight thumbnail card
        thumbnailCard.style.border = '3px solid #dc3545';
        thumbnailCard.style.boxShadow = '0 0 20px rgba(220, 53, 69, 0.3)';
        
        setTimeout(() => {
            thumbnailCard.style.border = '';
            thumbnailCard.style.boxShadow = '';
        }, 3000);
    }
}

// Close thumbnail error banner
function closeThumbnailError() {
    const errorBanner = document.querySelector('.thumbnail-error-banner');
    if (errorBanner) {
        errorBanner.style.display = 'none';
    }
}

// Auto-hide error banner when thumbnail is uploaded
function onThumbnailUploaded() {
    const errorBanner = document.querySelector('.thumbnail-error-banner');
    if (errorBanner) {
        errorBanner.style.display = 'none';
    }
}
