@model SacViet.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Tìm kiếm";
    ViewBag.SearchKeyword = Model.Keyword;
}

<div class="container mt-4">
    <!-- Search Header -->
    <div class="search-header mb-4">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">
                    <i class="fas fa-search text-secondary me-2"></i>
                    Kết quả tìm kiếm
                    @if (!string.IsNullOrEmpty(Model.Keyword))
                    {
                        <span class="text-muted fw-normal">cho "<span class="text-dark fw-bold">@Model.Keyword</span>"</span>
                    }
                </h2>
                
                <!-- Compact Search Bar -->
                <div class="compact-search-container mb-4">
                    <form asp-controller="Home" asp-action="Search" method="get" class="compact-search-form">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <input type="text" name="keyword" class="form-control" value="@Model.Keyword" placeholder="🔍 Nhập từ khóa...">
                            </div>
                            <div class="col-md-3">
                                <select name="categoryId" class="form-select">
                                    <option value="">📁 Tất cả chuyên mục</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">
                                            @category.CategoryName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-dark w-100">
                                    <i class="fas fa-search me-1"></i>Tìm kiếm
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                                    <i class="fas fa-filter me-1"></i>Lọc
                                </button>
                            </div>
                        </div>
                        
                        <!-- Advanced Filters - Collapsible -->
                        <div class="collapse mt-3" id="advancedFilters">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body bg-light">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted">
                                                <i class="fas fa-calendar-alt me-1"></i>Từ ngày
                                            </label>
                                            <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted">
                                                <i class="fas fa-calendar-check me-1"></i>Đến ngày
                                            </label>
                                            <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                                        </div>
                                        <div class="col-12">
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-sm btn-dark">
                                                    <i class="fas fa-check me-1"></i>Áp dụng
                                                </button>
                                                <a href="@Url.Action("Search", "Home")" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-times me-1"></i>Xóa bộ lọc
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Active Filters Display -->
                @if (!string.IsNullOrEmpty(Model.Keyword) || Model.CategoryId.HasValue || Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    <div class="active-filters mb-3">
                        <span class="text-muted small me-2">Bộ lọc đang áp dụng:</span>
                        @if (!string.IsNullOrEmpty(Model.Keyword))
                        {
                            <span class="badge bg-dark me-1">
                                <i class="fas fa-search me-1"></i>@Model.Keyword
                                <a href="@Url.Action("Search", "Home", new { categoryId = Model.CategoryId, fromDate = Model.FromDate, toDate = Model.ToDate })" 
                                   class="text-white ms-1" style="text-decoration: none;">×</a>
                            </span>
                        }
                        @if (Model.CategoryId.HasValue)
                        {
                            var selectedCategory = Model.Categories.FirstOrDefault(c => c.CategoryId == Model.CategoryId);
                            if (selectedCategory != null)
                            {
                                <span class="badge bg-secondary me-1">
                                    <i class="fas fa-folder me-1"></i>@selectedCategory.CategoryName
                                    <a href="@Url.Action("Search", "Home", new { keyword = Model.Keyword, fromDate = Model.FromDate, toDate = Model.ToDate })" 
                                       class="text-white ms-1" style="text-decoration: none;">×</a>
                                </span>
                            }
                        }
                        @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
                        {
                            <span class="badge bg-secondary me-1">
                                <i class="fas fa-calendar me-1"></i>
                                @if (Model.FromDate.HasValue && Model.ToDate.HasValue)
                                {
                                    @Model.FromDate.Value.ToString("dd/MM/yyyy")
                                    <span> - </span>
                                    @Model.ToDate.Value.ToString("dd/MM/yyyy")
                                }
                                else if (Model.FromDate.HasValue)
                                {
                                    <span>Từ </span>@Model.FromDate.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span>Đến </span>@Model.ToDate.Value.ToString("dd/MM/yyyy")
                                }
                                <a href="@Url.Action("Search", "Home", new { keyword = Model.Keyword, categoryId = Model.CategoryId })" 
                                   class="text-white ms-1" style="text-decoration: none;">×</a>
                            </span>
                        }
                    </div>
                }

                <!-- Search Results Count -->
                <div class="search-results-info d-flex justify-content-between align-items-center mb-4">
                    <p class="text-muted mb-0">
                        <i class="fas fa-file-alt me-1 text-secondary"></i>
                        Tìm thấy <strong class="text-dark">@Model.TotalCount</strong> kết quả
                        @if (Model.TotalPages > 1)
                        {
                            <span class="ms-2">• Trang <strong>@Model.Page</strong>/<strong>@Model.TotalPages</strong></span>
                        }
                    </p>
                    @if (Model.Articles.Any())
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" title="Dạng lưới">
                                <i class="fas fa-th-large"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Dạng danh sách">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Search Results -->
    <div class="row">
        <div class="col-lg-8">
            @if (Model.Articles.Any())
            {
                <div class="search-results">
                    @foreach (var article in Model.Articles)
                    {
                        <div class="search-result-item mb-4 p-3 bg-white border rounded shadow-sm hover-shadow">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <a href="@Url.Action("Details", "Article", new { slug = article.Slug })">
                                        <div class="search-result-image">
                                            <img src="@(string.IsNullOrEmpty(article.ThumbnailImage) ? "/images/placeholder-article.jpg" : article.ThumbnailImage)" 
                                                 class="img-fluid w-100 rounded" alt="@article.Title">
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-8">
                                    <div class="mb-2">
                                        <span class="badge bg-dark">
                                            @article.Category.CategoryName
                                        </span>
                                        @if (article.ViewCount.HasValue && article.ViewCount > 0)
                                        {
                                            <span class="badge bg-light text-dark ms-1 border">
                                                <i class="fas fa-eye me-1"></i>@article.ViewCount
                                            </span>
                                        }
                                    </div>
                                    <h5 class="mb-2">
                                        <a href="@Url.Action("Details", "Article", new { slug = article.Slug })" class="text-dark text-decoration-none search-result-title">
                                            @article.Title
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-2 search-result-summary">@article.Summary</p>
                                    <div class="article-meta">
                                        <small class="text-muted">
                                            <i class="fas fa-user me-1"></i>@article.Author.FullName
                                            <span class="mx-2">•</span>
                                            <i class="fas fa-clock me-1"></i>@article.PublishedAt?.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Search results pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = Model.Page - 1 
                                    })">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = i 
                                    })">@i</a>
                                </li>
                            }
                            
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Search", "Home", new { 
                                        keyword = Model.Keyword, 
                                        categoryId = Model.CategoryId, 
                                        authorId = Model.AuthorId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), 
                                        toDate = Model.ToDate?.ToString("yyyy-MM-dd"), 
                                        page = Model.Page + 1 
                                    })">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="no-results text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-search fa-4x text-muted opacity-50"></i>
                    </div>
                    <h4 class="text-muted mb-3">Không tìm thấy kết quả nào</h4>
                    <p class="text-muted mb-4">Hãy thử tìm kiếm với từ khóa khác hoặc điều chỉnh bộ lọc</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="@Url.Action("Search", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-redo me-2"></i>Tìm kiếm mới
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-dark">
                            <i class="fas fa-home me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Popular Search Terms -->
            <div class="sidebar-widget mb-4">
                <div class="widget-header bg-dark text-white p-3 rounded-top d-flex align-items-center">
                    <i class="fas fa-hashtag me-2"></i>
                    <h6 class="mb-0 fw-bold">TỪ KHÓA PHỔ BIẾN</h6>
                </div>
                <div class="widget-content bg-white border border-top-0 rounded-bottom p-3">
                    <div class="popular-tags d-flex flex-wrap gap-2">
                        <a href="@Url.Action("Search", "Home", new { keyword = "văn hóa" })" class="badge bg-light text-dark border">văn hóa</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "du lịch" })" class="badge bg-light text-dark border">du lịch</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "ẩm thực" })" class="badge bg-light text-dark border">ẩm thực</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "lễ hội" })" class="badge bg-light text-dark border">lễ hội</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "truyền thống" })" class="badge bg-light text-dark border">truyền thống</a>
                        <a href="@Url.Action("Search", "Home", new { keyword = "kiến trúc" })" class="badge bg-light text-dark border">kiến trúc</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    /* Compact Search Styles */
    .compact-search-container {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    
    .compact-search-form .form-control,
    .compact-search-form .form-select {
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        padding: 0.6rem 1rem;
        transition: all 0.3s ease;
    }
    
    .compact-search-form .form-control:focus,
    .compact-search-form .form-select:focus {
        border-color: #495057;
        box-shadow: 0 0 0 0.2rem rgba(73, 80, 87, 0.15);
    }
    
    .compact-search-form .btn {
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-weight: 500;
    }
    
    /* Advanced Filters Card */
    #advancedFilters .card {
        border-radius: 10px;
        overflow: hidden;
    }
    
    #advancedFilters .form-control-sm {
        border-radius: 6px;
    }
    
    /* Active Filters */
    .active-filters .badge {
        font-size: 0.85rem;
        padding: 0.45rem 0.75rem;
        font-weight: 500;
        border-radius: 20px;
    }
    
    .active-filters .badge a {
        opacity: 0.8;
        font-weight: bold;
        transition: opacity 0.2s;
    }
    
    .active-filters .badge a:hover {
        opacity: 1;
    }
    
    /* Search Result Item */
    .search-result-item {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef !important;
    }
    
    .search-result-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.1) !important;
        border-color: #6c757d !important;
    }
    
    .search-result-image {
        overflow: hidden;
        border-radius: 8px;
        height: 180px;
    }
    
    .search-result-image img {
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    
    .search-result-item:hover .search-result-image img {
        transform: scale(1.1);
    }
    
    .search-result-title {
        font-weight: 600;
        line-height: 1.4;
        transition: color 0.3s ease;
    }
    
    .search-result-title:hover {
        color: #495057 !important;
    }
    
    .search-result-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.6;
    }
    
    /* Sidebar Widgets */
    .sidebar-widget {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    
    .widget-header h6 {
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }
    
    .popular-tags .badge {
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 500;
        padding: 0.5rem 0.85rem;
        font-size: 0.85rem;
    }
    
    .popular-tags .badge:hover {
        background-color: #343a40 !important;
        color: white !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(52, 58, 64, 0.3);
    }
    
    /* No Results */
    .no-results {
        background: white;
        border-radius: 12px;
        padding: 3rem 2rem !important;
    }
    
    /* Pagination */
    .pagination .page-link {
        border-radius: 6px;
        margin: 0 3px;
        border: 1px solid #dee2e6;
        color: #6c757d;
        transition: all 0.2s ease;
    }
    
    .pagination .page-item.active .page-link {
        background-color: #343a40;
        border-color: #343a40;
        box-shadow: 0 4px 8px rgba(52, 58, 64, 0.3);
    }
    
    .pagination .page-link:hover {
        color: #343a40;
        background-color: #fff;
        border-color: #343a40;
        transform: translateY(-2px);
    }
    
    /* Responsive */
    @@media (max-width: 768px) {
        .compact-search-container {
            padding: 1rem;
        }
        
        .search-result-image {
            height: 150px;
        }
        
        .compact-search-form .btn {
            margin-top: 0.5rem;
        }
    }
</style>
}