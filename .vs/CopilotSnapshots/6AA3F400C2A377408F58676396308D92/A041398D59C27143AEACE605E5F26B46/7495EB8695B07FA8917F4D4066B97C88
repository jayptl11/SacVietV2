@section Scripts {
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script>
        var canEdit = @(canEdit ? "true" : "false");
        
        CKEDITOR.replace('editor', {
            height: 450,
            filebrowserUploadUrl: '@Url.Action("UploadImage")',
            filebrowserUploadMethod: 'form',
            readOnly: !canEdit,
            toolbar: [
                { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview', 'Print', '-', 'Templates'] },
                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll', '-', 'SpellChecker', 'Scayt'] },
                { name: 'forms', items: ['Form', 'Checkbox', 'Radio', 'TextField', 'Textarea', 'Select', 'Button', 'ImageButton', 'HiddenField'] },
                '/',
                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', 'CreateDiv', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock', '-', 'BidiLtr', 'BidiRtl'] },
                { name: 'links', items: ['Link', 'Unlink', 'Anchor'] },
                { name: 'insert', items: ['Image', 'Flash', 'Table', 'HorizontalRule', 'Smiley', 'SpecialChar', 'PageBreak', 'Iframe', canEdit ? 'DriveVideo' : null].filter(Boolean) },
                '/',
                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                { name: 'colors', items: ['TextColor', 'BGColor'] },
                { name: 'tools', items: ['Maximize', 'ShowBlocks'] },
                { name: 'about', items: ['About'] }
            ],
            extraPlugins: canEdit ? 'driveVideo' : ''
        });

        // Custom Google Drive Video Plugin (only if can edit)
        if (canEdit) {
            CKEDITOR.plugins.add('driveVideo', {
                init: function(editor) {
                    editor.addCommand('insertDriveVideo', {
                        exec: function(editor) {
                            showDriveVideoDialog();
                        }
                    });

                    editor.ui.addButton('DriveVideo', {
                        label: 'Chèn video Google Drive',
                        command: 'insertDriveVideo',
                        toolbar: 'insert',
                        icon: 'data:image/svg+xml;base64,'
                    });
                }
            });
        }

        // Our dialog function
        function showDriveVideoDialog() {
            if (!canEdit) {
                console.log('❌ Cannot edit - dialog blocked');
                return;
            }
            
            console.log('🎬 Opening Google Drive Video dialog... (Edit mode)');
            
            // Create enhanced modal dialog instead of simple prompt
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.style.zIndex = '10001';
            modal.innerHTML = `
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="fab fa-google-drive me-2"></i>Chèn video Google Drive
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-4">
                                <h6><i class="fas fa-exclamation-triangle me-2"></i>Lưu ý quan trọng:</h6>
                                <ul class="mb-0 small">
                                    <li>Video phải được chia sẻ <strong>"Công khai"</strong> hoặc <strong>"Bất kỳ ai có liên kết"</strong></li>
                                    <li>Một số video có thể bị chặn nhúng bởi Google Drive</li>
                                    <li>Nên sử dụng YouTube hoặc Vimeo để có hiệu quả tốt nhất</li>
                                </ul>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-link me-2 text-danger"></i>Link Google Drive Video
                                </label>
                                <input type="url" id="driveVideoUrl" class="form-control form-control-lg" 
                                       placeholder="https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing">
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Dán link chia sẻ video từ Google Drive vào đây
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="fas fa-arrows-alt-h me-1"></i>Chiều rộng (px)
                                        </label>
                                        <input type="number" id="videoWidth" class="form-control" 
                                               value="640" min="300" max="1200">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="fas fa-arrows-alt-v me-1"></i>Chiều cao (px)
                                        </label>
                                        <input type="number" id="videoHeight" class="form-control" 
                                               value="360" min="200" max="800">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-heading me-1"></i>Tiêu đề video (tùy chọn)
                                </label>
                                <input type="text" id="videoTitle" class="form-control" 
                                       placeholder="Nhập tiêu đề mô tả cho video...">
                            </div>
                            
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="enableFallback" checked>
                                    <label class="form-check-label" for="enableFallback">
                                        <strong>Tạo link dự phòng</strong> (nếu video không hiển thị)
                                    </label>
                                </div>
                                <small class="text-muted">Sẽ tạo nút "Xem video" nếu không thể nhúng trực tiếp</small>
                            </div>
                            
                            <div id="videoPreview" class="mt-3" style="display: none;">
                                <h6><i class="fas fa-eye me-2"></i>Xem trước:</h6>
                                <div class="border p-2 rounded bg-light">
                                    <iframe id="previewFrame" frameborder="0" allowfullscreen class="w-100"></iframe>
                                </div>
                                <div id="previewError" class="alert alert-danger mt-2" style="display: none;">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    Không thể tải video. Có thể do video không được chia sẻ công khai hoặc Google Drive chặn nhúng.
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times me-1"></i>Hủy
                            </button>
                            <button type="button" class="btn btn-info" onclick="previewDriveVideoEnhanced()">
                                <i class="fas fa-eye me-1"></i>Xem trước
                            </button>
                            <button type="button" class="btn btn-danger" onclick="insertDriveVideoEnhanced()">
                                <i class="fas fa-plus me-1"></i>Chèn video
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            
            // Remove modal when closed
            modal.addEventListener('hidden.bs.modal', function() {
                document.body.removeChild(modal);
            });
            
            // Focus on URL input
            setTimeout(() => {
                document.getElementById('driveVideoUrl').focus();
            }, 500);
        }

        function previewDriveVideoEnhanced() {
            const url = document.getElementById('driveVideoUrl').value.trim();
            const width = document.getElementById('videoWidth').value || 640;
            const height = document.getElementById('videoHeight').value || 360;
            
            if (!url) {
                alert('⚠️ Vui lòng nhập link Google Drive video');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const fileId = extractGoogleDriveId(url);
            if (!fileId) {
                alert('❌ Link Google Drive không hợp lệ!\n\nVui lòng sử dụng link có định dạng:\nhttps://drive.google.com/file/d/YOUR_FILE_ID/view');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
            const previewFrame = document.getElementById('previewFrame');
            const previewDiv = document.getElementById('videoPreview');
            const errorDiv = document.getElementById('previewError');
            
            // Reset error state
            errorDiv.style.display = 'none';
            
            previewFrame.src = embedUrl;
            previewFrame.width = Math.min(width, 500);
            previewFrame.height = Math.min(height, 300);
            previewDiv.style.display = 'block';
            
            // Check if iframe loads successfully
            previewFrame.onload = function() {
                console.log('✅ Preview loaded successfully');
            };
            
            previewFrame.onerror = function() {
                console.log('❌ Preview failed to load');
                errorDiv.style.display = 'block';
            };
            
            // Scroll to preview
            previewDiv.scrollIntoView({ behavior: 'smooth' });
        }

        function insertDriveVideoEnhanced() {
            const url = document.getElementById('driveVideoUrl').value.trim();
            const width = document.getElementById('videoWidth').value || 640;
            const height = document.getElementById('videoHeight').value || 360;
            const title = document.getElementById('videoTitle').value.trim();
            const enableFallback = document.getElementById('enableFallback').checked;
            
            if (!url) {
                alert('⚠️ Vui lòng nhập link Google Drive video');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const fileId = extractGoogleDriveId(url);
            if (!fileId) {
                alert('❌ Link Google Drive không hợp lệ!\n\nVui lòng sử dụng link có định dạng:\nhttps://drive.google.com/file/d/YOUR_FILE_ID/view');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
            const directUrl = `https://drive.google.com/file/d/${fileId}/view`;
            
            // Enhanced video HTML with fallback
            let videoHtml = `
                <div class="drive-video-container" style="margin: 25px 0; padding: 20px; text-align: center; background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #e9ecef; position: relative;">
                    ${title ? `<h4 style="color: #dc3545; margin-bottom: 15px; font-weight: 600;">${title}</h4>` : ''}
                    
                    <!-- Primary embed iframe -->
                    <div class="video-embed-primary">
                        <iframe 
                            src="${embedUrl}" 
                            width="${width}" 
                            height="${height}" 
                            frameborder="0" 
                            allowfullscreen="true"
                            style="border-radius: 10px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); max-width: 100%;"
                            onload="console.log('✅ Drive video loaded successfully')"
                            onerror="console.log('❌ Drive video failed to load'); this.style.display='none'; document.querySelector('.video-fallback-${fileId}').style.display='block';">
                        </iframe>
                    </div>
                    
                    ${enableFallback ? `
                    <!-- Fallback button if iframe fails -->
                    <div class="video-fallback-${fileId}" style="display: none; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background: #fff5f5;">
                        <div style="margin-bottom: 15px;">
                            <i class="fas fa-exclamation-triangle" style="color: #dc3545; font-size: 2rem; margin-bottom: 10px;"></i>
                            <p style="color: #dc3545; margin: 10px 0; font-weight: 500;">Video không thể hiển thị trực tiếp</p>
                            <p style="color: #6c757d; margin: 5px 0; font-size: 14px;">Có thể do cài đặt quyền riêng tư của Google Drive</p>
                        </div>
                        <a href="${directUrl}" target="_blank" class="btn btn-danger btn-lg" style="margin: 10px 0; padding: 12px 24px; font-weight: 600; text-decoration: none; border-radius: 8px;">
                            <i class="fab fa-google-drive me-2"></i>Xem video trên Google Drive
                        </a>
                    </div>
                    ` : ''}
                    
                    <!-- Footer info -->
                    <p style="margin-top: 15px; color: #6c757d; font-size: 12px; margin-bottom: 0;">
                        <i class="fab fa-google-drive" style="color: #4285f4; margin-right: 8px;"></i>
                        Video từ Google Drive
                        ${enableFallback ? ' • Có link dự phòng' : ''}
                    </p>
                    
                    <!-- Retry script -->
                    <script>
                        // Retry mechanism for failed iframe
                        setTimeout(function() {
                            var iframe = document.querySelector('.drive-video-container iframe[src*="${fileId}"]');
                            if (iframe && iframe.style.display !== 'none') {
                                try {
                                    // Try to access iframe content to detect blocking
                                    iframe.contentDocument;
                                } catch(e) {
                                    console.log('🔄 Iframe blocked, showing fallback');
                                    iframe.style.display = 'none';
                                    var fallback = document.querySelector('.video-fallback-${fileId}');
                                    if (fallback) fallback.style.display = 'block';
                                }
                            }
                        }, 3000);
                    </script>
                </div>
            `;
            
            // Insert into editor
            if (CKEDITOR.instances.editor) {
                CKEDITOR.instances.editor.insertHtml(videoHtml);
                
                // Close modal
                const modal = document.querySelector('.modal.show');
                if (modal) {
                    bootstrap.Modal.getInstance(modal).hide();
                }
                
                // Show success message with instructions
                setTimeout(() => {
                    alert('✅ Đã chèn video Google Drive!\n\n💡 Mẹo:\n- Nếu video không hiển thị, hãy đảm bảo video được chia sẻ công khai\n- Có thể sử dụng nút "Xem video" nếu không thể nhúng trực tiếp');
                }, 300);
            } else {
                alert('❌ Lỗi: Không thể kết nối với trình soạn thảo');
            }
        }
