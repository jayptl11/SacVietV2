@model SacViet.ViewModels.ArticleCreateViewModel
@{
    ViewData["Title"] = "Tạo bài viết mới";
    var categories = ViewBag.Categories as IEnumerable<SacViet.Models.Category>;
}

<div class="create-article-container">
    <!-- Page Header -->
    <div class="page-header-bar mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">
                    <i class="fas fa-plus-circle text-primary me-2"></i>
                    Tạo bài viết mới
                </h2>
                <p class="page-subtitle mb-0">
                    <i class="fas fa-pen me-2"></i>
                    Bắt đầu viết câu chuyện của bạn
                </p>
            </div>
            <div>
                <a href="@Url.Action("MyArticles")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Content Card -->
                <div class="content-card mb-4">
                    <div class="content-card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-file-alt text-primary me-2"></i>
                            Nội dung bài viết
                        </h5>
                    </div>
                    <div class="content-card-body">
                        <!-- Title -->
                        <div class="form-group-modern mb-4">
                            <label asp-for="Title" class="form-label-modern">
                                <i class="fas fa-heading me-2"></i>Tiêu đề <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control-modern"
                                   placeholder="Nhập tiêu đề hấp dẫn cho bài viết..." />
                            <span asp-validation-for="Title" class="validation-message"></span>
                            <small class="form-hint">Tiêu đề nên ngắn gọn, súc tích và thu hút</small>
                        </div>

                        <!-- Summary -->
                        <div class="form-group-modern mb-4">
                            <label asp-for="Summary" class="form-label-modern">
                                <i class="fas fa-align-left me-2"></i>Tóm tắt
                            </label>
                            <textarea asp-for="Summary" class="form-control-modern" rows="3"
                                      placeholder="Viết tóm tắt ngắn gọn về nội dung bài viết..."></textarea>
                            <span asp-validation-for="Summary" class="validation-message"></span>
                            <small class="form-hint">Tóm tắt giúp người đọc nắm nhanh nội dung</small>
                        </div>

                        <!-- Content -->
                        <div class="form-group-modern">
                            <label asp-for="Content" class="form-label-modern">
                                <i class="fas fa-paragraph me-2"></i>Nội dung <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Content" id="editor" class="form-control-modern" rows="10"></textarea>
                            <span asp-validation-for="Content" class="validation-message"></span>
                        </div>
                    </div>
                </div>

                <!-- Tips Card -->
                <div class="tips-card-horizontal">
                    <div class="tips-icon">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <div class="tips-content">
                        <h6>Mẹo viết bài hiệu quả</h6>
                        <p>• Dùng tiêu đề ngắn gọn, dễ hiểu • Chia nhỏ đoạn văn • Thêm hình ảnh minh họa</p>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Actions Card -->
                <div class="action-card mb-4">
                    <div class="action-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-cog me-2"></i>Hành động
                        </h6>
                    </div>
                    <div class="action-card-body">
                        <button type="submit" name="action" value="submit" class="action-btn action-btn-primary">
                            <i class="fas fa-paper-plane"></i>
                            <div>
                                <strong>Gửi để duyệt</strong>
                                <small>Gửi cho Admin xét duyệt</small>
                            </div>
                        </button>
                        <button type="submit" name="action" value="draft" class="action-btn action-btn-secondary">
                            <i class="fas fa-save"></i>
                            <div>
                                <strong>Lưu nháp</strong>
                                <small>Lưu để chỉnh sửa sau</small>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- Category Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-folder text-warning me-2"></i>Danh mục
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        <select asp-for="CategoryId" class="form-select-modern">
                            <option value="">-- Chọn danh mục --</option>
                            @if (categories != null)
                            {
                                @foreach (var category in categories.Where(c => c.ParentCategoryId == null))
                                {
                                    <option value="@category.CategoryId">📁 @category.CategoryName</option>

                                    @foreach (var subCategory in categories.Where(c => c.ParentCategoryId == category.CategoryId))
                                    {
                                        <option value="@subCategory.CategoryId">  └─ @subCategory.CategoryName</option>
                                    }
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="validation-message"></span>
                    </div>
                </div>

                <!-- Thumbnail Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-image text-info me-2"></i>Ảnh đại diện
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        <div id="thumbnail-preview" class="thumbnail-preview" style="display: none;">
                            <img id="thumbnail-img" src="" alt="Thumbnail" />
                            <button type="button" class="btn-remove-thumbnail" onclick="removeThumbnail()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div id="thumbnail-upload" class="thumbnail-upload">
                            <div class="upload-area" onclick="document.getElementById('thumbnail-file').click()">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Chọn ảnh hoặc kéo thả vào đây</p>
                                <small>JPG, PNG, GIF (Max 5MB)</small>
                            </div>
                            <input type="file" id="thumbnail-file" accept="image/*" style="display: none;" onchange="uploadThumbnail()" />
                        </div>
                        <input type="hidden" asp-for="ThumbnailImage" id="thumbnail-url" />
                    </div>
                </div>

                <!-- Scheduled Publish Card -->
                <div class="sidebar-card mb-4">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-clock text-success me-2"></i>Hẹn giờ đăng
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        <input asp-for="ScheduledPublishDate" type="datetime-local" class="form-control-modern" />
                        <small class="form-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Bài viết sẽ tự động đăng sau khi duyệt
                        </small>
                    </div>
                </div>

                <!-- Tags Card -->
                <div class="sidebar-card">
                    <div class="sidebar-card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-tags text-danger me-2"></i>Thẻ Tags
                        </h6>
                    </div>
                    <div class="sidebar-card-body">
                        <input type="text" id="tags-input" class="form-control-modern"
                               placeholder="Nhập tag và nhấn Enter..." />
                        <div id="tags-container" class="tags-container mt-3"></div>
                        <small class="form-hint">
                            <i class="fas fa-keyboard me-1"></i>
                            Nhấn Enter để thêm tag
                        </small>
                    </div>
                </div>
            </div>
        </div>

        @Html.AntiForgeryToken()
    </form>
</div>

<style>
    .create-article-container {
        padding: 1.5rem;
        background: #f8f9fa;
        min-height: 100vh;
    }

    .page-header-bar {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #6c757d;
        font-size: 0.95rem;
    }

    /* Content Card */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .content-card-header {
        padding: 1.25rem;
        border-bottom: 1px solid #e9ecef;
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }

        .content-card-header h5 {
            font-size: 1.125rem;
            font-weight: 600;
            color: #2c3e50;
        }

    .content-card-body {
        padding: 1.5rem;
    }

    /* Form Modern */
    .form-group-modern {
        margin-bottom: 1.5rem;
    }

    .form-label-modern {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s;
        width: 100%;
    }

        .form-control-modern:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
            outline: none;
        }

        .form-control-modern::placeholder {
            color: #adb5bd;
        }

    .form-select-modern {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s;
        width: 100%;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 16px 12px;
        padding-right: 3rem;
    }

        .form-select-modern:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
            outline: none;
        }

    .validation-message {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: #dc3545;
    }

    .form-hint {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #6c757d;
    }

    /* Tips Card Horizontal */
    .tips-card-horizontal {
        background: linear-gradient(135deg, #fff9e6 0%, #ffffff 100%);
        border-left: 4px solid #ffc107;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: start;
        gap: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .tips-icon {
        width: 50px;
        height: 50px;
        background: #ffc107;
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .tips-content h6 {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .tips-content p {
        font-size: 0.875rem;
        color: #6c757d;
        margin: 0;
        line-height: 1.6;
    }

    /* Action Card */
    .action-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .action-card-header {
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }

        .action-card-header h6 {
            font-size: 0.95rem;
            font-weight: 600;
            color: #2c3e50;
        }

    .action-card-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border: 2px solid;
        border-radius: 10px;
        background: transparent;
        cursor: pointer;
        transition: all 0.3s;
        text-align: left;
        width: 100%;
    }

        .action-btn i {
            font-size: 1.5rem;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .action-btn strong {
            display: block;
            font-size: 0.95rem;
            margin-bottom: 0.25rem;
        }

        .action-btn small {
            display: block;
            font-size: 0.8rem;
            opacity: 0.8;
        }

    .action-btn-primary {
        border-color: #0d6efd;
        color: #0d6efd;
    }

        .action-btn-primary i {
            background: rgba(13, 110, 253, 0.1);
        }

        .action-btn-primary:hover {
            background: #0d6efd;
            color: white;
        }

            .action-btn-primary:hover i {
                background: rgba(255, 255, 255, 0.2);
            }

    .action-btn-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

        .action-btn-secondary i {
            background: rgba(108, 117, 125, 0.1);
        }

        .action-btn-secondary:hover {
            background: #6c757d;
            color: white;
        }

            .action-btn-secondary:hover i {
                background: rgba(255, 255, 255, 0.2);
            }

    /* Sidebar Card */
    .sidebar-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .sidebar-card-header {
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
        background: #f8f9fa;
    }

        .sidebar-card-header h6 {
            font-size: 0.95rem;
            font-weight: 600;
            color: #2c3e50;
        }

    .sidebar-card-body {
        padding: 1rem;
    }

    /* Thumbnail */
    .thumbnail-preview {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
    }

        .thumbnail-preview img {
            width: 100%;
            height: auto;
            display: block;
        }

    .btn-remove-thumbnail {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(220, 53, 69, 0.9);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

        .btn-remove-thumbnail:hover {
            background: #dc3545;
            transform: scale(1.1);
        }

    .upload-area {
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        padding: 2rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .upload-area:hover {
            border-color: #0d6efd;
            background: #f8f9fa;
        }

        .upload-area i {
            font-size: 3rem;
            color: #adb5bd;
            margin-bottom: 0.5rem;
        }

        .upload-area p {
            font-size: 0.95rem;
            color: #6c757d;
            margin: 0.5rem 0;
        }

        .upload-area small {
            font-size: 0.8rem;
            color: #adb5bd;
        }

    /* Tags */
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        background: #0d6efd;
        color: white;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

        .tag-badge i {
            cursor: pointer;
            transition: transform 0.2s;
        }

            .tag-badge i:hover {
                transform: scale(1.2);
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .create-article-container

    {
        padding: 1rem;
    }

    .page-title {
        font-size: 1.5rem;
    }

    }
</style>

@section Scripts {
    <!-- Load CKEditor -->
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script>
        // Define the plugin BEFORE initializing CKEditor
        CKEDITOR.plugins.add('driveVideo', {
            init: function(editor) {
                // Add the command
                editor.addCommand('insertDriveVideo', {
                    exec: function(editor) {
                        showDriveVideoDialog();
                    }
                });

                // Add the button
                editor.ui.addButton('DriveVideo', {
                    label: 'Chèn video Google Drive',
                    command: 'insertDriveVideo',
                    toolbar: 'insert',
                    icon: 'data:image/svg+xml;charset=utf-8,%3Csvg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="%23333" viewBox="0 0 16 16"%3E%3Cpath d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"/%3E%3C/svg%3E'
                });
            }
        });

        // Initialize CKEditor AFTER plugin is defined
        document.addEventListener('DOMContentLoaded', function() {
            CKEDITOR.replace('editor', {
                height: 450,
                filebrowserUploadUrl: '@Url.Action("UploadImage")',
                filebrowserImageUploadUrl: '@Url.Action("UploadImage")',
                filebrowserUploadMethod: 'form',
                toolbar: [
                    { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview', 'Print'] },
                    { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                    { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                    '/',
                    { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                    { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', 'CreateDiv', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock'] },
                    { name: 'links', items: ['Link', 'Unlink', 'Anchor'] },
                    { name: 'insert', items: ['Image', 'Table', 'HorizontalRule', 'Smiley', 'SpecialChar', 'PageBreak', 'Iframe', 'DriveVideo'] },
                    '/',
                    { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                    { name: 'colors', items: ['TextColor', 'BGColor'] },
                    { name: 'tools', items: ['Maximize', 'ShowBlocks'] }
                ],
                extraPlugins: 'driveVideo',
                removePlugins: 'flash' // Remove flash plugin to avoid conflicts
            });
        });

        function showDriveVideoDialog() {
            // Create modal dialog
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.style.zIndex = '10001';
            modal.innerHTML = `
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="fab fa-google-drive me-2"></i>Chèn video Google Drive
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-info mb-4">
                                <h6><i class="fas fa-lightbulb me-2"></i>Hướng dẫn:</h6>
                                <ol class="mb-0 small">
                                    <li>Mở video trên Google Drive</li>
                                    <li>Click chuột phải → <strong>Chia sẻ</strong></li>
                                    <li>Chọn "<strong>Bất kỳ ai có liên kết</strong>"</li>
                                    <li>Copy link và dán vào ô bên dưới</li>
                                </ol>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-link me-2 text-danger"></i>Link Google Drive Video
                                </label>
                                <input type="url" id="driveVideoUrl" class="form-control form-control-lg" 
                                       placeholder="https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing">
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Dán link chia sẻ video từ Google Drive vào đây
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="fas fa-arrows-alt-h me-1"></i>Chiều rộng (px)
                                        </label>
                                        <input type="number" id="videoWidth" class="form-control" 
                                               value="640" min="300" max="1200">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="fas fa-arrows-alt-v me-1"></i>Chiều cao (px)
                                        </label>
                                        <input type="number" id="videoHeight" class="form-control" 
                                               value="360" min="200" max="800">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-heading me-1"></i>Tiêu đề video (tùy chọn)
                                </label>
                                <input type="text" id="videoTitle" class="form-control" 
                                       placeholder="Nhập tiêu đề mô tả cho video...">
                            </div>
                            
                            <div id="videoPreview" class="mt-3" style="display: none;">
                                <h6><i class="fas fa-eye me-2"></i>Xem trước:</h6>
                                <div class="border p-2 rounded bg-light">
                                    <iframe id="previewFrame" frameborder="0" allowfullscreen class="w-100"></iframe>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times me-1"></i>Hủy
                            </button>
                            <button type="button" class="btn btn-info" onclick="previewDriveVideo()">
                                <i class="fas fa-eye me-1"></i>Xem trước
                            </button>
                            <button type="button" class="btn btn-danger" onclick="insertDriveVideo()">
                                <i class="fas fa-plus me-1"></i>Chèn video
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            
            // Remove modal when closed
            modal.addEventListener('hidden.bs.modal', function() {
                document.body.removeChild(modal);
            });
            
            // Focus on URL input
            setTimeout(() => {
                document.getElementById('driveVideoUrl').focus();
            }, 500);
        }

        function extractGoogleDriveId(url) {
            const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
            return match ? match[1] : null;
        }

        function previewDriveVideo() {
            const url = document.getElementById('driveVideoUrl').value.trim();
            const width = document.getElementById('videoWidth').value || 640;
            const height = document.getElementById('videoHeight').value || 360;
            
            if (!url) {
                alert('⚠️ Vui lòng nhập link Google Drive video');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const fileId = extractGoogleDriveId(url);
            if (!fileId) {
                alert('❌ Link Google Drive không hợp lệ!\n\nVui lòng sử dụng link có định dạng:\nhttps://drive.google.com/file/d/YOUR_FILE_ID/view');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
            const previewFrame = document.getElementById('previewFrame');
            const previewDiv = document.getElementById('videoPreview');
            
            previewFrame.src = embedUrl;
            previewFrame.width = Math.min(width, 500); // Limit preview size
            previewFrame.height = Math.min(height, 300);
            previewDiv.style.display = 'block';
            
            // Scroll to preview
            previewDiv.scrollIntoView({ behavior: 'smooth' });
        }

        function insertDriveVideo() {
            const url = document.getElementById('driveVideoUrl').value.trim();
            const width = document.getElementById('videoWidth').value || 640;
            const height = document.getElementById('videoHeight').value || 360;
            const title = document.getElementById('videoTitle').value.trim();
            
            if (!url) {
                alert('⚠️ Vui lòng nhập link Google Drive video');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const fileId = extractGoogleDriveId(url);
            if (!fileId) {
                alert('❌ Link Google Drive không hợp lệ!\n\nVui lòng sử dụng link có định dạng:\nhttps://drive.google.com/file/d/YOUR_FILE_ID/view');
                document.getElementById('driveVideoUrl').focus();
                return;
            }
            
            const embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
            
            let videoHtml = `
                <div class="drive-video-container" style="margin: 25px 0; padding: 20px; text-align: center; background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #e9ecef;">
                    ${title ? `<h4 style="margin-bottom: 20px; color: #2c3e50; font-weight: 600;">${title}</h4>` : ''}
                    <iframe 
                        src="${embedUrl}" 
                        width="${width}" 
                        height="${height}" 
                        frameborder="0" 
                        allowfullscreen="true"
                        style="border-radius: 10px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); max-width: 100%;">
                    </iframe>
                    <p style="margin-top: 15px; color: #6c757d; font-size: 13px; margin-bottom: 0;">
                        <i class="fab fa-google-drive" style="color: #4285f4; margin-right: 8px;"></i>
                        Video từ Google Drive
                    </p>
                </div>
            `;
            
            // Insert into CKEditor
            if (CKEDITOR.instances.editor) {
                CKEDITOR.instances.editor.insertHtml(videoHtml);
                
                // Close modal
                const modal = document.querySelector('.modal.show');
                if (modal) {
                    bootstrap.Modal.getInstance(modal).hide();
                }
                
                // Show success message
                setTimeout(() => {
                    alert('✅ Đã chèn video Google Drive thành công!');
                }, 300);
            } else {
                alert('❌ Lỗi: Không thể kết nối với trình soạn thảo');
            }
        }

        // Upload Thumbnail
        function uploadThumbnail() {
            const fileInput = document.getElementById('thumbnail-file');
            const file = fileInput.files[0];

            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                alert('Ảnh quá lớn! Vui lòng chọn ảnh nhỏ hơn 5MB');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            fetch('@Url.Action("UploadImage")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('thumbnail-url').value = data.url;
                    document.getElementById('thumbnail-img').src = data.url;
                    document.getElementById('thumbnail-preview').style.display = 'block';
                    document.getElementById('thumbnail-upload').style.display = 'none';
                } else {
                    alert(data.message || 'Upload thất bại');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi upload ảnh');
            });
        }

        // Remove Thumbnail
        function removeThumbnail() {
            document.getElementById('thumbnail-url').value = '';
            document.getElementById('thumbnail-img').src = '';
            document.getElementById('thumbnail-preview').style.display = 'none';
            document.getElementById('thumbnail-upload').style.display = 'block';
            document.getElementById('thumbnail-file').value = '';
        }

        // Tags Management
        let tags = [];
        const tagsInput = document.getElementById('tags-input');
        const tagsContainer = document.getElementById('tags-container');

        if (tagsInput) {
            tagsInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const tag = this.value.trim();
                    if (tag && !tags.includes(tag)) {
                        tags.push(tag);
                        renderTags();
                        this.value = '';
                    }
                }
            });
        }

        function renderTags() {
            if (tagsContainer) {
                tagsContainer.innerHTML = '';
                tags.forEach((tag, index) => {
                    const badge = document.createElement('span');
                    badge.className = 'tag-badge';
                    badge.innerHTML = `
                        ${tag}
                        <i class="fas fa-times" onclick="removeTag(${index})"></i>
                        <input type="hidden" name="Tags" value="${tag}" />
                    `;
                    tagsContainer.appendChild(badge);
                });
            }
        }

        function removeTag(index) {
            tags.splice(index, 1);
            renderTags();
        }

        // Update CKEditor content before form submission
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('form')?.addEventListener('submit', function(e) {
                for (var instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
            });
        });
    </script>
}