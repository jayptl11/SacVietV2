@section Scripts {
    <script src="https://cdn.ckeditor.com/4.20.1/standard/ckeditor.js"></script>
    <script>
        var canEdit = @(canEdit ? "true" : "false");
        console.log('🚀 Loading CKEditor (Edit mode)... canEdit =', canEdit);
        
        // Wait for DOM to be ready
        document.addEventListener('DOMContentLoaded', function() {
            console.log('✅ DOM Ready - Initializing CKEditor...');
            
            // Build toolbar based on edit permissions
            let toolbar = [
                ['Bold', 'Italic', 'Underline'],
                ['NumberedList', 'BulletedList'],
                ['Link', 'Unlink'],
                ['Image', 'Table'],
                ['Source']
            ];
            
            // Add Google Drive Video button only if user can edit
            if (canEdit) {
                toolbar[3].push('GoogleDriveVideo'); // Add to the Image, Table row
                console.log('✅ Adding Google Drive Video button to toolbar');
            }
            
            // Initialize CKEditor
            CKEDITOR.replace('editor', {
                height: 450,
                filebrowserUploadUrl: '@Url.Action("UploadImage")',
                filebrowserUploadMethod: 'form',
                readOnly: !canEdit,
                
                toolbar: toolbar,
                
                // Add plugin only if can edit
                extraPlugins: canEdit ? 'googledrivevideo' : '',
                
                on: {
                    instanceReady: function(evt) {
                        console.log('✅ CKEditor instance ready! (Edit mode)');
                        console.log('ReadOnly mode:', !canEdit);
                        
                        if (canEdit) {
                            console.log('Available commands:', Object.keys(evt.editor.commands));
                            const toolbar = evt.editor.ui.items;
                            console.log('Toolbar items:', Object.keys(toolbar));
                            
                            if (toolbar.GoogleDriveVideo) {
                                console.log('✅ Google Drive Video button found in toolbar!');
                            } else {
                                console.error('❌ Google Drive Video button NOT found in toolbar!');
                            }
                        }
                    }
                }
            });
        });

        // Define our custom plugin (only if can edit)
        if (canEdit) {
            CKEDITOR.plugins.add('googledrivevideo', {
                icons: 'googledrivevideo',
                init: function(editor) {
                    console.log('🎬 Initializing Google Drive Video plugin... (Edit mode)');
                    
                    // Add command
                    editor.addCommand('insertGoogleDriveVideo', {
                        exec: function(editor) {
                            console.log('🎬 Google Drive Video button clicked! (Edit mode)');
                            showDriveVideoDialog();
                        }
                    });

                    // Add button to toolbar
                    editor.ui.addButton('GoogleDriveVideo', {
                        label: '🎬 Chèn Video Google Drive',
                        command: 'insertGoogleDriveVideo',
                        toolbar: 'insert',
                        icon: this.path + 'icons/googledrivevideo.png'
                    });
                    
                    console.log('✅ Google Drive Video plugin initialized! (Edit mode)');
                }
            });
        }

        // Our dialog function
        function showDriveVideoDialog() {
            if (!canEdit) {
                console.log('❌ Cannot edit - dialog blocked');
                return;
            }
            
            console.log('🎬 Opening Google Drive Video dialog... (Edit mode)');
            
            // Simple prompt for now to test if button works
            const url = prompt('Nhập link Google Drive video:\n(Định dạng: https://drive.google.com/file/d/FILE_ID/view)');
            
            if (!url) {
                console.log('❌ No URL provided');
                return;
            }
            
            console.log('📹 Processing URL:', url);
            
            // Extract file ID
            const fileId = extractGoogleDriveId(url);
            if (!fileId) {
                alert('❌ Link Google Drive không hợp lệ!\n\nVui lòng sử dụng link có định dạng:\nhttps://drive.google.com/file/d/FILE_ID/view');
                return;
            }
            
            console.log('📹 File ID extracted:', fileId);
            
            // Create embed URL and HTML
            const embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
            const videoHtml = `
                <div class="drive-video-container" style="margin: 25px 0; padding: 20px; text-align: center; background: #f8f9fa; border-radius: 12px; border: 2px solid #dc3545;">
                    <h4 style="color: #dc3545; margin-bottom: 15px;">📹 Video Google Drive</h4>
                    <iframe 
                        src="${embedUrl}" 
                        width="640" 
                        height="360" 
                        frameborder="0" 
                        allowfullscreen="true"
                        style="border-radius: 8px; max-width: 100%">
                    </iframe>
                    <p style="margin-top: 10px; color: #6c757d; font-size: 12px;">
                        🎬 Video từ Google Drive
                    </p>
                </div>
            `;
            
            // Insert into editor
            CKEDITOR.instances.editor.insertHtml(videoHtml);
            
            console.log('✅ Video inserted successfully! (Edit mode)');
            alert('✅ Đã chèn video Google Drive thành công!');
        }

        function extractGoogleDriveId(url) {
            const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
            return match ? match[1] : null;
        }

        function uploadThumbnail() {
            if (!canEdit) return;
            
            const fileInput = document.getElementById('thumbnail-file');
            const file = fileInput.files[0];

            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                alert('Ảnh quá lớn! Vui lòng chọn ảnh nhỏ hơn 5MB');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            fetch('@Url.Action("UploadImage")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('thumbnail-url').value = data.url;
                    document.getElementById('thumbnail-img').src = data.url;
                    document.getElementById('thumbnail-preview').style.display = 'block';
                    document.getElementById('thumbnail-upload').style.display = 'none';
                } else {
                    alert(data.message || 'Upload thất bại');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi upload ảnh');
            });
        }

        function removeThumbnail() {
            if (!canEdit) return;
            
            document.getElementById('thumbnail-url').value = '';
            document.getElementById('thumbnail-img').src = '';
            document.getElementById('thumbnail-preview').style.display = 'none';
            document.getElementById('thumbnail-upload').style.display = 'block';
            document.getElementById('thumbnail-file').value = '';
        }

        let tags = @Html.Raw(Json.Serialize(Model.Tags ?? new List<string>()));
        const tagsInput = document.getElementById('tags-input');
        const tagsContainer = document.getElementById('tags-container');

        if (tagsInput && canEdit) {
            tagsInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const tag = this.value.trim();
                    if (tag && !tags.includes(tag)) {
                        tags.push(tag);
                        renderTags();
                        this.value = '';
                    }
                }
            });
        }

        function renderTags() {
            if (tagsContainer) {
                tagsContainer.innerHTML = '';
                tags.forEach((tag, index) => {
                    const badge = document.createElement('span');
                    badge.className = 'tag-badge';
                    badge.innerHTML = `
                        ${tag}
                        ${canEdit ? `<i class="fas fa-times" onclick="removeTag(${index})"></i>` : ''}
                        <input type="hidden" name="Tags" value="${tag}" />
                    `;
                    tagsContainer.appendChild(badge);
                });
            }
        }

        function removeTag(index) {
            if (!canEdit) return;
            tags.splice(index, 1);
            renderTags();
        }

        renderTags();

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('form')?.addEventListener('submit', function(e) {
                for (var instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
            });
        });
    </script>
}
