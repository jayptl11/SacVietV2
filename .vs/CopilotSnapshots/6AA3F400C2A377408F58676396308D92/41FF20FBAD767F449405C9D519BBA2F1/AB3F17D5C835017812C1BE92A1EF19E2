@model AdminArticleDetailViewModel
@{
    ViewData["Title"] = "Chi tiết bài viết - " + Model.Title;
}

<div class="article-detail-container">
    <!-- Header -->
    <div class="article-header mb-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="article-title mb-2">@Model.Title</h1>
                <div class="article-meta d-flex flex-wrap gap-3">
                    <span class="meta-item">
                        <i class="fas fa-user"></i>
                        @Model.AuthorName
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-folder"></i>
                        @Model.CategoryName
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-calendar"></i>
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-eye"></i>
                        @Model.ViewCount.ToString("N0") lượt xem
                    </span>
                </div>
            </div>
            <div class="article-actions">
                <a href="@Url.Action("Articles")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
                @if (Model.Status == "Published")
                {
                    <a href="@Url.Action("Details", "Article", new { slug = Model.Slug })" 
                       target="_blank" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-external-link-alt me-1"></i>Xem công khai
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Article Status -->
            <div class="status-card mb-4">
                <div class="status-header">
                    <h5>
                        <i class="fas fa-info-circle me-2"></i>
                        Trạng thái bài viết
                    </h5>
                </div>
                <div class="status-body">
                    <div class="current-status">
                        @switch (Model.Status)
                        {
                            case "Draft":
                                <span class="badge badge-draft">
                                    <i class="fas fa-edit"></i>Nháp
                                </span>
                                break;
                            case "Pending":
                                <span class="badge badge-pending">
                                    <i class="fas fa-clock"></i>Chờ duyệt
                                </span>
                                break;
                            case "Approved":
                                <span class="badge badge-approved">
                                    <i class="fas fa-check-double"></i>Đã duyệt
                                </span>
                                break;
                            case "Published":
                                <span class="badge badge-published">
                                    <i class="fas fa-check-circle"></i>Đã đăng
                                </span>
                                break;
                            case "Rejected":
                                <span class="badge badge-rejected">
                                    <i class="fas fa-times-circle"></i>Từ chối
                                </span>
                                break;
                        }
                        
                        @if (Model.PublishedAt.HasValue)
                        {
                            <small class="text-muted ms-2">
                                Đăng lúc: @Model.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        }
                        
                        @if (Model.ScheduledPublishDate.HasValue && Model.Status == "Approved")
                        {
                            <div class="scheduled-info mt-2">
                                <i class="fas fa-clock text-info"></i>
                                <small class="text-info">
                                    Hẹn đăng: @Model.ScheduledPublishDate?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        }
                    </div>

                    @if (Model.Status == "Pending")
                    {
                        <div class="action-buttons mt-3">
                            <button class="btn btn-success btn-sm me-2" onclick="approveArticle(@Model.ArticleId)">
                                <i class="fas fa-check me-1"></i>Duyệt bài
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="rejectArticle(@Model.ArticleId)">
                                <i class="fas fa-times me-1"></i>Từ chối
                            </button>
                        </div>
                    }
                    @if (Model.Status == "Published")
                    {
                        <div class="action-buttons mt-3">
                            <button class="btn btn-warning btn-sm" onclick="unpublishArticle(@Model.ArticleId)">
                                <i class="fas fa-eye-slash me-1"></i>Gỡ bài
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Thumbnail -->
            @if (!string.IsNullOrEmpty(Model.ThumbnailImage))
            {
                <div class="thumbnail-section mb-4">
                    <h5>
                        <i class="fas fa-image me-2"></i>
                        Ảnh đại diện
                    </h5>
                    <div class="thumbnail-container">
                        <img src="@Model.ThumbnailImage" alt="@Model.Title" class="img-fluid rounded">
                    </div>
                </div>
            }

            <!-- Summary -->
            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <div class="summary-section mb-4">
                    <h5>
                        <i class="fas fa-align-left me-2"></i>
                        Tóm tắt
                    </h5>
                    <div class="summary-content">
                        @Model.Summary
                    </div>
                </div>
            }

            <!-- Content -->
            <div class="content-section">
                <h5>
                    <i class="fas fa-file-alt me-2"></i>
                    Nội dung
                </h5>
                <div class="content-body">
                    @Html.Raw(Model.Content)
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Author Info -->
            <div class="info-card mb-4">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-user me-2"></i>
                        Thông tin tác giả
                    </h6>
                </div>
                <div class="card-body">
                    <div class="author-info">
                        <div class="d-flex align-items-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.AuthorAvatar))
                            {
                                <img src="@Model.AuthorAvatar" alt="@Model.AuthorName" class="avatar me-3">
                            }
                            else
                            {
                                <div class="avatar-placeholder me-3">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                            <div>
                                <div class="author-name">@Model.AuthorName</div>
                                <div class="author-email text-muted">@Model.AuthorEmail</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Article Info -->
            <div class="info-card mb-4">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-info-circle me-2"></i>
                        Thông tin bài viết
                    </h6>
                </div>
                <div class="card-body">
                    <div class="info-list">
                        <div class="info-item">
                            <span class="label">ID:</span>
                            <span class="value">#@Model.ArticleId</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Slug:</span>
                            <span class="value">@Model.Slug</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Danh mục:</span>
                            <span class="value">@Model.CategoryName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Tạo lúc:</span>
                            <span class="value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="info-item">
                                <span class="label">Cập nhật:</span>
                                <span class="value">@Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Approval History -->
            @if (Model.ApprovalHistory.Any())
            {
                <div class="info-card">
                    <div class="card-header">
                        <h6>
                            <i class="fas fa-history me-2"></i>
                            Lịch sử duyệt
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="approval-history">
                            @foreach (var history in Model.ApprovalHistory)
                            {
                                <div class="history-item">
                                    <div class="history-header">
                                        <span class="history-status">
                                            @switch (history.Status)
                                            {
                                                case "Pending":
                                                    <i class="fas fa-clock text-warning"></i>
                                                    break;
                                                case "Approved":
                                                    <i class="fas fa-check text-success"></i>
                                                    break;
                                                case "Rejected":
                                                    <i class="fas fa-times text-danger"></i>
                                                    break;
                                            }
                                            @history.Status
                                        </span>
                                        <span class="history-date">
                                            @history.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                    <div class="history-admin">
                                        <i class="fas fa-user-shield me-1"></i>
                                        @history.AdminName
                                    </div>
                                    @if (!string.IsNullOrEmpty(history.Note))
                                    {
                                        <div class="history-note">
                                            "@history.Note"
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-times-circle text-danger me-2"></i>
                    Từ chối bài viết
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Lý do từ chối <span class="text-danger">*</span></label>
                    <textarea id="rejectionReason" class="form-control" rows="4" 
                              placeholder="Nhập lý do từ chối bài viết..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmReject()">
                    <i class="fas fa-check me-1"></i>Từ chối
                </button>
            </div>
        </div>
    </div>
</div>

